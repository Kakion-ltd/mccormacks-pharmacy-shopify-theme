{
  "name": "mccormacks-pharmacy-shopify-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Shopify Online Store 2.0 theme for McCormack's Pharmacy",
  "scripts": {
    "render": "node setup/render_preview.mjs --categories --endpoints --html-out preview",
    "dev": "python3 setup/serve_preview.py",
    "build": "python3 setup/build_static_preview.py --base '' --out _site",
    "package": "bash setup/package_theme.sh",
    "store-status": "bash setup/store_status.sh",
    "test": "python3 setup/verify/generators.py && node setup/test_liquid.mjs && node check.mjs && node setup/verify/provision-guard.mjs && node setup/order-printer/check.mjs",
    "verify": "npm run render && sh setup/verify/run-all.sh",
    "render:diff": "node setup/render_preview.mjs --categories --endpoints --html-out .render-new && diff -rq preview .render-new; rm -rf .render-new"
  },
  "devDependencies": {
    "@shopify/cli": "^4.8.0",
    "@shopify/theme-check-node": "^3.28.1",
    "liquidjs": "^10.29.0"
  }
}
