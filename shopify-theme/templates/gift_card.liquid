{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gift card | {{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;600;700;800&display=swap" rel="stylesheet">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <div style="max-width:520px; margin:60px auto; padding:0 20px; text-align:center;">
    <img src="{{ 'mccormacks-logo.png' | asset_url }}" alt="{{ shop.name }}" width="185" height="59" style="width:185px; height:auto; margin:0 auto 30px; display:block;">
    <div style="border:1px solid var(--c-border); border-radius:16px; padding:36px 28px;">
      <h1 style="margin:0 0 8px; color:var(--c-dark);">Your gift card</h1>
      <p style="color:var(--c-muted); margin:0 0 22px;">Use this code at checkout to redeem your gift card.</p>
      <p style="font-size:26px; font-weight:800; letter-spacing:.1em; background:var(--c-tint); border-radius:10px; padding:16px;">{{ gift_card.code | format_code }}</p>
      <p style="font-weight:700;">Balance: {{ gift_card.balance | money }}</p>
      {% if gift_card.expired %}
        <p style="color:var(--c-error);">This gift card has expired.</p>
      {% endif %}
      <a href="{{ shop.url }}" style="display:inline-flex; align-items:center; justify-content:center; background:var(--c-primary); color:#ffffff; font-weight:800; border-radius:999px; padding:13px 30px; margin-top:10px;" class="hov-bg-green-dk">Start shopping</a>
    </div>
  </div>
</body>
</html>
