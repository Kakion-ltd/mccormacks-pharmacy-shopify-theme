<section style="max-width:1440px; margin:0 auto; padding:30px 30px 60px;">
  <div style="max-width:820px;">
  <nav aria-label="Breadcrumb" style="display:flex; gap:8px; font-size:13px; color:#717769; margin-bottom:18px;">
    <a href="{{ routes.root_url }}" class="hov-green" style="color:#717769;">Home</a><span>/</span><span style="color:#3a3d39; font-weight:700;">Loyalty Rewards Club</span>
  </nav>
  <h1 style="margin:0 0 14px; color:var(--c-dark);">{{ section.settings.heading }}</h1>
  <p style="font-size:16px; line-height:1.7; color:#5a6153; margin:0 0 26px;">{{ section.settings.intro }}</p>

  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:14px; margin-bottom:26px;">
    {% for i in (1..3) %}
      {% assign key = 'step' | append: i %}
      <div style="background:#ffffff; border:1px solid #e6e7e4; border-radius:14px; padding:20px;">
        <span style="width:30px; height:30px; border-radius:999px; background:var(--c-dark); color:var(--c-on-dark); font-weight:800; font-size:14px; display:inline-flex; align-items:center; justify-content:center; margin-bottom:10px; font-family:'Arial Rounded MT Bold', Arial, sans-serif;">{{ i }}</span>
        <p style="margin:0; font-size:14.5px; line-height:1.65; color:#3a3d39;">{{ section.settings[key] }}</p>
      </div>
    {% endfor %}
  </div>

  <div style="background:#eef2e8; border-radius:16px; padding:26px 28px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px;">
    <p style="margin:0; font-weight:700; color:var(--c-dark); max-width:420px;">{{ section.settings.cta_text }}</p>
    {% if customer %}
      <a href="/pages/store-locator" class="hov-bg-green-dk" style="display:inline-flex; align-items:center; justify-content:center; background:var(--c-primary); color:var(--c-on-primary); font-weight:800; font-size:14.5px; border-radius:999px; padding:12px 26px;">Find your store</a>
    {% else %}
      <a href="{{ routes.account_register_url }}" class="hov-bg-green-dk" style="display:inline-flex; align-items:center; justify-content:center; background:var(--c-primary); color:var(--c-on-primary); font-weight:800; font-size:14.5px; border-radius:999px; padding:12px 26px;">Create an account</a>
    {% endif %}
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Loyalty club page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loyalty Rewards Club" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Our way of saying thanks. Earn rewards on everyday essentials across all seven McCormack's stores and online." },
    { "type": "textarea", "id": "step1", "label": "Step 1", "default": "Join free in any McCormack's store or when you create an online account." },
    { "type": "textarea", "id": "step2", "label": "Step 2", "default": "Earn points every time you shop, in store or online." },
    { "type": "textarea", "id": "step3", "label": "Step 3", "default": "Turn points into money off your shop — your pharmacist will apply rewards at the till." },
    { "type": "textarea", "id": "cta_text", "label": "CTA text", "default": "Ask our team in store to set you up — it takes less than a minute." }
  ],
  "presets": [{ "name": "Loyalty club page" }]
}
{% endschema %}
