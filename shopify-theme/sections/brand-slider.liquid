<section style="max-width:1440px; margin:0 auto; padding:40px 30px 8px;">
  <div style="display:flex; align-items:baseline; justify-content:space-between; gap:16px; margin:0 0 26px;">
    <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(24px,2.6vw,32px); margin:0;">{{ section.settings.heading }}</h2>
    <a href="/pages/brands" style="font-weight:700; font-size:14.5px;">View all brands →</a>
  </div>
  <div style="position:relative;">
    <div id="brands-{{ section.id }}" style="display:flex; gap:18px; overflow-x:auto; scroll-behavior:smooth; scrollbar-width:none; padding:4px 0;">
      {%- for block in section.blocks -%}
        {%- liquid
          assign name = block.settings.name
          if block.settings.collection != blank
            assign brand_url = block.settings.collection | prepend: '/collections/'
          elsif block.settings.link != blank
            assign brand_url = block.settings.link
          else
            assign brand_url = '/pages/brands'
          endif
        -%}
        <a href="{{ brand_url }}" class="hov-border" title="{{ name | escape }}" style="flex:0 0 190px; border:1px solid #eceee9; border-radius:14px; height:110px; display:flex; align-items:center; justify-content:center; padding:22px; background:#fff;" {{ block.shopify_attributes }}>
          {%- if block.settings.logo != blank -%}
            {{ block.settings.logo | image_url: width: 350 | image_tag: widths: '175,350', alt: name, loading: 'lazy', style: 'max-width:100%; max-height:100%; object-fit:contain; display:block;' }}
          {%- elsif block.settings.logo_asset != blank -%}
            <img src="{{ block.settings.logo_asset | asset_url }}" alt="{{ name | escape }}" loading="lazy" width="350" height="240" style="max-width:100%; max-height:100%; object-fit:contain; display:block;">
          {%- else -%}
            {%- comment -%} no logo supplied — set the brand name in the house display face {%- endcomment -%}
            <span style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:19px; color:#3f6b4f; letter-spacing:-.01em; text-align:center; line-height:1.15;">{{ name }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    <button aria-label="Scroll back" data-rail-btn data-rail-back data-rail-target="brands-{{ section.id }}" data-rail-by="-420" class="hov-scroll" style="position:absolute; left:-14px; top:calc(50% - 22px); transform:translateY(-50%); width:44px; height:44px; border-radius:999px; border:1.5px solid #cfd1cc; background:#fff; color:#82c914; cursor:pointer; display:none; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(0,0,0,.1);"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"></polyline></svg></button>
    <button aria-label="Scroll forward" data-rail-btn data-rail-target="brands-{{ section.id }}" data-rail-by="420" class="hov-scroll" style="position:absolute; right:-14px; top:calc(50% - 22px); transform:translateY(-50%); width:44px; height:44px; border-radius:999px; border:1.5px solid #cfd1cc; background:#fff; color:#82c914; cursor:pointer; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(0,0,0,.1);"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg></button>
  </div>
</section>

{% style %}
.hov-border:hover { border-color: #92C83F !important; }
.hov-scroll:hover { border-color: #92C83F !important; background: #f2f8e9 !important; }
{% endstyle %}

{% schema %}
{
  "name": "Brand slider",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Brand" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "info": "Shown as text when no logo is supplied, and used as the image alt text." },
        { "type": "collection", "id": "collection", "label": "Brand collection" },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Only used when no collection is picked." },
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Transparent PNG or SVG, 380px wide or larger." },
        { "type": "text", "id": "logo_asset", "label": "Fallback theme asset (onboarding only)", "info": "Filename of a theme asset used until a logo is picked." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Brand slider",
      "blocks": [
        { "type": "brand", "settings": { "name": "L’Oréal Paris", "collection": "loreal-paris", "logo_asset": "brand-loreal.png" } },
        { "type": "brand", "settings": { "name": "La Roche-Posay", "collection": "la-roche-posay", "logo_asset": "brand-laroche.png" } },
        { "type": "brand", "settings": { "name": "CeraVe", "collection": "cerave", "logo_asset": "brand-cerave.png" } },
        { "type": "brand", "settings": { "name": "Viagra Connect", "collection": "viagra-connect", "logo_asset": "brand-viagra.png" } },
        { "type": "brand", "settings": { "name": "Pro-Ven Biotics", "collection": "proven", "logo_asset": "brand-proven.png" } },
        { "type": "brand", "settings": { "name": "Sculpted by Aimee", "collection": "sculpted-by-aimee", "logo_asset": "brand-sculpted.png" } },
        { "type": "brand", "settings": { "name": "NIVEA", "collection": "nivea" } },
        { "type": "brand", "settings": { "name": "Optibac", "collection": "optibac" } },
        { "type": "brand", "settings": { "name": "Revive Active", "collection": "revive-active" } },
        { "type": "brand", "settings": { "name": "Mitchum", "collection": "mitchum" } },
        { "type": "brand", "settings": { "name": "Piz Buin", "collection": "piz-buin" } },
        { "type": "brand", "settings": { "name": "Nurofen", "collection": "nurofen" } }
      ]
    }
  ]
}
{% endschema %}
