{% render 'trust-row' %}

{% style %}
  @media (max-width: 1040px) {
    .co-wrap { align-items: stretch !important; flex-direction: column !important; gap: 28px !important; }
    .co-side { flex: 1 1 auto !important; width: 100% !important; position: static !important; top: auto !important; }
  }
  .contact-input { height: 50px; border: 1px solid #dfe1dc; border-radius: 9px; padding: 0 14px; font-family: inherit; font-size: 15.5px; color: #2A2B2A; outline: none; }
  .contact-input:focus { border-color: #82C914; }
  .contact-textarea { border: 1px solid #dfe1dc; border-radius: 9px; padding: 12px 14px; font-family: inherit; font-size: 15.5px; line-height: 1.6; color: #2A2B2A; outline: none; resize: vertical; }
  .contact-textarea:focus { border-color: #82C914; }
{% endstyle %}

<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
  <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 16px;">
    <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><span style="color:#3a3d39; font-weight:700;">Contact Us</span>
  </nav>
  <div class="co-wrap" style="display:flex; gap:44px; align-items:flex-start;">
    <div style="flex:1 1 auto; min-width:0; max-width:760px;">
      <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(28px,3.2vw,42px); line-height:1.08; margin:0 0 12px;">{{ section.settings.heading }}</h1>
      <p style="margin:0 0 26px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ section.settings.intro }}</p>
      <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
        <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:19px; color:#3f6b4f; margin:0 0 18px;">Send us a message</div>
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <div style="display:flex; gap:12px; align-items:flex-start; background:#EEF6E4; border:1px solid #d8e9c2; border-radius:12px; padding:16px 18px; margin:0 0 18px; color:#5E8A1F; font-size:14.5px; line-height:1.65; font-weight:700;">
              Thanks — your message has been sent. Our customer care team will reply within one working day.
            </div>
          {%- endif -%}
          {%- if form.errors -%}
            <div style="display:flex; gap:12px; align-items:flex-start; background:#FBEAE9; border:1px solid #ecc8c5; border-radius:12px; padding:16px 18px; margin:0 0 18px; color:#B3261E; font-size:14.5px; line-height:1.65;">
              <div>
                <strong style="font-weight:800;">Your message could not be sent.</strong>
                {%- for field in form.errors -%}
                  <div>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
          <div style="display:flex; flex-wrap:wrap; gap:16px;">
            <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">First name</span>
              <input class="contact-input" type="text" name="contact[first_name]" placeholder="">
            </label>
            <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Last name</span>
              <input class="contact-input" type="text" name="contact[last_name]" placeholder="">
            </label>
            <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Email address</span>
              <input class="contact-input" type="email" name="contact[email]" required placeholder="you@example.com" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"{% if form.errors contains 'email' %} style="border-color:#B3261E;"{% endif %}>
              {%- if form.errors contains 'email' -%}
                <span style="font-size:13px; font-weight:700; color:#B3261E;">Email {{ form.errors.messages['email'] }}</span>
              {%- endif -%}
            </label>
            <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Phone number</span>
              <input class="contact-input" type="tel" name="contact[phone]" placeholder="Optional">
            </label>
            <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Order number</span>
              <input class="contact-input" type="text" name="contact[order_number]" placeholder="If your query is about an order">
            </label>
            <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">What is your query about?</span>
              <select class="contact-input" name="contact[query_type]" style="padding:0 12px; background:#ffffff;">
                <option>An online order</option><option>A product question</option><option>Prescriptions and dispensing</option><option>In-store services</option><option>Returns or refunds</option><option>Something else</option>
              </select>
            </label>
            <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Your message</span>
              <textarea class="contact-textarea" rows="6" name="contact[body]" required placeholder="Tell us how we can help">{{ form.body }}</textarea>
            </label>
          </div>
          <div style="display:flex; gap:12px; align-items:flex-start; background:#fdf6e9; border:1px solid #f0e2c4; border-radius:12px; padding:16px 18px; margin:18px 0;">
            <div style="font-size:13.5px; line-height:1.65; color:#5c4a24;">Please do not include detailed medical information in this form. For anything confidential, phone us and ask to speak to the pharmacist.</div>
          </div>
          <button type="submit" class="hov-bg-green-dk" style="display:inline-flex; align-items:center; justify-content:center; gap:9px; height:52px; padding:0 26px; border:none; cursor:pointer; border-radius:10px; background:#82C914; color:#ffffff; font-weight:800; font-size:15.5px; width:100%;">Send message</button>
        {%- endform -%}
      </div>
      <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,28px); margin:36px 0 16px;">Frequently asked</h2>
      <div style="border-top:1px solid #e6e7e4;">
        <div style="padding:18px 0; border-bottom:1px solid #e6e7e4;">
          <div style="font-weight:800; font-size:16px; color:#2A2B2A; margin-bottom:6px;">Where is my order?</div>
          <div style="font-size:15.5px; line-height:1.7; color:#3a3d39;">You will get a tracking link by email as soon as your parcel is dispatched. If it has not arrived within 5 working days of dispatch, contact us and we will open an enquiry with DPD.</div>
        </div>
        <div style="padding:18px 0; border-bottom:1px solid #e6e7e4;">
          <div style="font-weight:800; font-size:16px; color:#2A2B2A; margin-bottom:6px;">Can I change my delivery address?</div>
          <div style="font-size:15.5px; line-height:1.7; color:#3a3d39;">We prioritise fast dispatch, so it may not be possible to amend an order once placed. Contact us straight away and we will do what we can.</div>
        </div>
        <div style="padding:18px 0; border-bottom:1px solid #e6e7e4;">
          <div style="font-weight:800; font-size:16px; color:#2A2B2A; margin-bottom:6px;">Do you deliver outside Ireland?</div>
          <div style="font-size:15.5px; line-height:1.7; color:#3a3d39;">We ship within the Republic of Ireland. Some products cannot be shipped at all for regulatory reasons &mdash; these are flagged on the product page.</div>
        </div>
        <div style="padding:18px 0; border-bottom:1px solid #e6e7e4;">
          <div style="font-weight:800; font-size:16px; color:#2A2B2A; margin-bottom:6px;">Can I speak to a pharmacist?</div>
          <div style="font-size:15.5px; line-height:1.7; color:#3a3d39;">Yes, at any time during opening hours &mdash; by phone, email or in any of our stores. There is no charge and no appointment needed.</div>
        </div>
      </div>
    </div>
    <aside class="co-side" style="flex:0 0 330px; width:330px; position:sticky; top:20px;">
      <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
        <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:18px; color:#3f6b4f; margin:0 0 16px;">Other ways to reach us</div>
        <div style="display:flex; flex-direction:column; gap:16px;">
          <div>
            <div style="font-size:12px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#8b9182; margin-bottom:4px;">Phone</div>
            <a href="tel:0526199329" style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:19px; color:#3f6b4f;">052 6199329</a>
            <div style="font-size:13.5px; color:#6b7065; margin-top:3px;">Mon&ndash;Fri 9am&ndash;6pm, Sat 9.30am&ndash;5.30pm</div>
          </div>
          <div style="padding-top:14px; border-top:1px solid #eceee9;">
            <div style="font-size:12px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#8b9182; margin-bottom:4px;">Email</div>
            <a href="mailto:info@mccormackspharmacy.ie" class="hov-green-dk" style="font-weight:700; font-size:14.5px; word-break:break-word;">info@mccormackspharmacy.ie</a>
          </div>
          <div style="padding-top:14px; border-top:1px solid #eceee9;">
            <div style="font-size:12px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#8b9182; margin-bottom:4px;">In person</div>
            <div style="font-size:14.5px; line-height:1.7; color:#3a3d39;">Drop into any of our seven stores &mdash; <a href="/pages/store-locator" class="hov-green-dk" style="font-weight:700;">find your nearest</a>.</div>
          </div>
        </div></div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Contact Us",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Questions about an order, a product or a prescription? Our customer care team answers emails within one working day, and the phones during opening hours." }
  ],
  "presets": [{ "name": "Contact Us" }]
}
{% endschema %}
