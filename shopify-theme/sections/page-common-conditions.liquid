{% comment %}
  Common Conditions Service. Rebuilt from the previous developer's page
  (archive/policies-preview/mc-common-conditions.liquid) without its booking form:
  that form emailed a named person's date of birth, condition and symptoms to the
  shared contact inbox, with no record and no retention. Booking is by phone, and
  each store block carries its own number.

  The store blocks copy name, address and phone from templates/page.store-locator.json.
  check.mjs (StoreDrift) fails if they stop matching, so edit both together.
  All copy here is clinical or pricing copy approved by the client: change it only
  with their sign-off.
{% endcomment %}

{% style %}
  .ccs-faq-content[data-open="false"] { display: none; }
  .ccs-card { border: 1px solid #e6e7e4; border-radius: 16px; background: #ffffff; padding: 22px 22px 24px; }
{% endstyle %}

{%- assign h_font = "font-family:var(--font-heading); font-weight:800; color:var(--c-dark);" -%}

<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
  <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#666b60; margin:0 0 16px;">
    <a href="{{ routes.root_url }}" class="hov-green" style="color:#666b60;">Home</a><span>/</span><span style="color:#3a3d39; font-weight:700;">{{ section.settings.eyebrow }}</span>
  </nav>

  <div style="display:flex; flex-wrap:wrap; gap:28px 48px; align-items:center; background:#f4f5f2; border-radius:18px; padding:clamp(24px,4vw,52px);">
    <div style="flex:1 1 420px; min-width:0;">
      <span style="display:inline-flex; align-items:center; height:27px; padding:0 12px; border-radius:6px; background:#eef2e8; color:var(--c-primary-text); font-size:12px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; margin:0 0 14px;">{{ section.settings.eyebrow }}</span>
      <h1 style="{{ h_font }} font-size:clamp(28px,3.2vw,42px); line-height:1.08; margin:0 0 14px;">{{ section.settings.heading }}</h1>
      <p style="margin:0 0 24px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ section.settings.intro }}</p>
      <div style="display:flex; flex-wrap:wrap; gap:12px;">
        <a href="#ccs-stores" class="btn btn-fill">Call to book</a>
        <a href="#ccs-conditions" class="btn btn-outline">Conditions we treat</a>
      </div>
    </div>
    <div style="flex:1 1 340px; min-width:0; display:grid; gap:12px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'fact' -%}
          <div class="ccs-card" style="padding:16px 20px;" {{ block.shopify_attributes }}>
            <div style="{{ h_font }} font-size:16.5px; margin:0 0 4px;">{{ block.settings.title }}</div>
            <div style="font-size:14.5px; line-height:1.55; color:#5d6159;">{{ block.settings.text }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<section style="max-width:1440px; margin:0 auto; padding:40px 30px 10px;">
  <h2 style="{{ h_font }} font-size:clamp(24px,2.6vw,34px); margin:0 0 22px;">How it works</h2>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:18px;">
    {%- assign step = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'step' -%}
        {%- assign step = step | plus: 1 -%}
        <div class="ccs-card" {{ block.shopify_attributes }}>
          <div style="display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:10px; background:#eef2e8; color:var(--c-primary-text); {{ h_font }} font-size:19px; margin:0 0 14px;">{{ step }}</div>
          <h3 style="{{ h_font }} font-size:19px; line-height:1.25; margin:0 0 8px;">{{ block.settings.title }}</h3>
          <p style="margin:0; font-size:15px; line-height:1.65; color:#5d6159;">{{ block.settings.text }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section id="ccs-conditions" style="max-width:1440px; margin:0 auto; padding:40px 30px 10px; scroll-margin-top:120px;">
  <h2 style="{{ h_font }} font-size:clamp(24px,2.6vw,34px); margin:0 0 10px;">Conditions we can treat</h2>
  <p style="margin:0 0 22px; font-size:16px; line-height:1.65; color:#4a4d47; max-width:70ch;">{{ section.settings.conditions_intro }}</p>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:14px;">
    {%- for block in section.blocks -%}
      {%- if block.type == 'condition' -%}
        <div class="ccs-card" style="padding:18px 20px;" {{ block.shopify_attributes }}>
          <div style="{{ h_font }} font-size:17px; margin:0 0 5px;">{{ block.settings.name }}</div>
          <div style="font-size:14px; line-height:1.5; color:#5d6159;">{{ block.settings.detail }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section id="ccs-stores" style="max-width:1440px; margin:0 auto; padding:40px 30px 10px; scroll-margin-top:120px;">
  <h2 style="{{ h_font }} font-size:clamp(24px,2.6vw,34px); margin:0 0 10px;">Call your pharmacy to book</h2>
  <p style="margin:0 0 22px; font-size:16px; line-height:1.65; color:#4a4d47; max-width:70ch;">{{ section.settings.stores_intro }}</p>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px;">
    {%- for block in section.blocks -%}
      {%- if block.type == 'store' -%}
        <div class="ccs-card" style="display:flex; flex-direction:column; gap:8px;" {{ block.shopify_attributes }}>
          <div style="{{ h_font }} font-size:18.5px;">{{ block.settings.name }}</div>
          <div style="font-size:14.5px; line-height:1.55; color:#5d6159; flex:1;">{{ block.settings.address }}</div>
          <a href="tel:{{ block.settings.phone | remove: ' ' }}" class="btn btn-fill" style="margin-top:8px;">Call to book: {{ block.settings.phone }}</a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section style="max-width:1440px; margin:0 auto; padding:40px 30px 70px;">
  <h2 style="{{ h_font }} font-size:clamp(24px,2.6vw,34px); margin:0 0 10px;">Frequently asked questions</h2>
  <div style="display:flex; flex-direction:column; max-width:1000px;">
    {%- assign faq_n = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' -%}
        {%- assign faq_n = faq_n | plus: 1 -%}
        {%- assign faq_id = 'ccs-faq-' | append: section.id | append: '-' | append: faq_n -%}
        <div style="border-bottom:1px solid #eceee9; padding:22px 0;" {{ block.shopify_attributes }}>
          <button data-acc-toggle="{{ faq_id }}" aria-expanded="false" aria-controls="{{ faq_id }}" style="display:flex; align-items:center; justify-content:space-between; gap:14px; width:100%; background:transparent; border:none; padding:0; cursor:pointer; text-align:left;">
            <h3 style="font-family:var(--font-heading); font-weight:700; color:#2A2B2A; font-size:clamp(18px,1.8vw,22px); margin:0;">{{ block.settings.question }}</h3>
            <svg data-acc-chevron width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--c-primary)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:0 0 auto; transition:transform .2s ease;"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="ccs-faq-content" id="{{ faq_id }}" data-acc-content="{{ faq_id }}" data-open="false">
            <div style="margin:10px 0 0; font-size:15.5px; line-height:1.65; color:#5a6153;">
              {{ block.settings.answer }}
              {%- comment -%} The branch list renders from the store blocks, so it cannot drift from the cards above. {%- endcomment -%}
              {%- if block.settings.list_stores -%}
                <ul style="margin:8px 0 0; padding-left:22px;">
                  {%- for s in section.blocks -%}{%- if s.type == 'store' -%}<li>{{ s.settings.name }}</li>{%- endif -%}{%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Common Conditions",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Common Conditions Service" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fast, expert care for everyday conditions" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "textarea", "id": "conditions_intro", "label": "Conditions intro" },
    { "type": "textarea", "id": "stores_intro", "label": "Stores intro" }
  ],
  "blocks": [
    { "type": "fact", "name": "Key fact", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] },
    { "type": "step", "name": "How it works step", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] },
    { "type": "condition", "name": "Condition", "settings": [
      { "type": "text", "id": "name", "label": "Condition" },
      { "type": "text", "id": "detail", "label": "Who it covers" }
    ] },
    { "type": "store", "name": "Store", "settings": [
      { "type": "text", "id": "name", "label": "Name", "info": "Must match the store locator exactly. npm test fails if it does not." },
      { "type": "text", "id": "address", "label": "Address" },
      { "type": "text", "id": "phone", "label": "Phone" }
    ] },
    { "type": "faq", "name": "FAQ", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" },
      { "type": "checkbox", "id": "list_stores", "label": "List the stores under the answer", "default": false }
    ] }
  ]
}
{% endschema %}
