{%- comment -%} Homepage sections carry only 8px of bottom padding because the
    next section's 40px top provides the gap. This is the last section before
    the footer, so it needs its own. {%- endcomment -%}
<section style="max-width:1440px; margin:0 auto; padding:40px 30px clamp(48px,5vw,72px);">
  <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(22px,2.2vw,28px); margin:0 0 22px;">{{ section.settings.heading }}</h2>
  <div class="svc-slider" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:22px;">
    <div><div style="aspect-ratio:1; border-radius:14px; overflow:hidden; margin-bottom:14px;"><img src="{{ 'contact-us.png' | asset_url }}" alt="Contact Us" style="width:100%; height:100%; object-fit:cover; display:block;" width="299" height="299"></div><h3 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; color:#3f6b4f; font-weight:700; font-size:18px; margin:0 0 8px;">Contact Us</h3><a href="/pages/contact-us" style="font-weight:700;">Find Out More →</a></div>
    <div><div style="aspect-ratio:1; border-radius:14px; overflow:hidden; margin-bottom:14px;"><img src="{{ 'our-stores.jpg' | asset_url }}" alt="McCormack's Pharmacy storefront" style="width:100%; height:100%; object-fit:cover; display:block;" width="1254" height="1254"></div><h3 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; color:#3f6b4f; font-weight:700; font-size:18px; margin:0 0 8px;">Our Stores</h3><a href="/pages/store-locator" style="font-weight:700;">Find Out More →</a></div>
    <div><div style="aspect-ratio:1; border-radius:14px; overflow:hidden; margin-bottom:14px;"><img src="{{ 'common-conditions.jpg' | asset_url }}" alt="Pharmacist advising a customer" style="width:100%; height:100%; object-fit:cover; display:block;" width="299" height="299"></div><h3 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; color:#3f6b4f; font-weight:700; font-size:18px; margin:0 0 8px;">Common Conditions</h3><a href="/collections/medicines-health" style="font-weight:700;">Find Out More →</a></div>
    <div><div style="aspect-ratio:1; border-radius:14px; overflow:hidden; margin-bottom:14px;"><img src="{{ 'instore-services.png' | asset_url }}" alt="In-store pharmacy services" style="width:100%; height:100%; object-fit:cover; display:block;" width="299" height="299"></div><h3 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; color:#3f6b4f; font-weight:700; font-size:18px; margin:0 0 8px;">In-Store Services</h3><a href="/pages/in-store-services" style="font-weight:700;">Find Out More →</a></div>
  </div>
</section>

{% schema %}
{
  "name": "Other services",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Other Services" }
  ],
  "presets": [{ "name": "Other services" }]
}
{% endschema %}
