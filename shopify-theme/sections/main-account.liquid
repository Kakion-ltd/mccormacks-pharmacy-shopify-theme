{% render 'trust-row' %}
<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">

  <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#717769; margin:0 0 16px;">
    <a href="{{ routes.root_url }}" class="hov-green" style="color:#717769;">Home</a><span>/</span><span style="color:#3a3d39; font-weight:700;">My account</span>
  </nav>
  <div class="acct-wrap" style="display:flex; gap:40px; align-items:flex-start;">

    {% render 'account-sidebar', active: 'dash' %}

    <div style="flex:1 1 auto; min-width:0;">

      <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(20px,2.1vw,26px); margin:0 0 16px;">Hello {{ customer.first_name }}</h2>

      {% liquid
        assign open_orders = 0
        for order in customer.orders
          unless order.cancelled or order.fulfillment_status == 'fulfilled'
            assign open_orders = open_orders | plus: 1
          endunless
        endfor
        assign oldest_order = customer.orders | last
      %}
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px; margin:0 0 30px;">
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:20px 22px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:28px; color:var(--c-dark); line-height:1;">{{ open_orders }}</div>
          <div style="font-size:14.5px; font-weight:700; color:#2A2B2A; margin:8px 0 3px;">Open orders</div>
          <div style="font-size:13px; color:#6b7065;">{% if open_orders > 0 %}Being prepared or on the way{% else %}Nothing in progress{% endif %}</div>
        </div>
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:20px 22px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:28px; color:var(--c-dark); line-height:1;">{{ customer.orders_count }}</div>
          <div style="font-size:14.5px; font-weight:700; color:#2A2B2A; margin:8px 0 3px;">Orders placed</div>
          <div style="font-size:13px; color:#6b7065;">{% if oldest_order %}Since {{ oldest_order.created_at | date: '%B %Y' }}{% else %}No orders yet{% endif %}</div>
        </div>
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:20px 22px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:28px; color:var(--c-dark); line-height:1;">{{ customer.addresses_count }}</div>
          <div style="font-size:14.5px; font-weight:700; color:#2A2B2A; margin:8px 0 3px;">Saved address{% if customer.addresses_count != 1 %}es{% endif %}</div>
          <div style="font-size:13px; color:#6b7065;">Manage in Details &amp; addresses</div>
        </div>
      </div>

      <div id="orders" style="margin:0 0 30px;">
        <div style="display:flex; align-items:baseline; justify-content:space-between; gap:16px; margin:0 0 6px;">
          <h3 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:19px; color:var(--c-dark); margin:0;">Recent orders</h3>
        </div>
        {% paginate customer.orders by 20 %}
          <div style="border-top:1px solid #e6e7e4;">
            {% for order in customer.orders %}
              {% liquid
                if order.cancelled
                  assign badge_bg = '#f7eeee'
                  assign badge_fg = '#a35151'
                  assign badge_label = 'Cancelled'
                elsif order.fulfillment_status == 'fulfilled'
                  assign badge_bg = '#f2f3f1'
                  assign badge_fg = '#5d6159'
                  assign badge_label = order.fulfillment_status_label
                else
                  assign badge_bg = '#eef2e8'
                  assign badge_fg = '#3f6a17'
                  assign badge_label = order.fulfillment_status_label
                endif
              %}
              <div class="ord-row" style="display:flex; flex-wrap:wrap; align-items:center; gap:14px 24px; padding:18px 0; border-bottom:1px solid #e6e7e4;">
                <div style="flex:0 0 130px;">
                  <div style="font-size:12px; font-weight:800; letter-spacing:.05em; text-transform:uppercase; color:#717769; margin-bottom:4px;">Order</div>
                  <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:16px; color:var(--c-dark);">{{ order.name }}</div>
                </div>
                <div style="flex:0 0 120px; font-size:14.5px; color:#3a3d39;">{{ order.created_at | date: '%-d %b %Y' }}</div>
                <div style="flex:0 0 auto;"><span style="display:inline-flex; align-items:center; height:27px; padding:0 11px; border-radius:6px; background:{{ badge_bg }}; color:{{ badge_fg }}; font-size:12.5px; font-weight:800;">{{ badge_label }}</span></div>
                <div style="flex:0 0 auto;"><span style="display:inline-flex; align-items:center; height:27px; padding:0 11px; border-radius:6px; background:#f2f3f1; color:#5d6159; font-size:12.5px; font-weight:800;">{{ order.financial_status_label }}</span></div>
                <div style="flex:1 1 auto; text-align:right; font-weight:800; font-size:16px; color:#2A2B2A;">{{ order.total_price | money }}</div>
                <div style="flex:0 0 auto; display:flex; gap:14px;">
                  <a href="{{ order.customer_url }}" style="font-size:13.5px; font-weight:700; color:var(--c-primary-text);">View</a>
                </div>
              </div>
            {% else %}
              <div style="padding:24px 0; border-bottom:1px solid #e6e7e4; font-size:14.5px; color:#6b7065;">You haven't placed any orders yet. <a href="{{ routes.root_url }}" style="font-weight:700;">Start shopping</a></div>
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            <div style="display:flex; gap:14px; padding:16px 0 0; font-size:14px; font-weight:700;">
              {% if paginate.previous %}<a href="{{ paginate.previous.url }}">&larr; Newer</a>{% endif %}
              {% if paginate.next %}<a href="{{ paginate.next.url }}">Older &rarr;</a>{% endif %}
            </div>
          {% endif %}
        {% endpaginate %}
      </div>

      {% if customer.default_address %}
        <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff; margin:0 0 22px;">
          <div style="display:flex; flex-wrap:wrap; align-items:center; gap:18px 26px;">
            <div style="flex:1 1 300px;">
              <div style="font-size:12px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#717769; margin-bottom:8px;">Default delivery address</div>
              <div class="acct-addr" style="font-size:14.5px; line-height:1.7; color:#3a3d39;">{{ customer.default_address | format_address }}</div>
            </div>
            <a href="{{ routes.account_addresses_url }}" class="hov-border-only" style="flex:0 0 auto; display:inline-flex; align-items:center; height:48px; padding:0 22px; border-radius:9px; border:1.5px solid #cdd3c5; color:var(--c-dark); font-weight:700; font-size:14.5px;">Manage addresses</a>
          </div>
        </div>
      {% endif %}

      <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:18px 26px;">
          <div style="flex:1 1 300px;">
            <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:19px; color:var(--c-dark); margin-bottom:5px;">Need a repeat prescription?</div>
            <div style="font-size:14.5px; line-height:1.65; color:#3a3d39;">Submit a request and our dispensary team will confirm when it is ready to collect or dispatch.</div>
          </div>
          <a href="/pages/prescriptions" class="hov-bg-green-dk" style="flex:0 0 auto; display:inline-flex; align-items:center; height:48px; padding:0 22px; border-radius:9px; background:var(--c-primary); color:var(--c-on-primary); font-weight:800; font-size:14.5px;">Manage prescriptions</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
  .acct-addr p { margin: 0; }
  .hov-border-only:hover { border-color: var(--c-accent) !important; }
  @media (max-width: 1000px) {
    .acct-wrap { align-items: stretch !important; flex-direction: column !important; gap: 26px !important; }
    .acct-side { flex: 1 1 auto !important; width: 100% !important; }
  }
  @media (max-width: 700px) {
    .ord-row { gap: 10px 16px !important; }
    .ord-row > div { flex: 1 1 auto !important; text-align: left !important; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Customer account",
  "presets": [{ "name": "Customer account" }]
}
{% endschema %}
