{% render 'trust-row' %}

<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
  <div class="legal-wrap" style="display:flex; gap:56px; align-items:flex-start;">

    {% render 'legal-sidebar', active: 'isp', updated_date: section.settings.updated_date, show_help: section.settings.show_help_card, phone: section.settings.help_phone %}

    <div style="flex:1; min-width:0; max-width:820px;">
      <div>
      <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 14px;">
        <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><span>Policies</span><span>/</span><span style="color:#3a3d39; font-weight:700;">Registered Internet Supply Pharmacy</span>
      </nav>
      <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(30px,3.4vw,42px); line-height:1.08; margin:0 0 14px;">{{ section.settings.heading }}</h1>
      <p style="margin:0 0 28px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ section.settings.intro }}</p>
      <div style="height:1px; background:#e6e7e4;"></div>
      <div style="display:flex; gap:14px; background:#eef2e8; border-radius:14px; padding:18px 20px; margin:0 0 24px; margin-top:26px; align-items:center;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="#82C914" style="flex:0 0 auto;"><path d="M12 2 4 5v6.5c0 4.6 3.3 8.8 8 10.5 4.7-1.7 8-5.9 8-10.5V5l-8-3Zm3.7 7.3-4.6 4.6a1 1 0 0 1-1.4 0L7.3 11.5l1.4-1.4 1.7 1.7 3.9-3.9 1.4 1.4Z"></path></svg>
        <div>
          <div style="font-weight:800; font-size:16.5px; color:#3f6b4f; margin-bottom:4px;">Check the PSI Internet Supply list</div>
          <div style="font-size:14.5px; line-height:1.65; color:#3a3d39;">You can check the full PSI Internet Supply list at <a href="https://www.thepsi.ie/gns/Internet-Supply/internet_supply_list_the_list.aspx" style="word-break:break-word;">thepsi.ie</a>, or by clicking the PSI logo in our footer.</div>
        </div>
      </div><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Record of transactions</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">As part of the regulation to maintain our inclusion on this list, please be aware that <strong>a record of each transaction will be retained for 2 years</strong>.</p><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Contact details for the PSI</h2>
      <div style="margin:0 0 24px;">
          <div style="display:flex; flex-wrap:wrap; gap:6px 18px; padding:13px 0; border-bottom:1px solid #eceee9;">
            <span style="flex:0 0 210px; font-weight:800; font-size:14.5px; color:#2A2B2A;">Address</span>
            <span style="flex:1 1 240px; font-size:15px; line-height:1.6; color:#3a3d39;">PSI House, Fenian Street, Dublin 2, D02 TD72</span>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:6px 18px; padding:13px 0; border-bottom:1px solid #eceee9;">
            <span style="flex:0 0 210px; font-weight:800; font-size:14.5px; color:#2A2B2A;">Phone</span>
            <span style="flex:1 1 240px; font-size:15px; line-height:1.6; color:#3a3d39;"><a href="tel:+35312184000">01 218 4000</a></span>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:6px 18px; padding:13px 0; border-bottom:1px solid #eceee9;">
            <span style="flex:0 0 210px; font-weight:800; font-size:14.5px; color:#2A2B2A;">Email</span>
            <span style="flex:1 1 240px; font-size:15px; line-height:1.6; color:#3a3d39;"><a href="mailto:internetsupply@psi.ie">internetsupply@psi.ie</a></span>
          </div>
      </div><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Speak to our pharmacy team</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">If you have a question about a medicine or an order, contact us on <a href="tel:0526199329">052 6199329</a> during working hours and one of our trained staff will help you.</p>
      </div>

      {% render 'legal-question-card' %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Internet Supply page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Registered Internet Supply Pharmacy" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "McCormack’s Pharmacy is on the Registered Internet Supply Pharmacy list from the Pharmaceutical Society of Ireland (PSI)." },
    { "type": "text", "id": "updated_date", "label": "Last reviewed date", "default": "12 June 2026" },
    { "type": "checkbox", "id": "show_help_card", "label": "Show pharmacist help card", "default": true },
    { "type": "text", "id": "help_phone", "label": "Help phone number", "default": "052 6199329" }
  ],
  "presets": [{ "name": "Internet Supply page" }]
}
{% endschema %}
