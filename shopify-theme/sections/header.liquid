{%- comment -%} .hdr-sticky is the whole header: the logo/search/icons row, the search
    row, and the department nav bar. It is one sticky unit at every breakpoint and its
    height never changes - nothing compresses - so the flow below it never moves and no
    compensating margin is needed. theme.js translates the whole bar out of view on scroll
    down and brings it back on the first scroll up, departments included, so a shopper
    mid-collection can change department without returning to the top of the page.
    Phones keep the search row for the same reason: a bar that costs nothing while
    scrolling down has no reason to drop its most-used control.
    Rules: z-index above page content, no overflow, or the search suggestions cannot
    escape it. Nothing position:fixed may live in here - the transform makes this element
    the containing block - which is why the mobile nav drawer sits outside it below.
{%- endcomment -%}
<div class="hdr-sticky">
<header style="width:100%; background:#ffffff;">
  <div class="hdr-row" style="max-width:1440px; margin:0 auto; padding:16px 30px; display:flex; flex-wrap:wrap; align-items:center; gap:12px 30px;">
    <div class="hdr-mobile-left" style="display:none; align-items:center; gap:16px; order:1;">
      <button aria-label="Menu" aria-expanded="false" aria-controls="mnav-drawer" data-mnav-open-btn style="border:none; background:transparent; padding:10px; margin:-10px; color:#2A2B2A; cursor:pointer; display:flex;">
        <svg class="mnav-ico-open" width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <svg class="mnav-ico-close" width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg>
      </button>
      <a href="{{ routes.account_url }}" aria-label="My Account" class="hov-green" style="color:#2A2B2A; display:flex; padding:10px; margin:-10px;"><svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg></a>
    </div>
    <a href="{{ routes.root_url }}" class="hdr-logo" style="display:block; flex:0 0 auto;">
      {% # theme-check-disable RemoteAsset -%}
      <img src="{% render 'logo-src', width: 370 %}" alt="{{ shop.name }}" width="185" height="59" style="width:185px; max-width:100%; height:auto; display:block;">
      {%- # theme-check-enable RemoteAsset %}
    </a>
    <nav class="hdr-icons" style="flex:0 0 auto; display:flex; align-items:center; gap:26px; color:#2A2B2A;">
      <a href="/pages/wishlist" class="hide-mobile hov-green" style="color:#2A2B2A; display:flex; align-items:center; gap:7px; font-weight:600; font-size:13.5px; position:relative;">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21.5l8.8-8.8a5 5 0 0 0 0-7.1z"></path></svg>
        <span class="icon-label">Wishlist</span>
        <span data-wish-count style="position:absolute; top:-7px; left:13px; min-width:17px; height:17px; border-radius:999px; background:var(--c-primary); color:var(--c-on-primary); font-size:11px; font-weight:800; display:none; align-items:center; justify-content:center; padding:0 4px;">0</span>
      </a>
      <a href="{{ routes.cart_url }}" class="hide-mobile hov-green" style="color:#2A2B2A; display:flex; align-items:center; gap:7px; font-weight:600; font-size:13.5px; position:relative;">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"></circle><circle cx="18" cy="20" r="1.4"></circle><path d="M2 3h3l2.4 12.3a1.6 1.6 0 0 0 1.6 1.3h8.6a1.6 1.6 0 0 0 1.6-1.3L22 7H6"></path></svg>
        <span class="icon-label">My Cart</span>
        <span data-cart-count style="position:absolute; top:-7px; left:13px; min-width:17px; height:17px; border-radius:999px; background:var(--c-primary); color:var(--c-on-primary); font-size:11px; font-weight:800; display:{% if cart.item_count > 0 %}flex{% else %}none{% endif %}; align-items:center; justify-content:center; padding:0 4px;">{{ cart.item_count }}</span>
      </a>
      <a href="{{ routes.account_url }}" class="hide-mobile hov-green" aria-label="My Account" style="color:#2A2B2A; display:flex; align-items:center; position:relative;">
        <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="cart-mobile hov-green" aria-label="My Cart" style="color:#2A2B2A; display:none; align-items:center; position:relative;">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"></circle><circle cx="18" cy="20" r="1.4"></circle><path d="M2 3h3l2.4 12.3a1.6 1.6 0 0 0 1.6 1.3h8.6a1.6 1.6 0 0 0 1.6-1.3L22 7H6"></path></svg>
        <span data-cart-count style="position:absolute; top:-6px; right:-8px; min-width:17px; height:17px; border-radius:999px; background:var(--c-primary); color:var(--c-on-primary); font-size:11px; font-weight:800; display:{% if cart.item_count > 0 %}flex{% else %}none{% endif %}; align-items:center; justify-content:center; padding:0 4px;">{{ cart.item_count }}</span>
      </a>
    </nav>
  </div>
  {%- comment -%} Its own row, not a flex item of .hdr-row: on desktop base.css lays the
      header out as a grid so the search still sits between the logo and the icons, and on
      phones this row scrolls away while .hdr-row stays stuck. The wrapper is the positioned
      parent for the suggestions panel, not the overflow:hidden form. {%- endcomment -%}
  <div class="hdr-search-row">
    <div class="hdr-search" style="flex:0 1 550px; min-width:200px; order:0; margin:0 auto; position:relative;">
      <form class="hdr-search-form" action="{{ routes.search_url }}" method="get" role="search" style="display:flex; align-items:stretch; background:#f4f5f2; border:1.5px solid transparent; border-radius:12px; overflow:hidden; padding:0 0 0 16px; transition:border-color .18s, box-shadow .18s, background .18s;">
      <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Search for products, brands and more…"
             data-ps-input autocomplete="off" role="combobox" aria-expanded="false"
             aria-controls="predictive-search-results" aria-autocomplete="list"
             aria-label="Search for products, brands and more"
             style="flex:1; border:none; outline:none; font-family:inherit; font-size:14.5px; color:#2A2B2A; background:transparent; padding:9px 0;">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" aria-label="Search" class="hov-bg-green" style="flex:0 0 auto; width:46px; border:none; border-radius:9px 0 0 9px; background:var(--c-accent); color:var(--c-on-accent); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:background .15s;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg></button>
      </form>
      <div class="ps-panel" id="predictive-search-results" data-ps-panel role="listbox"
           aria-label="Search suggestions" tabindex="-1" hidden></div>
      <span class="visually-hidden" data-ps-status role="status" aria-live="polite"></span>
    </div>
  </div>
</header>

{% # Main navigation with mega-menus %}
<div class="main-nav-bar" style="width:100%; background:#f2f3f1; border-top:1px solid #e6e7e4; border-bottom:1px solid #e6e7e4;">
  <div data-mega-root style="max-width:1440px; margin:0 auto; padding:5px 30px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:10px 30px; position:relative;">
    <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:8px 18px; font-weight:600; font-size:14px;">
      {%- comment -%} The eight departments come from snippets/departments.liquid,
          generated from taxonomy.json in nav order - the same list the homepage
          pill row and the mobile drawer use, so the three cannot disagree. {%- endcomment -%}
      {%- capture depts -%}{%- render 'departments' -%}{%- endcapture -%}
      {%- assign depts = depts | strip | split: '|' -%}
      {%- for dept in depts -%}
      {%- assign d = dept | split: '~' %}
      <a href="/collections/{{ d[1] }}" class="hov-green" data-mega-trigger="{{ d[1] }}" style="color:#2A2B2A; font-size:13.5px;">{{ d[0] | escape }}</a>
      {%- endfor %}
      {%- comment -%} Merchant promo links (max 4); see archive/docs/SPEC-header-promo-links.md {%- endcomment -%}
      {%- for block in section.blocks -%}
      {%- if block.type == 'promo_link' and block.settings.label != blank %}
      <a href="{{ block.settings.link }}" class="{% if block.settings.highlight %}hov-dark-green{% else %}hov-green{% endif %}" data-mega-close style="{% if block.settings.highlight %}color:var(--c-primary-text); font-weight:700; {% else %}color:#2A2B2A; {% endif %}font-size:13.5px;" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endif -%}
      {%- endfor %}
    </nav>
    <div style="display:flex; align-items:center; gap:9px;">
      <a href="/pages/in-store-services" class="chip chip-active" style="gap:9px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l9-6 9 6v12"></path><path d="M3 21h18"></path><path d="M9 21v-6h6v6"></path></svg>
        <span>In-Store Services</span>
      </a>
      <a href="/pages/store-locator" class="chip chip-lime" style="gap:9px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.8-7-10a7 7 0 0 1 14 0c0 5.2-7 10-7 10z"></path><circle cx="12" cy="11" r="2.4"></circle></svg>
        <span>Store Locator</span>
      </a>
    </div>
    {% render 'mega-menu' %}
  </div>
</div>
</div>

{%- comment -%} Mobile nav: a disclosure, not a modal. It hangs from the bottom of the
    header at rest (theme.js scrolls to the top on open and sets --mnav-top), full width to
    the foot of the viewport, so the logo, the search and the cart stay visible and usable
    above it. The hamburger becomes an X in place and closes it; main and footer are inert
    while it is open. No overlay: the drawer covers everything below the header. {%- endcomment -%}
<aside id="mnav-drawer" class="mnav-drawer" aria-label="Menu">
  {%- comment -%} Drill-down panels generated from taxonomy.json by
      setup/gen_category_nav.py, so the mobile nav, the desktop mega menu and the
      breadcrumbs all describe the same tree. Services is reached from the button
      at the foot of this drawer, mirroring the desktop nav. {%- endcomment -%}
  {% render 'mobile-nav', promo_blocks: section.blocks %}
  <div style="padding:18px 20px; margin-top:auto; display:flex; flex-direction:column; gap:12px;">
    <div style="display:flex; gap:12px;">
      <a href="/pages/in-store-services" class="btn btn-fill" style="flex:1; gap:8px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l9-6 9 6v12"></path><path d="M3 21h18"></path><path d="M9 21v-6h6v6"></path></svg>
        Services
      </a>
      <a href="/pages/store-locator" class="btn btn-lime" style="flex:1; gap:8px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.8-7-10a7 7 0 0 1 14 0c0 5.2-7 10-7 10z"></path><circle cx="12" cy="11" r="2.5"></circle></svg>
        Store Locator
      </a>
    </div>
    <div style="display:flex; gap:12px;">
      <a href="{{ routes.account_url }}" class="btn btn-outline" style="flex:1; gap:8px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>Account
      </a>
      <a href="/pages/wishlist" class="btn btn-outline" style="flex:1; gap:8px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21.5l8.8-8.8a5 5 0 0 0 0-7.1z"></path></svg>Wishlist
        {%- comment -%} The mobile header carries no wishlist icon by design, so this
            is where a phone shopper sees their count. {%- endcomment -%}
        <span data-wish-count style="min-width:19px; height:19px; border-radius:999px; background:var(--c-primary); color:var(--c-on-primary); font-size:11.5px; font-weight:800; display:none; align-items:center; justify-content:center; padding:0 5px;">0</span>
      </a>
    </div>
  </div>
</aside>

{%- comment -%} Cart drawer lives in the header so it is present on every page,
    which is what lets add-to-cart from a collection or the PDP open it. {%- endcomment -%}
{% render 'cart-drawer' %}

{% schema %}
{
  "name": "Header",
  "settings": [],
  "blocks": [
    {
      "type": "promo_link",
      "name": "Promo link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight",
          "default": false,
          "info": "Renders in the Sale link's accent style."
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
