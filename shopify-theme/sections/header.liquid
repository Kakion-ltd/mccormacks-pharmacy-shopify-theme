<header style="width:100%; background:#ffffff;">
  <div class="hdr-row" style="max-width:1440px; margin:0 auto; padding:16px 30px; display:flex; flex-wrap:wrap; align-items:center; gap:12px 30px;">
    <div class="hdr-mobile-left" style="display:none; align-items:center; gap:16px; order:1;">
      <button aria-label="Menu" data-mnav-open-btn style="border:none; background:transparent; padding:0; color:#2A2B2A; cursor:pointer; display:flex;"><svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg></button>
      <a href="{{ routes.account_url }}" aria-label="My Account" class="hov-green" style="color:#2A2B2A; display:flex;"><svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg></a>
    </div>
    <a href="{{ routes.root_url }}" class="hdr-logo" style="display:block; flex:0 0 auto;">
      <img src="{{ 'mccormacks-logo.png' | asset_url }}" alt="{{ shop.name }}" width="185" height="59" style="width:185px; max-width:100%; height:auto; display:block;">
    </a>
    <form class="hdr-search" action="{{ routes.search_url }}" method="get" style="flex:0 1 550px; min-width:200px; order:0; margin:0 auto; display:flex; align-items:stretch; background:#f4f5f2; border:1.5px solid transparent; border-radius:12px; overflow:hidden; padding:0 0 0 16px; transition:border-color .18s, box-shadow .18s, background .18s;">
      <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Search for products, brands and more…" style="flex:1; border:none; outline:none; font-family:inherit; font-size:14.5px; color:#2A2B2A; background:transparent; padding:9px 0;">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" aria-label="Search" class="hov-bg-green" style="flex:0 0 auto; width:46px; border:none; border-radius:9px 0 0 9px; background:#92C83F; color:#ffffff; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:background .15s;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg></button>
    </form>
    <nav class="hdr-icons" style="flex:0 0 auto; display:flex; align-items:center; gap:26px; color:#2A2B2A;">
      <a href="/pages/wishlist" class="hide-mobile hov-green" style="color:#2A2B2A; display:flex; align-items:center; gap:7px; font-weight:600; font-size:13.5px;">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21.5l8.8-8.8a5 5 0 0 0 0-7.1z"></path></svg>
        <span class="icon-label">Wishlist</span>
      </a>
      <a href="{{ routes.cart_url }}" class="hide-mobile hov-green" style="color:#2A2B2A; display:flex; align-items:center; gap:7px; font-weight:600; font-size:13.5px; position:relative;">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"></circle><circle cx="18" cy="20" r="1.4"></circle><path d="M2 3h3l2.4 12.3a1.6 1.6 0 0 0 1.6 1.3h8.6a1.6 1.6 0 0 0 1.6-1.3L22 7H6"></path></svg>
        <span class="icon-label">My Cart</span>
        <span data-cart-count style="position:absolute; top:-7px; left:13px; min-width:17px; height:17px; border-radius:999px; background:#82C914; color:#ffffff; font-size:11px; font-weight:800; display:{% if cart.item_count > 0 %}flex{% else %}none{% endif %}; align-items:center; justify-content:center; padding:0 4px;">{{ cart.item_count }}</span>
      </a>
      <a href="{{ routes.account_url }}" class="hide-mobile hov-green" aria-label="My Account" style="color:#2A2B2A; display:flex; align-items:center; position:relative;">
        <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="cart-mobile hov-green" aria-label="My Cart" style="color:#2A2B2A; display:none; align-items:center; position:relative;">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"></circle><circle cx="18" cy="20" r="1.4"></circle><path d="M2 3h3l2.4 12.3a1.6 1.6 0 0 0 1.6 1.3h8.6a1.6 1.6 0 0 0 1.6-1.3L22 7H6"></path></svg>
        <span data-cart-count style="position:absolute; top:-6px; right:-8px; min-width:17px; height:17px; border-radius:999px; background:#82C914; color:#ffffff; font-size:11px; font-weight:800; display:{% if cart.item_count > 0 %}flex{% else %}none{% endif %}; align-items:center; justify-content:center; padding:0 4px;">{{ cart.item_count }}</span>
      </a>
    </nav>
  </div>
</header>

{% # Mobile nav drawer %}
<div class="mnav-overlay" data-mnav-close></div>
<aside class="mnav-drawer">
  <div style="display:flex; align-items:center; justify-content:space-between; padding:16px 18px; border-bottom:1px solid #eceee9;">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name }} — home" style="display:block;">
      <img src="{{ 'mccormacks-logo.png' | asset_url }}" alt="{{ shop.name }}" width="150" height="48" style="width:150px; height:auto; display:block;">
    </a>
    <button aria-label="Close menu" data-mnav-close style="border:none; background:#f4f5f2; width:38px; height:38px; border-radius:999px; color:#2A2B2A; cursor:pointer; display:flex; align-items:center; justify-content:center;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg></button>
  </div>
  <nav style="display:flex; flex-direction:column; padding:6px 0;">
    {%- comment -%} Services is reached from the button at the foot of this drawer,
        so it is not repeated here — mirrors the desktop nav. {%- endcomment -%}
    {%- assign mnav_items = 'Medicines & Health|medicines-health,Vitamins & Supplements|vitamins,Beauty|beauty,Skincare|skincare,Toiletries|toiletries,Mother & Baby|mother-baby,Fragrance|fragrance,Gifting|gifting,Sale|sale,Brands|@pages/brands' | split: ',' -%}
    {%- for entry in mnav_items -%}
      {%- assign bits = entry | split: '|' -%}
      {%- assign target = bits[1] -%}
      {%- if target contains '@' -%}
        {%- assign url = target | remove: '@' | prepend: '/' -%}
      {%- else -%}
        {%- assign url = target | prepend: '/collections/' -%}
      {%- endif -%}
      <a href="{{ url }}" class="hov-bg-tint" style="display:flex; align-items:center; justify-content:space-between; padding:15px 20px; font-weight:700; font-size:15.5px; color:{% if bits[0] == 'Sale' %}#82c914{% else %}#2A2B2A{% endif %}; border-bottom:1px solid #f1f2ef;">
        <span>{{ bits[0] }}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c2c6bd" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg>
      </a>
    {%- endfor -%}
  </nav>
  <div style="padding:18px 20px; margin-top:auto; display:flex; flex-direction:column; gap:12px;">
    <div style="display:flex; gap:12px;">
      <a href="/pages/in-store-services" class="hov-bg-dark" style="flex:1; display:flex; align-items:center; justify-content:center; gap:8px; background:#3f6b4f; color:#ffffff; font-weight:700; font-size:14px; height:46px; border-radius:9px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l9-6 9 6v12"></path><path d="M3 21h18"></path><path d="M9 21v-6h6v6"></path></svg>
        Services
      </a>
      <a href="/pages/store-locator" class="hov-bg-accent-dk" style="flex:1; display:flex; align-items:center; justify-content:center; gap:8px; background:#92C83F; color:#ffffff; font-weight:700; font-size:14px; height:46px; border-radius:9px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.8-7-10a7 7 0 0 1 14 0c0 5.2-7 10-7 10z"></path><circle cx="12" cy="11" r="2.5"></circle></svg>
        Store Locator
      </a>
    </div>
    <div style="display:flex; gap:12px;">
      <a href="{{ routes.account_url }}" class="hov-border-accent" style="flex:1; display:flex; align-items:center; justify-content:center; gap:8px; border:1.5px solid #dfe1dc; color:#2A2B2A; font-weight:700; font-size:14px; height:44px; border-radius:9px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>Account
      </a>
      <a href="/pages/wishlist" class="hov-border-accent" style="flex:1; display:flex; align-items:center; justify-content:center; gap:8px; border:1.5px solid #dfe1dc; color:#2A2B2A; font-weight:700; font-size:14px; height:44px; border-radius:9px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21.5l8.8-8.8a5 5 0 0 0 0-7.1z"></path></svg>Wishlist
      </a>
    </div>
  </div>
</aside>

{% # Main navigation with mega-menus %}
<div class="main-nav-bar" style="width:100%; background:#f2f3f1; border-top:1px solid #e6e7e4; border-bottom:1px solid #e6e7e4;">
  <div data-mega-root style="max-width:1440px; margin:0 auto; padding:3px 30px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:10px 30px; position:relative;">
    <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:8px 18px; font-weight:600; font-size:14px;">
      <a href="/collections/medicines-health" class="hov-green" data-mega-trigger="medicines-health" style="color:#2A2B2A; font-size:13.5px;">Medicines &amp; Health</a>
      <a href="/collections/vitamins" class="hov-green" data-mega-trigger="vitamins" style="color:#2A2B2A; font-size:13.5px;">Vitamins &amp; Supplements</a>
      <a href="/collections/beauty" class="hov-green" data-mega-trigger="beauty" style="color:#2A2B2A; font-size:13.5px;">Beauty</a>
      <a href="/collections/skincare" class="hov-green" data-mega-trigger="skincare" style="color:#2A2B2A; font-size:13.5px;">Skincare</a>
      <a href="/collections/toiletries" class="hov-green" data-mega-trigger="toiletries" style="color:#2A2B2A; font-size:13.5px;">Toiletries</a>
      <a href="/collections/mother-baby" class="hov-green" data-mega-trigger="mother-baby" style="color:#2A2B2A; font-size:13.5px;">Mother &amp; Baby</a>
      <a href="/collections/fragrance" class="hov-green" data-mega-trigger="fragrance" style="color:#2A2B2A; font-size:13.5px;">Fragrance</a>
      <a href="/collections/gifting" class="hov-green" data-mega-trigger="gifting" style="color:#2A2B2A; font-size:13.5px;">Gifting</a>
      <a href="/collections/sale" class="hov-green-dk" data-mega-close style="color:#82c914; font-weight:700; font-size:13.5px;">Sale</a>
      <a href="/pages/brands" class="hov-green" data-mega-close style="color:#2A2B2A; font-size:13.5px;">Brands</a>
    </nav>
    <div style="display:flex; align-items:center; gap:9px;">
      <a href="/pages/in-store-services" class="hov-bg-green-dk" style="display:flex; align-items:center; gap:9px; background:#3f6b4f; color:#ffffff; font-weight:700; font-size:13px; padding:0 16px; height:30px; border-radius:9px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l9-6 9 6v12"></path><path d="M3 21h18"></path><path d="M9 21v-6h6v6"></path></svg>
        <span>In-Store Services</span>
      </a>
      <a href="/pages/store-locator" class="hov-bg-accent-dk" style="display:flex; align-items:center; gap:9px; background:#92C83F; color:#ffffff; font-weight:700; font-size:13px; padding:0 16px; height:30px; border-radius:9px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.8-7-10a7 7 0 0 1 14 0c0 5.2-7 10-7 10z"></path><circle cx="12" cy="11" r="2.4"></circle></svg>
        <span>Store Locator</span>
      </a>
    </div>
    {% render 'mega-menu' %}
  </div>
</div>

{%- comment -%} Cart drawer lives in the header so it is present on every page,
    which is what lets add-to-cart from a collection or the PDP open it. {%- endcomment -%}
{% render 'cart-drawer' %}

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
