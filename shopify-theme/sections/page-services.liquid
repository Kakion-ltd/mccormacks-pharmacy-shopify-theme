{% render 'trust-row' %}

{% comment %}
  Hub -> detail -> booking behavior reproduced with theme.js data-view tabs
  (hub visible by default; service details and the booking form are hidden panels).
  The booking form posts as a Shopify contact form with a hidden
  contact[form_type] = "appointment-request" tag field.
{% endcomment %}

{% style %}
  @media (max-width: 1040px) {
    .svc-wrap { align-items: stretch !important; flex-direction: column !important; gap: 28px !important; }
    .svc-side { flex: 1 1 auto !important; width: 100% !important; position: static !important; top: auto !important; }
  }
  .svc-card { display: flex; flex-direction: column; border: 1px solid #e6e7e4; border-radius: 16px; overflow: hidden; background: #ffffff; transition: box-shadow .18s, transform .18s; }
  .svc-card:hover { box-shadow: 0 14px 30px rgba(0,0,0,.09); transform: translateY(-3px); }
  .svc-input { height: 50px; border: 1px solid #dfe1dc; border-radius: 9px; padding: 0 14px; font-family: inherit; font-size: 15.5px; color: #2A2B2A; outline: none; }
  .svc-input:focus { border-color: #82C914; }
  .svc-textarea { border: 1px solid #dfe1dc; border-radius: 9px; padding: 12px 14px; font-family: inherit; font-size: 15.5px; line-height: 1.6; color: #2A2B2A; outline: none; resize: vertical; }
  .svc-textarea:focus { border-color: #82C914; }
  .svc-link-btn { background: none; border: none; padding: 0; font-family: inherit; cursor: pointer; text-align: left; }
  .svc-outline:hover { border-color: #92C83F !important; }
  .svc-band-outline:hover { border-color: #92C83F !important; color: #92C83F !important; }
  /* Detail body typography (ported from the design's inline styles) */
  .svcd p { margin: 0 0 15px; font-size: 16px; line-height: 1.75; color: #3a3d39; text-wrap: pretty; }
  .svcd h2, .svcd h3 { font-family: 'Arial Rounded MT Bold', Arial, sans-serif; font-weight: 800; color: #3f6b4f; font-size: clamp(19px, 2vw, 24px); line-height: 1.25; margin: 30px 0 12px; }
  .svcd ul, .svcd ol { margin: 0 0 15px; padding-left: 22px; display: flex; flex-direction: column; gap: 9px; font-size: 16px; line-height: 1.7; color: #3a3d39; }
{% endstyle %}

{%- capture store_options -%}
  <option>Clonmel</option><option>Ballylanders</option><option>Newbridge</option><option>Tullamore</option><option>Haggardstown</option><option>Carrick Road Dundalk</option><option>Belmullet</option>
{%- endcapture -%}

<div data-view="svc-hub">
  <section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
    <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 16px;">
      <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><span style="color:#3a3d39; font-weight:700;">In-Store Services</span>
    </nav>
    <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(28px,3.2vw,42px); line-height:1.08; margin:0 0 12px;">{{ section.settings.heading }}</h1>
    <p style="margin:0 0 26px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ section.settings.intro }}</p>
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:22px;">
      {%- for block in section.blocks -%}
        <div class="svc-card" {{ block.shopify_attributes }}>
          <button type="button" class="svc-link-btn" data-view-btn="svc-{{ forloop.index }}" style="display:block; width:100%; aspect-ratio:16/10; overflow:hidden; background:#f4f5f2;">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: style: 'width:100%; height:100%; object-fit:cover; display:block;', alt: block.settings.title | escape }}
            {%- else -%}
              <div role="img" aria-label="{{ block.settings.title | escape }}" style="width:100%; height:100%; display:flex; align-items:flex-end; padding:20px 22px; background:linear-gradient(150deg,#eef2e8 0%,#e2ebd6 100%); border-bottom:3px solid #92C83F;"><span style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:17px; line-height:1.25; color:#3f6b4f; opacity:.55;">{{ block.settings.title }}</span></div>
            {%- endif -%}
          </button>
          <div style="padding:20px 22px 24px; display:flex; flex-direction:column; gap:11px; flex:1;">
            <div style="display:flex; flex-wrap:wrap; align-items:center; gap:9px;">
              <span style="display:inline-flex; align-items:center; height:25px; padding:0 10px; border-radius:6px; background:#eef2e8; color:#3f6a17; font-size:11.5px; font-weight:800; letter-spacing:.04em; text-transform:uppercase;">{{ block.settings.tag }}</span>
              <span style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:14px; color:#3f6b4f;">{{ block.settings.price_note }}</span>
            </div>
            <button type="button" class="svc-link-btn hov-green" data-view-btn="svc-{{ forloop.index }}" style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:19px; line-height:1.25; color:#3f6b4f;">{{ block.settings.title }}</button>
            <div style="font-size:14.5px; line-height:1.65; color:#5d6159; flex:1;">{{ block.settings.blurb }}</div>
            <button type="button" class="svc-link-btn hov-green-dk" data-view-btn="svc-{{ forloop.index }}" style="display:inline-flex; align-items:center; gap:8px; font-weight:800; font-size:14.5px; color:#82C914; margin-top:2px;">Learn more
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg>
            </button>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div style="margin:40px 0 0; padding:26px 28px; border-radius:16px; background:#3f6b4f; color:#ffffff; display:flex; flex-wrap:wrap; align-items:center; gap:20px 32px;">
      <div style="flex:1 1 340px;">
        <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:clamp(20px,2.1vw,26px); line-height:1.25; margin:0 0 7px;">Not sure which service you need?</div>
        <div style="font-size:15px; line-height:1.65; color:#d6e2cd;">Call us and describe what is going on. We will tell you what we can help with in store, and when you are better off seeing your GP.</div>
      </div>
      <div style="flex:0 0 auto; display:flex; flex-wrap:wrap; gap:12px;">
        <a href="tel:0526199329" class="hov-bg-accent-dk" style="display:inline-flex; align-items:center; height:50px; padding:0 24px; border-radius:10px; background:#92C83F; color:#ffffff; font-weight:800; font-size:15px;">052 6199329</a>
        <button type="button" class="svc-link-btn svc-band-outline" data-view-btn="svc-book" style="display:inline-flex; align-items:center; height:50px; padding:0 24px; border-radius:10px; border:1.5px solid rgba(255,255,255,.28); color:#ffffff; font-weight:700; font-size:15px;">Request an appointment</button>
      </div>
    </div>
  </section>
</div>

{%- for block in section.blocks -%}
  <div data-view="svc-{{ forloop.index }}" style="display:none">
    <section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
      <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 16px;">
        <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><button type="button" data-view-btn="svc-hub" class="svc-link-btn hov-green" style="font-size:13px; color:#8b9182;">In-Store Services</button><span>/</span><span style="color:#3a3d39; font-weight:700;">{{ block.settings.title }}</span>
      </nav>
      <div class="svc-wrap" style="display:flex; gap:44px; align-items:flex-start;">
        <div style="flex:1 1 auto; min-width:0; max-width:780px;">
          <span style="display:inline-flex; align-items:center; height:26px; padding:0 11px; border-radius:6px; background:#eef2e8; color:#3f6a17; font-size:12px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; margin-bottom:14px;">{{ block.settings.tag }}</span>
          <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(28px,3.2vw,42px); line-height:1.08; margin:0 0 12px;">{{ block.settings.title }}</h2>
          <p style="margin:0 0 26px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ block.settings.detail_intro }}</p>
          <div class="svcd">{{ block.settings.body }}</div>
          {%- if block.settings.specs != blank -%}
            <div style="margin:26px 0 0; border-top:1px solid #e6e7e4;">
              {%- assign spec_lines = block.settings.specs | newline_to_br | split: '<br />' -%}
              {%- for line in spec_lines -%}
                {%- assign parts = line | split: '|' -%}
                <div style="display:flex; flex-wrap:wrap; gap:6px 20px; padding:15px 0; border-bottom:1px solid #eceee9;">
                  <span style="flex:0 0 190px; font-weight:800; font-size:14.5px; color:#2A2B2A;">{{ parts[0] | strip }}</span>
                  <span style="flex:1 1 260px; font-size:15.5px; line-height:1.7; color:#3a3d39;">{{ parts[1] | strip }}</span>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
          <div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:28px;">
            <button type="button" class="svc-link-btn hov-bg-green-dk" data-view-btn="svc-book" style="display:inline-flex; align-items:center; justify-content:center; gap:9px; height:52px; padding:0 26px; border-radius:10px; background:#82C914; color:#ffffff; font-weight:800; font-size:15.5px;">Request an appointment</button>
            <a href="tel:0526199329" class="svc-outline" style="display:inline-flex; align-items:center; justify-content:center; gap:9px; height:52px; padding:0 26px; border-radius:10px; border:1.5px solid #cdd3c5; color:#3f6b4f; font-weight:700; font-size:15px;">Call 052 6199329</a>
          </div>
          <div style="margin-top:28px; padding-top:22px; border-top:1px solid #e6e7e4;">
            <button type="button" class="svc-link-btn hov-green-dk" data-view-btn="svc-hub" style="display:inline-flex; align-items:center; gap:9px; font-weight:800; font-size:15px; color:#82C914;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="11 6 5 12 11 18"></polyline></svg>
              All services
            </button>
          </div>
        </div>
        <aside class="svc-side" style="flex:0 0 330px; width:330px; position:sticky; top:20px;">
          <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
            <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:19px; color:#3f6b4f; margin:0 0 4px;">{{ block.settings.price_note }}</div>
            <div style="font-size:13.5px; color:#6b7065; margin:0 0 18px;">{{ block.settings.tag }}</div>
            <div style="display:flex; flex-direction:column; gap:14px;">
              <label style="display:flex; flex-direction:column; gap:7px; min-width:0;">
                <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Your name</span>
                <input type="text" class="svc-input">
              </label>
              <label style="display:flex; flex-direction:column; gap:7px; min-width:0;">
                <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Phone number</span>
                <input type="tel" class="svc-input">
              </label>
              <label style="display:flex; flex-direction:column; gap:7px;">
                <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Preferred store</span>
                <select class="svc-input" style="padding:0 12px; background:#ffffff;">{{ store_options }}</select>
              </label>
            </div>
            <div style="margin-top:18px;"><button type="button" class="svc-link-btn hov-bg-green-dk" data-view-btn="svc-book" style="display:inline-flex; align-items:center; justify-content:center; gap:9px; height:52px; padding:0 26px; border-radius:10px; background:#82C914; color:#ffffff; font-weight:800; font-size:15.5px; width:100%;">Request appointment</button></div>
            <div style="font-size:12.5px; line-height:1.6; color:#8b9182; margin-top:12px;">We will call you back to confirm a time. Requesting an appointment does not guarantee a slot.</div></div>
          <div style="margin-top:16px; padding:20px 22px; border-radius:16px; background:#eef2e8;">
            <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:16.5px; color:#3f6b4f; margin-bottom:7px;">Other services</div>
            <div style="display:flex; flex-direction:column; gap:9px;">
              {%- assign current_index = forloop.index -%}
              {%- assign shown = 0 -%}
              {%- for other in section.blocks -%}
                {%- if forloop.index == current_index or shown >= 4 -%}{%- continue -%}{%- endif -%}
                {%- assign shown = shown | plus: 1 -%}
                <button type="button" class="svc-link-btn hov-green" data-view-btn="svc-{{ forloop.index }}" style="font-size:14.5px; font-weight:700; color:#3a3d39;">{{ other.settings.title }}</button>
              {%- endfor -%}
            </div>
          </div>
        </aside>
      </div>
    </section>
  </div>
{%- endfor -%}

<div data-view="svc-book" style="display:none">
  <section style="max-width:820px; margin:0 auto; padding:34px 30px 20px;">
    <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 16px;">
      <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><button type="button" data-view-btn="svc-hub" class="svc-link-btn hov-green" style="font-size:13px; color:#8b9182;">In-Store Services</button><span>/</span><span style="color:#3a3d39; font-weight:700;">Request an appointment</span>
    </nav>
    <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(28px,3.2vw,42px); line-height:1.08; margin:0 0 12px;">Request an appointment</h2>
    <p style="margin:0 0 26px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">Tell us what you need and we will call you back to confirm a time. For urgent matters please phone the store directly.</p>
    <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
      {%- form 'contact', id: 'svc-book-form' -%}
        <input type="hidden" name="contact[form_type]" value="appointment-request">
        {%- if form.posted_successfully? -%}
          <div style="background:#EEF6E4; border:1px solid #d8e9c2; border-radius:12px; padding:16px 18px; margin:0 0 18px; color:#5E8A1F; font-size:14.5px; line-height:1.65; font-weight:700;">Thanks — your appointment request has been received. We will call you back to confirm a time.</div>
        {%- endif -%}
        {%- if form.errors -%}
          <div style="background:#FBEAE9; border:1px solid #ecc8c5; border-radius:12px; padding:16px 18px; margin:0 0 18px; color:#B3261E; font-size:14.5px; line-height:1.65;">
            {%- for field in form.errors -%}
              <div>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div style="display:flex; flex-wrap:wrap; gap:16px;">
          <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
            <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">First name</span>
            <input class="svc-input" type="text" name="contact[first_name]" placeholder="">
          </label>
          <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
            <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Last name</span>
            <input class="svc-input" type="text" name="contact[last_name]" placeholder="">
          </label>
          <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px; min-width:0;">
            <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Email address</span>
            <input class="svc-input" type="email" name="contact[email]" required placeholder="you@example.com">
          </label>
          <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
            <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Phone number</span>
            <input class="svc-input" type="tel" name="contact[phone]" placeholder="">
          </label>
          <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
            <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Service</span>
            <select class="svc-input" name="contact[service]" style="padding:0 12px; background:#ffffff;">
              {%- for block in section.blocks -%}
                <option>{{ block.settings.title }}</option>
              {%- endfor -%}
            </select>
          </label>
          <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
            <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Preferred store</span>
            <select class="svc-input" name="contact[preferred_store]" style="padding:0 12px; background:#ffffff;">{{ store_options }}</select>
          </label>
          <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
            <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Preferred day</span>
            <input class="svc-input" type="date" name="contact[preferred_day]" placeholder="">
          </label>
          <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
            <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Preferred time</span>
            <select class="svc-input" name="contact[preferred_time]" style="padding:0 12px; background:#ffffff;">
              <option>Morning</option><option>Afternoon</option><option>Either</option>
            </select>
          </label>
          <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px;">
            <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Anything we should know?</span>
            <textarea class="svc-textarea" rows="4" name="contact[body]" placeholder="Optional &mdash; briefly tell us what you need"></textarea>
          </label>
        </div>
        <label style="display:flex; align-items:flex-start; gap:11px; margin:18px 0 22px; font-size:14px; line-height:1.6; color:#3a3d39;">
          <input type="checkbox" required style="margin-top:3px; accent-color:#82C914; width:17px; height:17px;">
          <span>I understand this is a request, not a confirmed booking, and that my details will be handled in line with the <a href="/pages/privacy-policy" class="hov-green-dk" style="font-weight:700;">Privacy Policy</a>.</span>
        </label>
        <button type="submit" class="hov-bg-green-dk" style="display:inline-flex; align-items:center; justify-content:center; gap:9px; height:52px; padding:0 26px; border:none; cursor:pointer; border-radius:10px; background:#82C914; color:#ffffff; font-weight:800; font-size:15.5px; width:100%;">Send request</button>
      {%- endform -%}
    </div>
    <div style="margin-top:22px;">
      <button type="button" class="svc-link-btn hov-green-dk" data-view-btn="svc-hub" style="display:inline-flex; align-items:center; gap:9px; font-weight:800; font-size:15px; color:#82C914;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="11 6 5 12 11 18"></polyline></svg>
        All services
      </button>
    </div>
  </section>
</div>

<script>
  /* Scroll to top when switching service views (matches the design's view-change behavior). */
  document.currentScript.parentElement.addEventListener('click', e => {
    if (e.target.closest('[data-view-btn]')) window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

{% schema %}
{
  "name": "In-Store Services",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "In-store services" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "More than a shop counter. Our pharmacists offer vaccination clinics, health screening, fitting consultations and everyday practical services across our stores — most without a GP referral." }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Blood Pressure Screening" },
        { "type": "text", "id": "tag", "label": "Tag chip", "default": "Walk-in" },
        { "type": "text", "id": "price_note", "label": "Price / booking note", "default": "Free" },
        { "type": "textarea", "id": "blurb", "label": "Card blurb" },
        { "type": "image_picker", "id": "image", "label": "Card image (optional)" },
        { "type": "text", "id": "detail_intro", "label": "Detail intro" },
        { "type": "html", "id": "body", "label": "Detail body (HTML)" },
        { "type": "textarea", "id": "specs", "label": "Spec rows (one per line, Label|Value)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "In-Store Services",
      "blocks": [
        { "type": "service" }
      ]
    }
  ]
}
{% endschema %}
