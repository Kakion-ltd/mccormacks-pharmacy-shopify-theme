{% render 'trust-row' %}

<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
  <div class="legal-wrap" style="display:flex; gap:56px; align-items:flex-start;">

    {% render 'legal-sidebar', active: 'shipping', updated_date: section.settings.updated_date, show_help: section.settings.show_help_card, phone: section.settings.help_phone %}

    <div style="flex:1; min-width:0; max-width:820px;">
      <div>
      <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 14px;">
        <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><span>Shipping &amp; Delivery</span><span>/</span><span style="color:#3a3d39; font-weight:700;">Shipping &amp; Free Delivery</span>
      </nav>
      <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(30px,3.4vw,42px); line-height:1.08; margin:0 0 14px;">{{ section.settings.heading }}</h1>
      <p style="margin:0 0 28px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ section.settings.intro }}</p>
      <div style="height:1px; background:#e6e7e4;"></div>
      <div style="display:flex; gap:14px; align-items:flex-start; background:#eef2e8; border-radius:14px; padding:18px 20px; margin:0 0 24px; margin-top:26px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="#82C914" style="flex:0 0 auto; margin-top:2px;"><path d="M3 5.75A1.75 1.75 0 0 1 4.75 4h8.5A1.75 1.75 0 0 1 15 5.75V6h2.6c.5 0 .96.24 1.25.64l2.4 3.3c.16.22.25.49.25.76V15a1.5 1.5 0 0 1-1.5 1.5h-.6a2.75 2.75 0 0 1-5.4 0H10.4a2.75 2.75 0 0 1-5.4 0h-.25A1.75 1.75 0 0 1 3 14.75V5.75Z"></path></svg>
        <div>
          <div style="font-weight:800; font-size:16.5px; color:#3f6b4f; margin-bottom:4px;">Free shipping on all orders over {% render 'free-delivery-amount' %}</div>
          <div style="font-size:14.5px; line-height:1.6; color:#3a3d39;">Applied automatically at checkout. Excludes All Saver bundles.</div>
        </div>
      </div><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Delivery options</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:16px; margin:0 0 8px;">
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:22px 24px; background:#fbfcfa; display:flex; flex-direction:column; gap:7px;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:17.5px; color:#3f6b4f;">Standard Delivery</div>
          <div style="display:flex; align-items:baseline; gap:10px; flex-wrap:wrap;">
            <span style="font-weight:800; font-size:22px; color:#2A2B2A;">DPD</span>
            <span style="font-size:13.5px; font-weight:700; color:#82C914;">Republic of Ireland, 3&ndash;5 working days</span>
          </div>
          <div style="font-size:14px; line-height:1.6; color:#5d6159;">All orders are shipped with DPD. Free on orders over {% render 'free-delivery-amount' %}, excluding All Saver bundles.</div>
        </div>
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:22px 24px; background:#fbfcfa; display:flex; flex-direction:column; gap:7px;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:17.5px; color:#3f6b4f;">Click &amp; Collect</div>
          <div style="display:flex; align-items:baseline; gap:10px; flex-wrap:wrap;">
            <span style="font-weight:800; font-size:22px; color:#2A2B2A;">Free</span>
            <span style="font-size:13.5px; font-weight:700; color:#82C914;">Collect in store</span>
          </div>
          <div style="font-size:14px; line-height:1.6; color:#5d6159;">You will be notified by email or SMS as soon as your order is ready in your selected store.</div>
        </div>
      </div><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Dispatch</h3><ul style="margin:0 0 16px; padding-left:4px; font-size:15.5px; line-height:1.7; color:#3a3d39; list-style:none; display:flex; flex-direction:column; gap:9px;"><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>We strive to dispatch all products as quickly as possible.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>All orders processed after 2.00pm Friday through to Sunday will be dispatched on Monday.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>Please call us on <a href="tel:0526199329">052 6199329</a> for any further queries.</span></li></ul><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Incorrect shipping addresses</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">It is the buyer&rsquo;s responsibility to ensure that the full shipping address supplied at checkout is correct. Please review this before placing your order. We prioritise a fast dispatch and delivery timeframe, so it may not be possible to amend your delivery or shipping information after you place your order.</p>
      <div style="display:flex; gap:14px; align-items:flex-start; background:#fdf6e9; border:1px solid #f0e2c4; border-radius:14px; padding:18px 20px; margin:0 0 24px;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="#c98a1b" style="flex:0 0 auto; margin-top:2px;"><path d="M12 2 1.5 21h21L12 2Zm0 5.5 6.6 12H5.4L12 7.5Zm-1 3v4.5h2V10.5h-2Zm0 5.8v2h2v-2h-2Z"></path></svg>
        <div>
          <div style="font-weight:800; font-size:16px; color:#8a6210; margin-bottom:4px;">Items returned to sender</div>
          <div style="font-size:14.5px; line-height:1.65; color:#5c4a24;">If you enter an incorrect or incomplete shipping address and your item is returned to sender, we will only resend your order after the buyer pays an additional shipping fee. If the order is subsequently cancelled after being returned to sender, a restocking fee of &euro;5 will apply to each order and will be deducted from the refund amount.</div>
        </div>
      </div><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Questions about your order</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">If you would like an update on your order, or have any other query relating to your online order, please don&rsquo;t hesitate to contact us on <a href="tel:0526199329">052 6199329</a> during working hours. If you would like to order something from our website and are unable to do so, please contact us and we will assist you.</p>
      </div>

      {% render 'legal-question-card' %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Shipping page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & Free Delivery" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "We strive to dispatch all products as quickly as possible. Orders are shipped with DPD to all Irish addresses." },
    { "type": "text", "id": "updated_date", "label": "Last reviewed date", "default": "12 June 2026" },
    { "type": "checkbox", "id": "show_help_card", "label": "Show pharmacist help card", "default": true },
    { "type": "text", "id": "help_phone", "label": "Help phone number", "default": "052 6199329" }
  ],
  "presets": [{ "name": "Shipping page" }]
}
{% endschema %}
