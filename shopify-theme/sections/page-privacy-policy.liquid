{% render 'trust-row' %}

<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
  <div class="legal-wrap" style="display:flex; gap:56px; align-items:flex-start;">

    {% render 'legal-sidebar', active: 'privacy', updated_date: section.settings.updated_date, show_help: section.settings.show_help_card, phone: section.settings.help_phone %}

    <div style="flex:1; min-width:0; max-width:820px;">
      <div>
      <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 14px;">
        <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><span>Policies</span><span>/</span><span style="color:#3a3d39; font-weight:700;">Privacy Policy</span>
      </nav>
      <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(30px,3.4vw,42px); line-height:1.08; margin:0 0 14px;">{{ section.settings.heading }}</h1>
      <p style="margin:0 0 28px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ section.settings.intro }}</p>
      <div style="height:1px; background:#e6e7e4;"></div><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Who can use this website</h2><ul style="margin:0 0 16px; padding-left:4px; font-size:15.5px; line-height:1.7; color:#3a3d39; list-style:none; display:flex; flex-direction:column; gap:9px;"><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>You must be over 18 to register for an account, place orders, or subscribe to our email newsletters.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>McCormack&rsquo;s Pharmacy <strong>do not collect information on persons under the age of 18</strong>.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>The information provided on this website is for guidance and information only and should not take the place of a diagnosis by your general practitioner or local pharmacist.</span></li></ul><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">1. Types of information collected</h2><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Personal data</h3><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">Personal data is information that can be used to identify you. This includes your name, email address, billing address, postal address and telephone numbers.</p><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Non-personal data</h3><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">Non-personal data is information that cannot be used to identify or contact you. This is statistical and analytical data about our users&rsquo; browsing actions and patterns.</p><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">2. Why we may collect the information</h2><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Why we collect personal data</h3><ul style="margin:0 0 16px; padding-left:4px; font-size:15.5px; line-height:1.7; color:#3a3d39; list-style:none; display:flex; flex-direction:column; gap:9px;"><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>To provide you with goods and services you have ordered &mdash; this will involve sharing your personal data with our logistics and shipping partners.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>To contact you regarding your order.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>To respond to communications.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>To offer competitions.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>To inform you of promotions, events and similar.</span></li></ul><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Why we collect non-personal data</h3><ul style="margin:0 0 16px; padding-left:4px; font-size:15.5px; line-height:1.7; color:#3a3d39; list-style:none; display:flex; flex-direction:column; gap:9px;"><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>To gain a better understanding of site usage so we can improve the website and provide an enhanced customer experience.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>To estimate audience size and usage patterns.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>To store user preferences so you can customise the site.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>To track return visitors.</span></li></ul><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">3. How we collect the information</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">When you register with our website we create an account for you and record your details in our database. Any time you make an order, we record your billing and shipping address details so that you can select them quickly the next time you create an order.</p><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Registering an account</h3><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">We collect your email, first and last name, address details, phone number, password details (these are encrypted and not accessible by McCormack&rsquo;s Pharmacy), order history details and product wish list details.</p><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Completing an order</h3><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">During the order process we collect your email, first and last name, address details, mobile phone number and order details.</p><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Making a payment</h3>
      <div style="margin:0 0 20px;">
          <div style="display:flex; flex-wrap:wrap; gap:6px 18px; padding:13px 0; border-bottom:1px solid #eceee9;">
            <span style="flex:0 0 210px; font-weight:800; font-size:14.5px; color:#2A2B2A;">Global Payments</span>
            <span style="flex:1 1 240px; font-size:15px; line-height:1.6; color:#3a3d39;">Our website uses Global Payments (formerly Realex) for securely accepting credit card payments. We never record your credit card details in our database, but pass these details on to Realex Payments.</span>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:6px 18px; padding:13px 0; border-bottom:1px solid #eceee9;">
            <span style="flex:0 0 210px; font-weight:800; font-size:14.5px; color:#2A2B2A;">PayPal</span>
            <span style="flex:1 1 240px; font-size:15px; line-height:1.6; color:#3a3d39;">Our website accepts payment via PayPal. We never record your credit card details in our database, but pass these details on to PayPal.</span>
          </div>
      </div><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Contact forms</h3><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">Data supplied via contact forms is recorded in our database, and we reply to all contacts made directly through email. Forms on our website include Contact Us, Ask Our Pharmacist, Chiropody / Podiatry Appointment, Physiotherapy Appointment and Newsletter Signup. Data collected via these forms includes your name, email address, message information and contact number.</p><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Email marketing</h3><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">We use BrotherMailer to engage with our customers via email. A customer may subscribe via the checkout process, contact us forms, newsletter sign-up, or when creating an account. The data collected includes name, email address, order history, wish lists and abandoned baskets. There is an UNSUBSCRIBE link at the bottom of all our emails so that you can unsubscribe from our email database at any time.</p><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Personalisation &mdash; Nosto</h3><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">We record activity on our website with Nosto, our personalisation engine, which allows us to tailor the offers displayed to you based on products and categories you have shown an interest in. Once an order is complete we use Nosto to send a personalised follow-up email, and Nosto will use information entered prior to checkout to send an abandoned cart email with links to the products in your basket. This will only happen if you have subscribed to our email marketing.</p><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Reviews &mdash; Trustpilot</h3><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">We use Trustpilot to display our service and product ratings and reviews. To facilitate you giving a review we pass some personally identifiable data, including your email address and name, along with order details, to Trustpilot.</p><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Real-time messaging &mdash; Pubble</h3><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">We use Pubble to communicate via real-time messaging with our customers. If you submit your email address or telephone number while using the messaging service, we will never send you marketing information unless you have asked for an update on when stock is available to order. By entering your contact details for this service you are NOT subscribing to our email newsletter.</p><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Analytics &amp; tracking</h3><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">We record activity on our website with Google Analytics. This helps us analyse the performance of the website and is essential to understand our business. Third-party tracking tools used on this site include Facebook Pixel, Google Tag, Google Ad Services, Doubleclick.net and Adroll.com.</p><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">4. Customer rights</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">Under the Data Protection Acts 1988 &amp; 2002 the customer has a number of rights, including:</p><ul style="margin:0 0 16px; padding-left:4px; font-size:15.5px; line-height:1.7; color:#3a3d39; list-style:none; display:flex; flex-direction:column; gap:9px;"><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>Right of access</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>Right to rectification</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>Right of erasure</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>Right of data portability</span></li></ul><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">5. Changes to this privacy statement</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">Any changes to the privacy statement will be posted on this website.</p><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">6. Contact us</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">Any questions, comments or queries regarding this privacy statement should be addressed to <a href="mailto:info@mccormackspharmacy.ie">info@mccormackspharmacy.ie</a>.</p>
      </div>

      {% render 'legal-question-card' %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Privacy Policy page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Privacy Policy" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "This is the Privacy Policy for McCormack’s Pharmacy and applies to our website. The purpose of this policy is to give you an understanding of the information we collect, how we use that information, and your rights in this regard." },
    { "type": "text", "id": "updated_date", "label": "Last reviewed date", "default": "12 June 2026" },
    { "type": "checkbox", "id": "show_help_card", "label": "Show pharmacist help card", "default": true },
    { "type": "text", "id": "help_phone", "label": "Help phone number", "default": "052 6199329" }
  ],
  "presets": [{ "name": "Privacy Policy page" }]
}
{% endschema %}
