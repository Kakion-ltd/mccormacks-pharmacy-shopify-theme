{% render 'trust-row' %}
<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">

  <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 16px;">
    <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><a href="{{ routes.account_url }}" class="hov-green" style="color:#8b9182;">My account</a><span>/</span><span style="color:#3a3d39; font-weight:700;">Addresses</span>
  </nav>
  <div class="acct-wrap" style="display:flex; gap:40px; align-items:flex-start;">

    {% render 'account-sidebar', active: 'addr' %}

    <div style="flex:1 1 auto; min-width:0;">

      <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(20px,2.1vw,26px); margin:0 0 16px;">Addresses</h2>

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:16px; margin:0 0 22px;">
        {% for address in customer.addresses %}
          <div>
            <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
              <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
                {% if address.id == customer.default_address.id %}
                  <span style="display:inline-flex; align-items:center; height:24px; padding:0 9px; border-radius:6px; background:#eef2e8; color:#3f6a17; font-size:11.5px; font-weight:800;">Default delivery</span>
                {% else %}
                  <span style="display:inline-flex; align-items:center; height:24px; padding:0 9px; border-radius:6px; background:#f2f3f1; color:#5d6159; font-size:11.5px; font-weight:800;">Saved address</span>
                {% endif %}
              </div>
              <div class="acct-addr" style="font-size:14.5px; line-height:1.7; color:#3a3d39;">{{ address | format_address }}</div>
              <div style="display:flex; gap:14px; margin-top:14px; align-items:center;">
                <button type="button" data-addr-toggle="EditAddress-{{ address.id }}" style="border:none; background:transparent; padding:0; cursor:pointer; font-family:inherit; font-size:13.5px; font-weight:700; color:#82C914;">Edit</button>
                <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" data-confirm="Remove this address?" style="margin:0;">
                  <input type="hidden" name="_method" value="delete">
                  <button type="submit" class="hov-remove" style="border:none; background:transparent; padding:0; cursor:pointer; font-family:inherit; font-size:13.5px; font-weight:700; color:#6b7065;">Remove</button>
                </form>
              </div>
            </div>
            <div id="EditAddress-{{ address.id }}" class="addr-form-panel" style="display:none; border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff; margin-top:12px;">
              {% assign edit_panel_id = 'EditAddress-' | append: address.id %}
              {% render 'address-form', address: address, panel_id: edit_panel_id, heading: 'Edit address' %}
            </div>
          </div>
        {% endfor %}
        <button type="button" data-addr-toggle="NewAddress" class="hov-add-tile" style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; border:1.5px dashed #cdd3c5; border-radius:16px; padding:26px; background:transparent; cursor:pointer; font-family:inherit; color:#3f6b4f; min-height:170px;">
          <span style="width:40px; height:40px; border-radius:999px; background:#eef2e8; display:flex; align-items:center; justify-content:center; font-size:22px; font-weight:700; color:#82C914;">+</span>
          <span style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:15.5px;">Add a new address</span>
        </button>
      </div>

      <div id="NewAddress" class="addr-form-panel" style="display:none; border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
        {% render 'address-form', address: customer.new_address, panel_id: 'NewAddress', heading: 'Add a new address' %}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-addr-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var el = document.getElementById(btn.dataset.addrToggle);
        if (el) el.style.display = el.style.display === 'none' ? '' : 'none';
      });
    });
    document.querySelectorAll('form[data-confirm]').forEach(function (f) {
      f.addEventListener('submit', function (e) { if (!confirm(f.dataset.confirm)) e.preventDefault(); });
    });
    // Preselect saved country; reopen any panel whose form came back with errors
    document.querySelectorAll('select[data-default]').forEach(function (s) {
      if (s.dataset.default) s.value = s.dataset.default;
    });
    document.querySelectorAll('.addr-form-panel').forEach(function (p) {
      if (p.querySelector('.form-errors')) p.style.display = '';
    });
  })();
</script>

{% style %}
  .acct-input:focus { border-color: #82C914 !important; }
  .acct-addr p { margin: 0; }
  .hov-border-only:hover { border-color: #92C83F !important; }
  .hov-remove:hover { color: #a33 !important; }
  .hov-add-tile:hover { border-color: #92C83F !important; background: #fbfcfa !important; }
  @media (max-width: 1000px) {
    .acct-wrap { align-items: stretch !important; flex-direction: column !important; gap: 26px !important; }
    .acct-side { flex: 1 1 auto !important; width: 100% !important; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Customer addresses",
  "presets": [{ "name": "Customer addresses" }]
}
{% endschema %}
