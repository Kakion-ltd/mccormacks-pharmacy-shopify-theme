<section style="max-width:1440px; margin:0 auto; padding:20px 30px 44px;">
  <div class="promo-strip-bar" style="width:100%; background:#e6f2d5; border-radius:9px; padding:12px 18px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px 30px;">
    <p style="margin:0; font-size:clamp(15px,1.4vw,18px); font-weight:600; color:#2A2B2A;">{{ section.settings.text }}</p>
    <a href="{{ section.settings.link }}" class="slide-cta btn btn-fill" style="flex:0 0 auto; gap:9px">{{ section.settings.cta }}<svg class="cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s ease;"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="8 7 17 7 17 16"></polyline></svg></a>
  </div>
</section>

{% style %}
/* Desktop: message and button read as one centred cluster instead of
   opposite ends of an empty bar, and the bar sits 60px in from each edge of
   the rail so it is narrower than the hero and pills above it. Height, radius
   and type are the bar's original. Below 901px it stays full width. */
@media (min-width: 901px) {
  .promo-strip-bar { justify-content: center !important; gap: 16px 34px !important; width: calc(100% - 120px) !important; margin: 0 auto !important; }
}
{% endstyle %}

{% schema %}
{
  "name": "Promo strip",
  "settings": [
    { "type": "html", "id": "text", "label": "Text", "default": "Pollen levels are rising — stock up on your <strong style=\"font-weight:800;\">Hayfever</strong> essentials today." },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Promo strip", "settings": { "link": "/collections/hayfever-allergy" } }
  ]
}
{% endschema %}
