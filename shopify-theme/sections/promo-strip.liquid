<section style="max-width:1440px; margin:0 auto; padding:20px 30px 44px;">
  <div class="promo-strip-bar" style="width:100%; background:#e6f2d5; border-radius:9px; padding:12px 18px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px 30px;">
    <p style="margin:0; font-size:clamp(15px,1.4vw,18px); font-weight:600; color:#2A2B2A;">{{ section.settings.text }}</p>
    <a href="{{ section.settings.link }}" class="slide-cta btn btn-deep" style="flex:0 0 auto; gap:9px">{{ section.settings.cta }}<svg class="cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s ease;"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="8 7 17 7 17 16"></polyline></svg></a>
  </div>
</section>

{% style %}
/* Desktop: the bar is only as wide as the message and button, centred, so
   the tint marks the notice rather than ruling an empty row across the page.
   It grows with longer copy up to the rail width, then wraps. Height, radius
   and type are the bar's original. Below 901px it stays full width. */
@media (min-width: 901px) {
  .promo-strip-bar { width: fit-content !important; max-width: calc(100% - 120px); margin: 0 auto !important; justify-content: center !important; gap: 16px 34px !important; padding: 12px 18px 12px 26px !important; }
}
/* Phone: a notice is a sentence with a link at the end, not a card. The copy
   wraps as one centred paragraph and the button becomes an underlined link
   with its arrow, halving the bar's height. Desktop is untouched. */
@media (max-width: 900px) {
  .promo-strip-bar { display: block !important; text-align: center; padding: 10px 16px !important; }
  .promo-strip-bar p { display: inline; font-size: 14.5px !important; line-height: 1.45; }
  .promo-strip-bar .btn { display: inline-flex; vertical-align: middle; min-height: 24px; padding: 0 2px; margin-left: 4px; background: none; border: none; color: var(--c-primary-text); font-size: 14.5px; font-weight: 800; gap: 4px; text-decoration: underline; text-underline-offset: 3px; }
  .promo-strip-bar .btn:hover { background: none; box-shadow: none; transform: none; color: var(--c-dark); }
  .promo-strip-bar .btn svg { width: 14px; height: 14px; }
}
{% endstyle %}

{% schema %}
{
  "name": "Promo strip",
  "settings": [
    { "type": "html", "id": "text", "label": "Text", "default": "Pollen levels are rising — stock up on your <strong style=\"font-weight:800;\">Hayfever</strong> essentials today." },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Promo strip", "settings": { "link": "/collections/hayfever-allergy" } }
  ]
}
{% endschema %}
