{%- comment -%} Onboarding fallback path only: slide 1 is the LCP element, but a
    theme asset has no image object, so image_tag's preload: argument is not
    available and the link has to be written by hand. theme-check flags this as
    AssetPreload — expected here, and it stops applying the moment a real image
    is picked in the editor. {%- endcomment -%}
{%- assign first_slide = section.blocks.first -%}
{%- if first_slide and first_slide.settings.image == blank and first_slide.settings.image_mobile == blank and first_slide.settings.image_asset != blank -%}
  {%- comment -%} Scoped by media once a mobile crop exists: an unqualified preload would
      pull the 1760px desktop file onto every phone, which then fetches the mobile one
      as well — two downloads to render one LCP element. {%- endcomment -%}
  {%- if first_slide.settings.image_mobile_asset != blank -%}
    <link rel="preload" as="image" href="{{ first_slide.settings.image_asset | asset_url }}" media="(min-width: 901px)" fetchpriority="high">
    <link rel="preload" as="image" href="{{ first_slide.settings.image_mobile_asset | asset_url }}" media="(max-width: 900px)" fetchpriority="high">
  {%- else -%}
    <link rel="preload" as="image" href="{{ first_slide.settings.image_asset | asset_url }}" fetchpriority="high">
  {%- endif -%}
{%- endif -%}

<section style="max-width:1440px; margin:0 auto; padding:12px 30px 8px;">
  <div id="hero-{{ section.id }}" data-slider {% if section.settings.autoplay_seconds > 0 %}data-slider-auto="{{ section.settings.autoplay_seconds | times: 1000 }}"{% endif %} class="hero-flex" style="position:relative; display:flex; flex-wrap:wrap; border-radius:18px; overflow:hidden; background:linear-gradient(120deg,#F6F8F1 0%,var(--c-tint) 100%); box-shadow:0 20px 50px rgba(32,69,65,.12);">
    {%- for block in section.blocks -%}
      {%- assign p = forloop.index0 -%}
      <div data-slide {{ block.shopify_attributes }}{% unless forloop.first %} style="display:none;"{% endunless %}>
        <div class="hero-copy" style="flex:0 0 560px; display:flex; flex-direction:column; justify-content:center; padding:clamp(32px,4.5vw,64px); min-height:460px; height:460px; position:relative; z-index:2;">
          {%- if block.settings.badge != blank -%}
          <span class="hero-badge" style="align-self:flex-start; background:var(--c-accent); color:var(--c-on-accent); font-weight:800; font-size:12.5px; letter-spacing:.06em; text-transform:uppercase; padding:6px 11px; border-radius:999px; margin-bottom:14px;">{{ block.settings.badge }}</span>
          {%- endif -%}
          {% if forloop.first %}<h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(32px,4.2vw,54px); line-height:1.02; margin:0 0 16px; letter-spacing:-.01em;">{{ block.settings.title }}</h1>{% else %}<h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(32px,4.2vw,54px); line-height:1.02; margin:0 0 16px; letter-spacing:-.01em;">{{ block.settings.title }}</h2>{% endif %}
          <p style="color:#3a3d39; font-size:clamp(15px,1.3vw,18px); font-weight:600; line-height:1.5; margin:0 0 clamp(24px,3vw,34px); max-width:420px;">{{ block.settings.subtext }}</p>
          <a href="{{ block.settings.link }}" class="slide-cta hero-cta btn btn-fill" style="align-self:flex-start; letter-spacing:.03em; gap:10px">{{ block.settings.cta }}<svg class="cta-arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s ease;"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="8 7 17 7 17 16"></polyline></svg></a>
          <div class="hero-dots" style="display:flex; gap:10px; margin-top:clamp(20px,2.6vw,30px); justify-content:flex-start;">
            {%- for b in section.blocks -%}
              {%- assign j = forloop.index0 -%}
              <button aria-label="Go to slide {{ forloop.index }}" data-dot-proxy="{{ j }}" style="width:{% if j == p %}22{% else %}8{% endif %}px; height:8px; border-radius:999px; border:none; cursor:pointer; padding:0; background:var(--c-dark); opacity:{% if j == p %}1{% else %}.45{% endif %}; transition:width .2s ease;"></button>
            {%- endfor -%}
          </div>
        </div>
        {%- comment -%} One quiet ground for the whole hero. The cut-out cluster is shown
            whole (object-fit contain), never cropped, so one file serves every width
            and nothing baked into it is needed: the theme supplies the ground, the
            lime glow, the shadow and the badge. See IMAGE-BRIEF, hero house rule. {%- endcomment -%}
        <div class="hero-art" style="position:relative; flex:1 1 320px; min-height:460px; height:460px;">
          <div class="hero-glow" aria-hidden="true" style="position:absolute; right:6%; top:50%; width:62%; aspect-ratio:1; transform:translateY(-50%); border-radius:999px; background:radial-gradient(circle, color-mix(in srgb, var(--c-accent) 55%, transparent) 0%, color-mix(in srgb, var(--c-accent) 28%, transparent) 45%, transparent 70%);"></div>
          {%- comment -%} Slide 1 is the LCP element on the homepage: load it eagerly at
              high priority. Every later slide is off-screen behind the slider, so it
              stays lazy — making them all eager would compete with the LCP for bandwidth. {%- endcomment -%}
          {%- liquid
            assign is_first_slide = forloop.first
            if is_first_slide
              assign slide_loading = 'eager'
              assign slide_priority = 'high'
            else
              assign slide_loading = 'lazy'
              assign slide_priority = 'auto'
            endif
          -%}
          {%- assign hero_style = 'position:absolute; inset:0; width:100%; height:100%; object-fit:contain; display:block; padding:28px 24px; box-sizing:border-box; filter:drop-shadow(0 18px 28px rgba(32,69,65,.22));' -%}
          {%- if block.settings.image or block.settings.image_mobile -%}
            {%- comment -%} Separate mobile art where supplied: the desktop frame is
                1.91:1 but the phone frame is square, which crops a landscape
                composition hard. <picture> swaps the file, it does not just re-crop. {%- endcomment -%}
            <picture>
              {%- if block.settings.image_mobile -%}
                <source media="(max-width: 900px)"
                        srcset="{{ block.settings.image_mobile | image_url: width: 500 }} 500w, {{ block.settings.image_mobile | image_url: width: 800 }} 800w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w"
                        sizes="100vw">
              {%- endif -%}
              {%- assign hero_desktop = block.settings.image | default: block.settings.image_mobile -%}
              {{ hero_desktop | image_url: width: 1760 | image_tag:
                   widths: '600,900,1200,1500,1760',
                   sizes: '(max-width: 900px) 100vw, 62vw',
                   alt: block.settings.title,
                   loading: slide_loading,
                   fetchpriority: slide_priority,
                   preload: is_first_slide,
                   class: 'hero-img-el',
                   style: hero_style }}
            </picture>
          {%- elsif block.settings.image_asset != blank -%}
            {%- comment -%} Theme assets get the same mobile swap as picked images. Without
                this the onboarding path could never have separate mobile art, and every
                slide is on the onboarding path until the merchant uploads. {%- endcomment -%}
            <picture>
              {%- if block.settings.image_mobile_asset != blank -%}
                <source media="(max-width: 900px)" srcset="{{ block.settings.image_mobile_asset | asset_url }}">
              {%- endif -%}
              <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.title | escape }}"
                   width="1760" height="920" loading="{{ slide_loading }}" fetchpriority="{{ slide_priority }}"
                   class="hero-img-el" style="{{ hero_style }}">
            </picture>
          {%- else -%}
            {%- render 'image-placeholder', w: 1600, h: 1000, label: 'Hero slide', note: 'Transparent cut-out on no ground, shown whole at every width.' -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
    <div style="display:none;" aria-hidden="true">
      {%- for block in section.blocks -%}
        <button data-slide-dot tabindex="-1"></button>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
#hero-{{ section.id }} [data-slide] { display: contents; }
/* Vertical panning stays with the browser; horizontal is ours to interpret. */
#hero-{{ section.id }} { touch-action: pan-y; }
{% endstyle %}

<script>
(() => {
  const root = document.getElementById('hero-{{ section.id }}');
  if (!root) return;
  const panes = root.querySelectorAll('[data-slide]');

  /* One path for every way of changing slide, so the dots can never disagree with
     the pane on show. */
  let internal = false;   /* true only while select() is clicking the master dot */
  const select = i => {
    const master = root.querySelectorAll('[data-slide-dot]')[i];
    /* theme.js switches the visible pane and stops autoplay */
    if (master) { internal = true; master.click(); internal = false; }
    panes.forEach(pane => {
      pane.querySelectorAll('[data-dot-proxy]').forEach((d, j) => {
        d.style.opacity = j === i ? '1' : '.45'; // ink comes from --c-on-primary in the markup
        d.style.width = j === i ? '22px' : '8px';
      });
    });
  };

  root.addEventListener('click', e => {
    const btn = e.target.closest('[data-dot-proxy]');
    if (!btn) return;
    select(parseInt(btn.dataset.dotProxy, 10));
  });

  /* Swipe, for touch. Horizontal only: a vertical drag has to keep scrolling the
     page, so the gesture is claimed only once it is clearly sideways. Nothing calls
     preventDefault and every listener is passive, so scrolling is never blocked
     while we decide. */
  if (panes.length > 1) {
    const shown = () => [...panes].findIndex(p => p.style.display !== 'none');
    let x0 = null, y0 = 0, sideways = false, swipedAt = 0;

    root.addEventListener('touchstart', e => {
      if (e.touches.length !== 1) { x0 = null; return; }   /* pinch-zoom is not a swipe */
      x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; sideways = false;
    }, { passive: true });

    root.addEventListener('touchmove', e => {
      if (x0 === null) return;
      const dx = e.touches[0].clientX - x0, dy = e.touches[0].clientY - y0;
      if (Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) sideways = true;
    }, { passive: true });

    root.addEventListener('touchend', e => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      x0 = null;
      if (!sideways || Math.abs(dx) < 45) return;          /* a tap or a scroll, not a swipe */
      swipedAt = Date.now();
      const i = shown();
      select(((dx < 0 ? i + 1 : i - 1) + panes.length) % panes.length);
    }, { passive: true });

    /* A swipe that started on the SHOP button must change slide, not follow the link.
       Guarded on `internal` so it never swallows select()'s own dot click, which is
       dispatched inside root and would otherwise be stopped before theme.js sees it. */
    root.addEventListener('click', e => {
      if (internal) return;
      if (Date.now() - swipedAt < 400) { e.preventDefault(); e.stopPropagation(); }
    }, true);
  }
})();
</script>

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Auto-rotate slides every (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Live text above the title, e.g. Special offer. Blank by default. Never bake a starburst or price flash into the artwork."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Slide heading"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Subtext",
          "default": "One line on what this slide is for."
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Transparent PNG or WebP cut-out, 1600 x 1000, no ground, no shadow, no text. Shown whole at every width, never cropped."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Optional and normally unnecessary: the cut-out is shown whole on a phone too. Only for a photographic slide with its own portrait crop."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fallback theme asset (onboarding only)",
          "info": "Filename of a theme asset used until an image is picked."
        },
        {
          "type": "text",
          "id": "image_mobile_asset",
          "label": "Fallback mobile theme asset (onboarding only)",
          "info": "Filename of a theme asset used below 900px. Only for a photographic slide; a cut-out needs none."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "title": "Feel Your Best",
            "subtext": "Top vitamins & supplements to support your everyday health and energy.",
            "cta": "SHOP VITAMINS",
            "link": "/collections/vitamins",
            "image_asset": "banner-vitamins.jpg"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Summer Travel Shop",
            "subtext": "Travel essentials made easy. Everything you need for your next trip, all in one place.",
            "cta": "SHOP TRAVEL",
            "link": "/collections/medicines-health",
            "image_asset": "hero-summer-travel.jpg"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Skincare",
            "subtext": "Dermatologist-loved brands to keep your skin glowing all year round.",
            "cta": "SHOP SKINCARE",
            "link": "/collections/skincare",
            "image_asset": "slide-skincare.jpg"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Mother & Baby",
            "subtext": "Trusted essentials for every stage — from bump to little one.",
            "cta": "SHOP BABY",
            "link": "/collections/mother-baby",
            "image_asset": "slide-baby.jpg"
          }
