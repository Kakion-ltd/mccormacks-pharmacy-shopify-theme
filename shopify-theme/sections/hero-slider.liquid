{%- comment -%} Onboarding fallback path only: slide 1 is the LCP element, but a
    theme asset has no image object, so image_tag's preload: argument is not
    available and the link has to be written by hand. theme-check flags this as
    AssetPreload — expected here, and it stops applying the moment a real image
    is picked in the editor. {%- endcomment -%}
{%- assign first_slide = section.blocks.first -%}
{%- if first_slide and first_slide.settings.image == blank and first_slide.settings.image_mobile == blank and first_slide.settings.image_asset != blank -%}
  {%- comment -%} Scoped by media once a mobile crop exists: an unqualified preload would
      pull the 1760px desktop file onto every phone, which then fetches the mobile one
      as well — two downloads to render one LCP element. {%- endcomment -%}
  {%- if first_slide.settings.image_mobile_asset != blank -%}
    <link rel="preload" as="image" href="{{ first_slide.settings.image_asset | asset_url }}" media="(min-width: 901px)" fetchpriority="high">
    <link rel="preload" as="image" href="{{ first_slide.settings.image_mobile_asset | asset_url }}" media="(max-width: 900px)" fetchpriority="high">
  {%- else -%}
    <link rel="preload" as="image" href="{{ first_slide.settings.image_asset | asset_url }}" fetchpriority="high">
  {%- endif -%}
{%- endif -%}

<section class="hero-wrapper" style="max-width:1440px; margin:0 auto; padding:12px 30px 8px;">
  <div id="hero-{{ section.id }}" data-slider {% if section.settings.autoplay_seconds > 0 %}data-slider-auto="{{ section.settings.autoplay_seconds | times: 1000 }}"{% endif %} class="hero-flex" style="position:relative; display:flex; flex-wrap:nowrap; border-radius:12px; overflow:hidden; box-shadow:0 12px 30px rgba(32,69,65,.08); background:#E6F2D5; min-height:460px;">
    {%- for block in section.blocks -%}
      {%- assign p = forloop.index0 -%}
      <div data-slide class="{% if block.settings.title contains 'Vitamins' %}slide--vitamins{% endif %}" {{ block.shopify_attributes }} style="position:absolute; inset:0; width:100%; height:100%; {% unless forloop.first %}display:none;{% endunless %}">
        
        {%- comment -%} The Canva Visual Layer {%- endcomment -%}
        <div class="hero-art" style="position:absolute; inset:0; width:100%; height:100%; z-index:1;">
          {%- liquid
            assign is_first_slide = forloop.first
            if is_first_slide
              assign slide_loading = 'eager'
              assign slide_priority = 'high'
            else
              assign slide_loading = 'lazy'
              assign slide_priority = 'auto'
            endif
          -%}
          {%- assign hero_style = 'position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;' -%}
          {%- if block.settings.image or block.settings.image_mobile -%}
            <picture>
              {%- if block.settings.image_mobile -%}
                <source media="(max-width: 900px)"
                        srcset="{{ block.settings.image_mobile | image_url: width: 600 }} 600w, {{ block.settings.image_mobile | image_url: width: 900 }} 900w, {{ block.settings.image_mobile | image_url: width: 1200 }} 1200w"
                        sizes="100vw">
              {%- endif -%}
              {%- assign hero_desktop = block.settings.image | default: block.settings.image_mobile -%}
              {{ hero_desktop | image_url: width: 1920 | image_tag:
                   widths: '800,1200,1600,1920',
                   sizes: '100vw',
                   alt: block.settings.title,
                   loading: slide_loading,
                   fetchpriority: slide_priority,
                   preload: is_first_slide,
                   class: 'hero-img-el',
                   style: hero_style }}
            </picture>
          {%- elsif block.settings.image_asset != blank -%}
            <picture>
              {%- if block.settings.image_mobile_asset != blank -%}
                <source media="(max-width: 900px)" srcset="{{ block.settings.image_mobile_asset | asset_url }}">
              {%- endif -%}
              <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.title | escape }}"
                   width="1920" height="720" loading="{{ slide_loading }}" fetchpriority="{{ slide_priority }}"
                   class="hero-img-el" style="{{ hero_style }}">
            </picture>
          {%- else -%}
            {%- render 'image-placeholder', w: 1920, h: 720, label: 'Canva Banner (Desktop)', note: 'Full bleed background image. Mobile: 1080x1080.' -%}
          {%- endif -%}
        </div>

        {%- comment -%} The Content Overlay Layer {%- endcomment -%}
        <div class="hero-copy-wrapper" style="position:relative; z-index:2; width:100%; height:100%; display:flex; align-items:center;">
          <div class="hero-copy" style="position:relative; flex:0 0 auto; max-width:580px; display:flex; flex-direction:column; justify-content:center; padding:clamp(32px,4.5vw,64px);">
            {%- if block.settings.badge != blank -%}
            <span class="hero-badge" style="align-self:flex-start; background:var(--c-dark); color:#ffffff; font-weight:800; font-size:11px; letter-spacing:.08em; text-transform:uppercase; padding:6px 12px; border-radius:6px; margin-bottom:16px;">{{ block.settings.badge }}</span>
            {%- endif -%}
            {% if forloop.first %}<h1 class="hero-title {% if block.settings.title contains 'Vitamins' %}hero-title--vitamins{% endif %}">{{ block.settings.title }}</h1>{% else %}<h2 class="hero-title {% if block.settings.title contains 'Vitamins' %}hero-title--vitamins{% endif %}">{{ block.settings.title }}</h2>{% endif %}
            <p class="hero-subtext {% if block.settings.title contains 'Vitamins' %}hero-subtext--vitamins{% endif %}">{{ block.settings.subtext }}</p>
            <a href="{{ block.settings.link }}" class="slide-cta hero-cta btn btn-fill {% if block.settings.title contains 'Vitamins' %}hero-cta--vitamins{% endif %}" style="align-self:flex-start; letter-spacing:.03em; gap:10px; border-radius:8px; border:1px solid rgba(0,0,0,0.1);">{{ block.settings.cta }}<svg class="cta-arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s ease;"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="8 7 17 7 17 16"></polyline></svg></a>
            
            <div class="hero-controls" style="display:flex; align-items:center; gap:22px; margin-top:clamp(30px,4vw,48px);">

              <div class="hero-dots" style="display:flex; gap:8px;">
                {%- for b in section.blocks -%}
                  {%- assign j = forloop.index0 -%}
                  <button aria-label="Go to slide {{ forloop.index }}" data-dot-proxy="{{ j }}" style="width:{% if j == p %}22{% else %}8{% endif %}px; height:6px; border-radius:4px; border:none; cursor:pointer; padding:0; background:#fff; opacity:{% if j == p %}1{% else %}.3{% endif %}; transition:all .3s ease;"></button>
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
    <div style="display:none;" aria-hidden="true">
      {%- for block in section.blocks -%}
        <button data-slide-dot tabindex="-1"></button>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
/* Vertical panning stays with the browser; horizontal is ours to interpret. */
#hero-{{ section.id }} { touch-action: pan-y; }

#hero-{{ section.id }} .hero-title {
  font-family: var(--font-heading);
  font-weight: 800;
  color: #1a1a1a;
  font-size: clamp(26px,6vw,56px);
  line-height: 1.05;
  margin: 0 0 16px;
  letter-spacing: -.02em;
}
#hero-{{ section.id }} .hero-subtext {
  color: #4a4a4a;
  font-size: clamp(14px,3.5vw,19px);
  font-weight: 500;
  line-height: 1.5;
  margin: 0 0 clamp(22px,3vw,34px);
  max-width: 460px;
}
#hero-{{ section.id }} .hero-title--vitamins {
  color: #ffffff;
}
#hero-{{ section.id }} .hero-subtext--vitamins {
  color: #eef0eb;
}
#hero-{{ section.id }} .hero-cta--vitamins {
  background: var(--c-dark) !important;
  color: #fff !important;
  border-color: var(--c-dark) !important;
}
#hero-{{ section.id }} .hero-cta--vitamins:hover {
  background: var(--c-accent) !important;
  color: #1a1a1a !important;
  border-color: var(--c-accent) !important;
}

@media (max-width: 900px) {
  #hero-{{ section.id }} .hero-copy-wrapper {
    align-items: flex-end !important;
  }
  #hero-{{ section.id }} .hero-copy {
    width: 100%;
    padding: 32px 22px !important;
  }
  #hero-{{ section.id }} { aspect-ratio: 4 / 5 !important; min-height: auto !important; }
  #hero-{{ section.id }} .hero-cta {
    padding: 12px 20px !important;
    font-size: 13px !important;
  }
  #hero-{{ section.id }} .hero-title {
    font-size: 28px !important;
    margin-bottom: 12px !important;
  }
  #hero-{{ section.id }} .hero-subtext {
    font-size: 15px !important;
    margin-bottom: 12px !important;
  }
  #hero-{{ section.id }} .hero-controls {
    margin-top: 16px !important;
  }
  #hero-{{ section.id }} .hero-copy {
    padding: 16px 20px 24px !important;
  }
  #hero-{{ section.id }} .slide--vitamins .hero-img-el {
    object-position: center top !important;
  }
  #hero-{{ section.id }} .hero-cta--vitamins {
    background: var(--c-accent) !important;
    color: var(--c-on-accent) !important;
    border-color: var(--c-accent) !important;
  }
}
{% endstyle %}

<script>
(() => {
  const root = document.getElementById('hero-{{ section.id }}');
  if (!root) return;
  const panes = root.querySelectorAll('[data-slide]');

  /* One path for every way of changing slide, so the dots can never disagree with
     the pane on show. */
  let internal = false;   /* true only while select() is clicking the master dot */
  const select = i => {
    const master = root.querySelectorAll('[data-slide-dot]')[i];
    /* theme.js switches the visible pane and stops autoplay */
    if (master) { internal = true; master.click(); internal = false; }
    panes.forEach(pane => {
      pane.querySelectorAll('[data-dot-proxy]').forEach((d, j) => {
        d.style.opacity = j === i ? '1' : '.3';
        d.style.width = j === i ? '22px' : '8px';
      });
    });
  };

  root.addEventListener('click', e => {
    const btn = e.target.closest('[data-dot-proxy]');
    if (!btn) return;
    select(parseInt(btn.dataset.dotProxy, 10));
  });

  /* Swipe, for touch. Horizontal only: a vertical drag has to keep scrolling the
     page, so the gesture is claimed only once it is clearly sideways. Nothing calls
     preventDefault and every listener is passive, so scrolling is never blocked
     while we decide. */
  if (panes.length > 1) {
    const shown = () => [...panes].findIndex(p => p.style.display !== 'none');
    let x0 = null, y0 = 0, sideways = false, swipedAt = 0;

    root.addEventListener('touchstart', e => {
      if (e.touches.length !== 1) { x0 = null; return; }   /* pinch-zoom is not a swipe */
      x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; sideways = false;
    }, { passive: true });

    root.addEventListener('touchmove', e => {
      if (x0 === null) return;
      const dx = e.touches[0].clientX - x0, dy = e.touches[0].clientY - y0;
      if (Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) sideways = true;
    }, { passive: true });

    root.addEventListener('touchend', e => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      x0 = null;
      if (!sideways || Math.abs(dx) < 45) return;          /* a tap or a scroll, not a swipe */
      swipedAt = Date.now();
      const i = shown();
      select(((dx < 0 ? i + 1 : i - 1) + panes.length) % panes.length);
    }, { passive: true });

    /* A swipe that started on the SHOP button must change slide, not follow the link.
       Guarded on `internal` so it never swallows select()'s own dot click, which is
       dispatched inside root and would otherwise be stopped before theme.js sees it. */
    root.addEventListener('click', e => {
      if (internal) return;
      if (Date.now() - swipedAt < 400) { e.preventDefault(); e.stopPropagation(); }
    }, true);
  }
})();
</script>

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Auto-rotate slides every (seconds, 0 = off)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Live text above the title, e.g. Seasonal Essential. Blank by default."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Slide heading"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Subtext",
          "default": "One line on what this slide is for."
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Canva Banner (Desktop)",
          "info": "Upload a full-bleed banner. Recommended size: 1920x720."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Canva Banner (Mobile)",
          "info": "Recommended size: 1080x1080."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fallback theme asset (onboarding only)",
          "info": "Filename of a theme asset used until an image is picked."
        },
        {
          "type": "text",
          "id": "image_mobile_asset",
          "label": "Fallback mobile theme asset (onboarding only)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "title": "Back To School",
            "subtext": "Support focus, immunity, and daily wellness for the new school term.",
            "cta": "SHOP BACK TO SCHOOL",
            "link": "/collections/medicines-health",
            "badge": "Seasonal Essential",
            "image_asset": "hero-back-to-school.jpg",
            "image_mobile_asset": "hero-back-to-school-mobile.jpg"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Cold & Flu",
            "subtext": "Decongestants, soothing remedies, and trusted clinical relief for the whole family.",
            "cta": "SHOP COLD & FLU",
            "link": "/collections/medicines-health",
            "badge": "Fast Relief",
            "image_asset": "hero-cold-flu.jpg",
            "image_mobile_asset": "hero-cold-flu-mobile.jpg"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Vitamins & Supplements",
            "subtext": "Premium vitamins, minerals, and Irish health brands to boost everyday energy and immunity.",
            "cta": "SHOP VITAMINS",
            "link": "/collections/vitamins",
            "badge": "Daily Wellness",
            "image_asset": "hero-vitamins.jpg",
            "image_mobile_asset": "hero-vitamins-mobile.jpg"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Special Offers",
            "subtext": "Explore our latest promotional savings, value bundles, and special pharmacy deals.",
            "cta": "SHOP SPECIAL OFFERS",
            "link": "/collections/sale",
            "badge": "Limited Time",
            "image_asset": "hero-special-offers.jpg",
            "image_mobile_asset": "hero-special-offers-mobile.jpg"
          }
        }
      ]
    }
  ]
}
