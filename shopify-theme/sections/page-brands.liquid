  </div>
  <div class="pgrid2" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(226px,1fr)); gap:20px;">
    {%- assign demo = 'Hydrating Cleanser for Normal to Dry Skin, 236ml~€13.50~4.9 (640);Foaming Cleanser for Normal to Oily Skin, 236ml~€13.50~4.8 (412);Moisturising Lotion for Dry Skin, 473ml~€18.95~4.9 (388);SA Smoothing Cleanser for Rough Skin, 236ml~€14.95~4.7 (164);Baby Wash & Shampoo, 236ml~€11.50~4.9 (210);Eye Repair Cream, 14ml~€15.50~4.6 (96);AM Facial Moisturising Lotion SPF25, 52ml~€16.95~4.8 (271);Retinol Serum for Post-Blemish Marks, 30ml~€21.50~4.5 (118)' | split: ';' -%}
    {%- for item in demo -%}
