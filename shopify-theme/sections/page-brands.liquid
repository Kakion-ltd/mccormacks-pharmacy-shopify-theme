        <div style="padding:0 18px 18px; display:flex; flex-direction:column; gap:9px; flex:1;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:#82C914;">CeraVe</div>
          <a href="/collections/cerave" class="hov-green" style="font-weight:700; font-size:15px; line-height:1.45; color:#2A2B2A; flex:1;">{{ f[0] }}</a>
          <div style="display:flex; align-items:center; gap:7px; font-size:12.5px; color:#6b7065;">
            {{ stars }}
            <span>{{ f[2] }}</span>
          </div>
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:20px; color:#2A2B2A;">{{ f[1] }}</div>
          <a href="/collections/cerave" class="hov-bg-green-dk" style="display:flex; align-items:center; justify-content:center; height:46px; border-radius:9px; background:#82C914; color:#ffffff; font-weight:800; font-size:14.5px; margin-top:2px;">Add To Bag</a>
