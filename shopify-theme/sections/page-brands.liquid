      <div class="brand-pcard">
        <a href="/collections/cerave" style="display:block; padding:18px;">
          <span style="display:block; width:100%; aspect-ratio:1/1; overflow:hidden;">
            <img src="{{ 'prod-cerave-cleanser.jpg' | asset_url }}" alt="{{ f[0] | escape }}" style="width:100%; height:100%; object-fit:contain; display:block;" width="600" height="600">
          </span>
