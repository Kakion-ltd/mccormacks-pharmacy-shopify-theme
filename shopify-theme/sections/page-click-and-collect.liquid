{% render 'trust-row' %}

<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
  <div class="legal-wrap" style="display:flex; gap:56px; align-items:flex-start;">

    {% render 'legal-sidebar', active: 'click-and-collect', updated_date: section.settings.updated_date, show_help: section.settings.show_help_card, phone: section.settings.help_phone %}

    <div style="flex:1; min-width:0; max-width:820px;">
      <div>
      <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#717769; margin:0 0 14px;">
        <a href="{{ routes.root_url }}" class="hov-green" style="color:#717769;">Home</a><span>/</span><span>Shipping &amp; Delivery</span><span>/</span><span style="color:#3a3d39; font-weight:700;">Click &amp; Collect</span>
      </nav>
      <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(30px,3.4vw,42px); line-height:1.08; margin:0 0 14px;">{{ section.settings.heading }}</h1>
      <p style="margin:0 0 28px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ section.settings.intro }}</p>
      <div style="height:1px; background:#e6e7e4;"></div><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">How it works</h2>
      <div style="display:flex; flex-direction:column; gap:20px; margin:0 0 12px;">
        <div style="display:flex; gap:16px; align-items:flex-start;">
          <span style="flex:0 0 auto; width:34px; height:34px; border-radius:999px; background:var(--c-primary); color:var(--c-on-primary); font-weight:800; font-size:15px; display:flex; align-items:center; justify-content:center;">1</span>
          <div style="padding-top:3px;">
            <div style="font-weight:800; font-size:16px; margin-bottom:5px;">Choose Click &amp; Collect at checkout</div>
            <div style="font-size:15px; line-height:1.7; color:#3a3d39;">Select the store you would like to collect from. There is no delivery charge on Click &amp; Collect orders.</div>
          </div>
        </div>
        <div style="display:flex; gap:16px; align-items:flex-start;">
          <span style="flex:0 0 auto; width:34px; height:34px; border-radius:999px; background:var(--c-primary); color:var(--c-on-primary); font-weight:800; font-size:15px; display:flex; align-items:center; justify-content:center;">2</span>
          <div style="padding-top:3px;">
            <div style="font-weight:800; font-size:16px; margin-bottom:5px;">Wait to be notified</div>
            <div style="font-size:15px; line-height:1.7; color:#3a3d39;">For in-store Click &amp; Collect services you will be notified via email or SMS as to when your order is ready for collection in your selected store.</div>
          </div>
        </div>
        <div style="display:flex; gap:16px; align-items:flex-start;">
          <span style="flex:0 0 auto; width:34px; height:34px; border-radius:999px; background:var(--c-primary); color:var(--c-on-primary); font-weight:800; font-size:15px; display:flex; align-items:center; justify-content:center;">3</span>
          <div style="padding-top:3px;">
            <div style="font-weight:800; font-size:16px; margin-bottom:5px;">Collect in store</div>
            <div style="font-size:15px; line-height:1.7; color:#3a3d39;">Bring your collection notification with you to the store.</div>
          </div>
        </div>
      </div><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Weekly collection stores</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">Collection days for Click &amp; Collect for the following stores are on a weekly basis, arriving in store every Thursday. Please do allow up to a week.</p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:16px; margin:0 0 8px;">
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:22px 24px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:17px; color:var(--c-dark); margin-bottom:6px;">McCormack&rsquo;s Fairways</div>
          <div style="font-size:14px; line-height:1.6; color:#5d6159;">Stock arrives in store every <strong style="color:#3a3d39;">Thursday</strong> &mdash; please allow up to a week.</div>
        </div>
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:22px 24px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:17px; color:var(--c-dark); margin-bottom:6px;">McCormack&rsquo;s Lis Na Dara</div>
          <div style="font-size:14px; line-height:1.6; color:#5d6159;">Stock arrives in store every <strong style="color:#3a3d39;">Thursday</strong> &mdash; please allow up to a week.</div>
        </div>
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:22px 24px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:17px; color:var(--c-dark); margin-bottom:6px;">McCormack&rsquo;s Newbridge</div>
          <div style="font-size:14px; line-height:1.6; color:#5d6159;">Stock arrives in store every <strong style="color:#3a3d39;">Thursday</strong> &mdash; please allow up to a week.</div>
        </div>
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:22px 24px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:17px; color:var(--c-dark); margin-bottom:6px;">McCormack&rsquo;s Tullamore</div>
          <div style="font-size:14px; line-height:1.6; color:#5d6159;">Stock arrives in store every <strong style="color:#3a3d39;">Thursday</strong> &mdash; please allow up to a week.</div>
        </div>
      </div><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Questions about your order</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">If you would like an update on your order, or have any other query relating to your online order, please don&rsquo;t hesitate to contact us on <a href="tel:0526199329">052 6199329</a> during working hours.</p>
      </div>

      {% render 'legal-question-card' %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Click & Collect page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Click & Collect" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Order online and collect free from your selected McCormack’s store. You will be notified by email or SMS as soon as your order is ready." },
    { "type": "text", "id": "updated_date", "label": "Last reviewed date", "default": "12 June 2026" },
    { "type": "checkbox", "id": "show_help_card", "label": "Show pharmacist help card", "default": true },
    { "type": "text", "id": "help_phone", "label": "Help phone number", "default": "052 6199329" }
  ],
  "presets": [{ "name": "Click & Collect page" }]
}
{% endschema %}
