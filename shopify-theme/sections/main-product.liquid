{%- comment -%}
  Main product section — generalized from "Product - fabU Skin Glow" design.
  The design's "Buy More, Save More" tier picker is promo/discount logic that can't
  be generalized to arbitrary products, so it is replaced by a quantity stepper.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if current_variant.compare_at_price > current_variant.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}
{%- assign ingredients_mf = product.metafields.custom.ingredients -%}
{%- assign how_to_use_mf = product.metafields.custom.how_to_use -%}

{%- comment -%} Related products: recommendations when performed, else first collection {%- endcomment -%}
{%- assign rel = blank -%}
{%- if recommendations.performed and recommendations.products_count > 0 -%}
  {%- assign rel = recommendations.products -%}
{%- elsif product.collections.first -%}
  {%- assign rel = collections[product.collections.first.handle].products -%}
{%- endif -%}

<div class="pdp-wrap-pad" style="width:100%; overflow-x:hidden; background:#ffffff;">

  <!-- Trust row -->
  <div class="trust-mob-wrap" style="width:100%; background:#ffffff;">
    <div class="trust-inner" style="max-width:1440px; margin:0 auto; padding:8px 50px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px 28px;">
      <div style="flex:1 1 230px; display:flex; align-items:center; justify-content:flex-start; gap:10px; font-size:14px;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="var(--c-accent)" style="flex:0 0 auto;"><path d="M3 5.75A1.75 1.75 0 0 1 4.75 4h8.5A1.75 1.75 0 0 1 15 5.75V6h2.6c.5 0 .96.24 1.25.64l2.4 3.3c.16.22.25.49.25.76V15a1.5 1.5 0 0 1-1.5 1.5h-.6a2.75 2.75 0 0 1-5.4 0H10.4a2.75 2.75 0 0 1-5.4 0h-.25A1.75 1.75 0 0 1 3 14.75V5.75ZM15 7.5v3.5h4v-.32L16.9 7.8a.5.5 0 0 0-.4-.2H15ZM7.7 15.75a1.25 1.25 0 1 0-2.5 0 1.25 1.25 0 0 0 2.5 0Zm9.6 0a1.25 1.25 0 1 0-2.5 0 1.25 1.25 0 0 0 2.5 0Z"></path></svg>
        <span><strong style="font-weight:800;">Free Delivery</strong> On orders over {% render 'free-delivery-amount' %}</span>
      </div>
      <div style="flex:1 1 230px; display:flex; align-items:center; justify-content:center; gap:10px; font-size:14px;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 21 20" height="22" width="23" style="flex:0 0 auto; display:block;">
<path fill="#009245" d="M16.5449 7.45142C16.8642 7.18488 18.0893 6.11557 18.3939 5.86094C18.7475 5.56538 18.8658 5.06547 18.6815 4.64521C18.2256 3.60684 17.7574 2.54951 17.3536 1.51504C17.0279 0.680464 16.3396 0.728944 16.0455 0.74957C15.3883 0.795822 14.7848 1.03177 14.2764 1.25382C14.3362 1.15424 14.3656 1.0383 14.3594 0.920517C14.351 0.76332 14.2796 0.616086 14.1615 0.512057L14.1566 0.507838C13.87 0.255441 13.6969 0.103089 13.439 0.0332805C13.1549 -0.0436377 12.911 0.0253504 12.6024 0.112699C12.2161 0.222002 10.8121 0.61464 10.6123 0.679722C10.3924 0.751328 10.1828 0.83141 10.0361 1.02224C9.67773 1.48856 9.33478 1.9571 8.97168 2.45318C8.85534 2.61209 8.73741 2.77324 8.61701 2.93696C8.3709 3.27154 8.54216 3.75001 8.945 3.85212C9.25161 3.92986 9.55433 4.00217 9.7977 4.06702C9.49374 4.39317 9.14325 4.71319 8.83366 5.09547C8.68475 5.27939 8.53072 5.36138 8.10417 5.2979L5.3173 4.81714C5.12971 4.78479 4.93802 4.84561 4.80336 4.98023L3.63142 6.15217C3.49923 6.28437 3.43805 6.47168 3.46673 6.65642C3.4954 6.84115 3.61052 7.00108 3.77659 7.08699L5.18963 7.81781C4.83899 8.04841 4.46737 8.25201 4.11305 8.54058C3.74354 8.84158 3.70893 9.3693 3.70713 9.52396C3.70217 9.95652 4.11735 10.2817 4.41373 10.3745C4.82293 10.5025 6.46314 10.9866 6.87391 11.1154C6.19113 11.3984 6.01027 11.7944 5.85866 12.2684C5.74884 12.6117 5.63532 12.9666 4.89251 13.4966C4.08551 14.0724 3.34399 14.7299 2.60313 15.3667C2.52664 15.4324 2.46843 15.5168 2.43409 15.6116C1.83367 17.2704 2.61762 19.1117 4.23169 19.8275L4.50714 19.9496C4.59683 19.9894 4.69508 20.0061 4.79305 19.998C8.90894 19.657 9.61324 18.9996 10.2943 18.3639C10.8146 17.8782 11.3526 17.376 14.8013 17.0644C15.3557 17.0143 15.7015 16.7266 15.8585 16.1848C16.0648 15.4728 16.2309 14.9611 16.3644 14.5499C16.8948 12.9161 16.8825 12.8015 16.5681 9.86593C16.5082 9.30672 16.4403 8.67289 16.3613 7.89523C16.3444 7.73007 16.4148 7.55998 16.5449 7.45142ZM15.7939 6.55172C15.3626 6.9117 15.1388 7.4583 15.1953 8.0138C15.2746 8.79458 15.3457 9.45786 15.4028 9.99078C15.7028 12.7922 15.7028 12.7922 15.2497 14.188C14.8508 15.4171 14.7512 15.8074 14.7217 15.8944C14.7141 15.8954 14.7055 15.8963 14.6958 15.8972C10.8469 16.2451 10.1594 16.8867 9.49464 17.5072C8.96699 17.9997 8.42184 18.5087 4.84493 18.8175L4.70676 18.7562C3.70537 18.3121 3.19136 17.1877 3.49122 16.1486C4.16134 15.5709 4.85415 14.9637 5.57317 14.4506C6.63288 13.6945 6.83871 13.0512 6.97485 12.6255C7.02622 12.4649 7.05528 12.3787 7.10322 12.3282C7.1549 12.2737 7.28592 12.19 7.61672 12.1005C8.00608 11.9952 8.20562 11.6554 8.33414 11.5324C8.57982 11.2973 8.57443 10.9024 8.32168 10.6741C8.18613 10.5517 7.98174 10.2421 7.61859 10.1232C7.07071 9.94398 6.51256 9.77924 5.97276 9.61994C5.65536 9.52626 5.32937 9.43005 5.00728 9.33141C5.28042 9.13413 5.6052 8.95244 5.91905 8.73993C6.33626 8.45741 6.53881 8.12607 6.52104 7.75519C6.48205 6.94202 5.45773 6.69661 5.02681 6.41414L5.41738 6.02357C8.11874 6.48953 7.91228 6.45406 7.92346 6.45574C8.42719 6.5318 9.16384 6.54993 9.74449 5.83289C10.0395 5.46854 10.4182 5.13407 10.7685 4.74174C11.1637 4.29906 11.1246 3.89744 11.0661 3.69743C11.0075 3.49679 10.8233 3.13615 10.2487 2.97524C10.1911 2.95911 10.1339 2.94356 10.0762 2.92832C10.3562 2.54623 10.6265 2.17941 10.9027 1.8181C11.0513 1.76455 11.4226 1.66071 11.9474 1.51399C12.1483 1.45781 12.3808 1.39277 12.6498 1.31702C12.4847 1.5291 12.3948 1.72056 12.4026 1.96135C12.4098 2.18332 12.5071 2.38314 12.6919 2.55529C12.9447 2.79089 13.2881 2.85363 13.7124 2.74183C14.3889 2.56361 15.3805 1.90713 16.2505 1.91366C16.2852 1.99186 16.0092 1.32843 17.568 5.0241C17.279 5.26728 16.1033 6.29343 15.7939 6.55172Z"></path>
</svg>
        <span><strong style="font-weight:800;">Irish Owned</strong> 7 stores nationwide</span>
      </div>
      <div style="flex:1 1 230px; display:flex; align-items:center; justify-content:center; gap:10px; font-size:14px;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="var(--c-accent)" style="flex:0 0 auto;"><path d="M11.48 3.5a.6.6 0 0 1 1.04 0l2.2 4.03a.6.6 0 0 0 .43.31l4.52.79a.6.6 0 0 1 .32.99l-3.17 3.33a.6.6 0 0 0-.16.5l.64 4.56a.6.6 0 0 1-.85.62l-4.13-1.97a.6.6 0 0 0-.52 0l-4.13 1.97a.6.6 0 0 1-.85-.62l.64-4.56a.6.6 0 0 0-.16-.5L4.97 9.62a.6.6 0 0 1 .32-.99l4.52-.79a.6.6 0 0 0 .43-.31l2.2-4.03Z"></path></svg>
        <span><strong style="font-weight:800;">Trusted</strong> by over 20,000 customers since 2010</span>
      </div>
    </div>
  </div>

  <!-- Breadcrumb -->
  <section style="max-width:1440px; margin:0 auto; padding:18px 30px 0;">
    <div style="font-size:13px; color:#717769; display:flex; flex-wrap:wrap; gap:7px; align-items:center;">
      <a href="{{ routes.root_url }}" class="hov-green" style="color:#717769;">Home</a><span>/</span>
      {%- if product.collections.first -%}
        <a href="{{ product.collections.first.url }}" class="hov-green" style="color:#717769;">{{ product.collections.first.title }}</a><span>/</span>
      {%- endif -%}
      <span style="color:#2A2B2A;">{{ product.title }}</span>
    </div>
  </section>

  <!-- Main PDP -->
  <section id="pdp-{{ section.id }}" style="max-width:1440px; margin:0 auto; padding:22px 30px 8px;">
    <div class="pdp-cols" style="display:flex; gap:44px; align-items:flex-start;">

      <!-- LEFT: gallery + tabs -->
      <div class="pdp-left" style="flex:1 1 58%; min-width:0;">
        <div class="gallery-flex" style="display:flex; gap:18px;">
          {%- if product.media.size > 1 -%}
          <!-- Thumb rail -->
          <div class="thumb-railbox" style="flex:0 0 auto; display:flex; flex-direction:column; align-items:center; gap:12px;">
            <button type="button" class="thumb-nav pdp-thumb-nav" data-thumb-scroll="-1" aria-label="Previous images" style="width:36px; height:36px; border-radius:999px; border:1.5px solid #d9dbd6; background:#fff; color:var(--c-primary-text); cursor:pointer; display:flex; align-items:center; justify-content:center;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 15 12 9 18 15"></polyline></svg></button>
            <div class="thumb-rail" data-thumb-rail style="display:flex; flex-direction:column; gap:12px; max-height:472px; overflow-y:auto; scrollbar-width:none;">
              {%- for media in product.media -%}
                <button type="button" class="thumb" data-pdp-thumb="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}" style="flex:0 0 auto; width:84px; height:84px; padding:6px; border-radius:9px; border:2px solid {% if forloop.first %}var(--c-primary){% else %}#e2e4df{% endif %}; background:#fff; cursor:pointer; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                  {%- capture thumb_alt %}{% render 'image-alt', image: media.preview_image, product: product %}{% endcapture -%}
                  {{ media.preview_image | image_url: width: 168 | image_tag: alt: thumb_alt, style: 'max-width:100%; max-height:100%; object-fit:contain; display:block;' }}
                </button>
              {%- endfor -%}
            </div>
            <button type="button" class="thumb-nav pdp-thumb-nav" data-thumb-scroll="1" aria-label="More images" style="width:36px; height:36px; border-radius:999px; border:1.5px solid #d9dbd6; background:#fff; color:var(--c-primary-text); cursor:pointer; display:flex; align-items:center; justify-content:center;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
          </div>
          {%- endif -%}
          <!-- Main image -->
          <div class="gallery-main" style="flex:1; min-width:0; position:relative; background:#f4f5f2; border-radius:14px; display:flex; align-items:center; justify-content:center; padding:28px; min-height:clamp(340px,42vw,560px);">
            {%- if on_sale -%}
              <span data-pdp-badge style="position:absolute; top:20px; right:20px; background:var(--c-primary); color:var(--c-on-primary); font-weight:800; font-size:12.5px; letter-spacing:.06em; padding:8px 14px; border-radius:6px;">SPECIAL OFFER</span>
            {%- endif -%}
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                {%- capture main_alt %}{% render 'image-alt', image: media.preview_image, product: product %}{% endcapture -%}
                <img src="{{ media.preview_image | image_url: width: 900 }}" alt="{{ main_alt | escape }}" data-pdp-img="{{ forloop.index0 }}" loading="lazy" style="max-width:78%; max-height:90%; object-fit:contain; display:block;{% unless forloop.first %} display:none;{% endunless %}" width="600" height="600">
              {%- endfor -%}
            {%- else -%}
              <div style="width:70%; aspect-ratio:1; border-radius:9px; background:repeating-linear-gradient(135deg,#dfe6d5,#dfe6d5 12px,#d7dfcb 12px,#d7dfcb 24px); display:flex; align-items:center; justify-content:center;"><span style="font-family:ui-monospace,monospace; font-size:11px; color:#5a7a2e; font-weight:700;">image</span></div>
            {%- endif -%}
          </div>
        </div>

        <!-- Description / Ingredients / How To Use tabs -->
        <div class="pdp-accordions" style="margin-top:34px;">
          <div style="display:flex; flex-wrap:wrap; gap:0 8px; border-bottom:1px solid #e6e7e4;">
            <button type="button" class="pdp-tab" data-view-btn="desc" data-active="true">Description</button>
            {%- if ingredients_mf != blank -%}
              <button type="button" class="pdp-tab" data-view-btn="ingredients">Ingredients</button>
            {%- endif -%}
            {%- if how_to_use_mf != blank -%}
              <button type="button" class="pdp-tab" data-view-btn="how">How To Use</button>
            {%- endif -%}
          </div>
          <div data-view="desc" style="padding:22px 4px 26px; font-size:15.5px; line-height:1.7; color:#4a4d47;">{{ product.description }}</div>
          {%- if ingredients_mf != blank -%}
            <div data-view="ingredients" style="display:none; padding:22px 4px 26px; font-size:15.5px; line-height:1.7; color:#4a4d47;">{{ ingredients_mf | metafield_tag }}</div>
          {%- endif -%}
          {%- if how_to_use_mf != blank -%}
            <div data-view="how" style="display:none; padding:22px 4px 26px; font-size:15.5px; line-height:1.7; color:#4a4d47;">{{ how_to_use_mf | metafield_tag }}</div>
          {%- endif -%}
        </div>

        {%- comment -%} Renders nothing at all until the FAQ metafield holds content.
            Below the tabs rather than inside them: the answers have to stay in the
            DOM to be eligible for the rich result. {%- endcomment -%}
        {% render 'product-faq', product: product %}
      </div>

      <!-- RIGHT: info + you may also like -->
      <div class="pdp-right" style="flex:0 0 400px; width:400px;">
        {%- if on_sale -%}
          <div style="display:inline-flex; align-items:center; gap:8px; background:var(--c-accent); color:var(--c-on-accent); font-weight:700; font-size:13.5px; padding:9px 20px; border-radius:8px; margin-bottom:18px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v9H4v-9"></path><rect x="2" y="7" width="20" height="5" rx="1"></rect><path d="M12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
            Special Offer
          </div>
        {%- endif -%}
        {%- if product.vendor != blank -%}
          <div style="font-size:14px; font-weight:700; color:var(--c-primary-text); margin-bottom:8px;"><a href="{{ product.vendor | url_for_vendor }}" class="hov-green-dk" style="color:var(--c-primary-text);">{{ product.vendor }}</a></div>
        {%- endif -%}
        <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(26px,2.8vw,34px); line-height:1.12; margin:0 0 10px;">{{ product.title }}</h1>
        {%- if current_variant.sku != blank -%}
          <div data-pdp-sku style="font-size:14px; color:#727969; margin-bottom:10px;">SKU {{ current_variant.sku }}</div>
        {%- endif -%}
        <div style="margin-bottom:18px;">{% render 'product-rating', product: product, size: 16, count_label: 'long', link: '#product-reviews' %}</div>
        <div style="display:flex; align-items:baseline; gap:14px; margin-bottom:12px;">
          <span data-pdp-price style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; color:var(--c-primary-text); font-weight:800; font-size:clamp(28px,3vw,38px);">{{ current_variant.price | money }}</span>
          <span data-pdp-compare style="font-weight:600; font-size:clamp(17px,1.8vw,22px); color:#727969; text-decoration:line-through; {% unless on_sale %}display:none;{% endunless %}">{{ current_variant.compare_at_price | money }}</span>
        </div>
        <div data-pdp-stock style="display:flex; align-items:center; gap:8px; font-size:14px; font-weight:700; margin-bottom:24px; color:{% if current_variant.available %}#58821D{% else %}#B3261E{% endif %};">
          <span style="width:9px; height:9px; border-radius:999px; background:currentColor;"></span>
          {% if current_variant.available %}In stock — ready to ship{% else %}Out of stock{% endif %}
        </div>

        {% form 'product', product, data-ajax-add: 'true' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div style="margin-bottom:16px;">
                <label for="Opt-{{ section.id }}-{{ forloop.index0 }}" style="display:block; font-size:13.5px; font-weight:700; color:#2A2B2A; margin-bottom:8px;">{{ option.name }}</label>
                <select id="Opt-{{ section.id }}-{{ forloop.index0 }}" data-opt-index="{{ forloop.index0 }}" style="width:100%; height:52px; border:1.5px solid #dfe1dc; border-radius:11px; padding:0 14px; font-family:inherit; font-size:15px; color:#2A2B2A; background:#fff; cursor:pointer;">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          {%- endunless -%}
          <div class="pdp-addbag" style="display:flex; gap:12px; align-items:stretch; margin-bottom:18px;">
            <div style="flex:0 0 auto; display:flex; align-items:center; border:1.5px solid #dfe1dc; border-radius:12px; overflow:hidden;">
              <button type="button" data-qty-step="-1" aria-label="Decrease quantity" style="width:46px; height:100%; border:none; background:#fff; color:#2A2B2A; font-size:22px; cursor:pointer; display:flex; align-items:center; justify-content:center;">−</button>
              <input type="text" name="quantity" value="1" inputmode="numeric" data-pdp-qty aria-label="Quantity" style="width:44px; border:none; text-align:center; font-weight:700; font-size:16px; color:var(--c-primary-text); outline:none; background:#fff;">
              <button type="button" data-qty-step="1" aria-label="Increase quantity" style="width:46px; height:100%; border:none; background:#fff; color:#2A2B2A; font-size:22px; cursor:pointer; display:flex; align-items:center; justify-content:center;">+</button>
            </div>
            <button type="submit" data-pdp-submit class="hov-bg-accent-dk" {% unless current_variant.available %}disabled{% endunless %} style="flex:1; display:flex; align-items:center; justify-content:center; gap:11px; background:var(--c-accent); color:var(--c-on-accent); border:none; cursor:pointer; font-family:inherit; font-weight:800; letter-spacing:.06em; font-size:16px; height:60px; border-radius:12px; {% unless current_variant.available %}opacity:.55; cursor:default;{% endunless %}">
              {%- if current_variant.available %}ADD TO BAG{% else %}OUT OF STOCK{% endif -%}
            </button>
          </div>
          {% render 'wishlist-button', product: product, style: 'text' %}
          {%- comment -%} Shopify's accelerated checkout button (Shop Pay / Apple Pay / …).
              Skips the cart entirely for a shopper who just wants this one item. Behind a
              setting because it can cannibalise cart-based upsell — switch it off in the
              editor rather than editing code. Renders nothing in the mock preview. {%- endcomment -%}
          {%- if section.settings.show_dynamic_checkout and current_variant.available -%}
            <div class="pdp-express" style="margin-top:12px;">
              {{ form | payment_button }}
            </div>
          {%- endif -%}
        {% endform %}
        {%- comment -%} Outside the product form deliberately: a contact form cannot be
            nested inside another form, and this is the one case where the buy box has
            nothing to sell. {%- endcomment -%}
        {%- unless current_variant.available -%}
          {% render 'back-in-stock', product: product, variant: current_variant %}
        {%- endunless -%}
        <div style="display:flex; align-items:center; gap:10px; font-size:15px; color:#2A2B2A; margin-bottom:34px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--c-accent)" style="flex:0 0 auto;"><path d="M3 5.75A1.75 1.75 0 0 1 4.75 4h8.5A1.75 1.75 0 0 1 15 5.75V6h2.6c.5 0 .96.24 1.25.64l2.4 3.3c.16.22.25.49.25.76V15a1.5 1.5 0 0 1-1.5 1.5h-.6a2.75 2.75 0 0 1-5.4 0H10.4a2.75 2.75 0 0 1-5.4 0h-.25A1.75 1.75 0 0 1 3 14.75V5.75ZM15 7.5v3.5h4v-.32L16.9 7.8a.5.5 0 0 0-.4-.2H15ZM7.7 15.75a1.25 1.25 0 1 0-2.5 0 1.25 1.25 0 0 0 2.5 0Zm9.6 0a1.25 1.25 0 1 0-2.5 0 1.25 1.25 0 0 0 2.5 0Z"></path></svg>
          <span><strong style="font-weight:800;">Free delivery</strong> on orders over {% render 'free-delivery-amount' %}</span>
        </div>
        {%- comment -%} Dispatch, collection and pharmacist reassurance, where the
            decision is actually being made. Was footer-only. {%- endcomment -%}
        <div style="margin:-22px 0 32px;">
          {% render 'buy-assurance', variant: current_variant %}
        </div>

        {%- if rel != blank and rel.size > 0 -%}
        <!-- You may also like -->
        <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:24px; margin:0 0 20px;">You May Also Like</h2>
        <div style="display:flex; flex-direction:column; gap:6px;">
          {%- assign shown = 0 -%}
          {%- for p in rel -%}
            {%- if p.id == product.id or shown >= 3 -%}{%- continue -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            <div style="display:flex; align-items:center; gap:16px; padding:14px 0; border-bottom:1px solid #eceee9;">
              <a href="{{ p.url }}" style="flex:0 0 92px; height:92px; border-radius:10px; background:#f4f5f2; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                {%- if p.featured_image -%}
                  {%- capture rel_alt %}{% render 'image-alt', image: p.featured_image, product: p %}{% endcapture -%}
                  {{ p.featured_image | image_url: width: 184 | image_tag: alt: rel_alt, style: 'max-width:84%; max-height:84%; object-fit:contain; display:block;', loading: 'lazy' }}
                {%- else -%}
                  <div style="width:80%; height:80%; border-radius:7px; background:repeating-linear-gradient(135deg,#dfe6d5,#dfe6d5 12px,#d7dfcb 12px,#d7dfcb 24px);"></div>
                {%- endif -%}
              </a>
              <div style="flex:1; min-width:0;">
                <h3 style="font-weight:700; font-size:15px; line-height:1.3; margin:0 0 6px;"><a href="{{ p.url }}" class="hov-green" style="color:#2A2B2A;">{{ p.title }}</a></h3>
                <div style="margin-bottom:6px;">{% render 'product-rating', product: p, size: 13, count_label: 'long' %}</div>
                <div style="color:var(--c-primary-text); font-weight:800; font-size:17px;">{{ p.price | money }}</div>
              </div>
              {%- capture restricted -%}{%- render 'product-restricted', product: p -%}{%- endcapture -%}
              {%- if p.available and p.has_only_default_variant and restricted != 'true' -%}
                <button type="button" data-add-id="{{ p.first_available_variant.id }}" class="hov-bg-green" style="flex:0 0 auto; align-self:center; background:var(--c-accent); color:var(--c-on-accent); font-weight:700; font-size:14px; padding:10px 20px; border-radius:8px; border:none; font-family:inherit; cursor:pointer;">Add</button>
              {%- else -%}
                <a href="{{ p.url }}" class="hov-bg-green" style="flex:0 0 auto; align-self:center; background:var(--c-accent); color:var(--c-on-accent); font-weight:700; font-size:14px; padding:10px 20px; border-radius:8px;">View</a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%}
    Landing zone for the review app. Install the app, then in the theme editor
    add its block here — the star rating above links to this anchor. Empty
    until an app block is added, so nothing shows on a store without reviews.
  {%- endcomment -%}
  <section id="product-reviews" style="max-width:1440px; margin:0 auto; padding:0 30px; scroll-margin-top:130px;">
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div style="padding:44px 0 8px;">{% render block %}</div>
      {%- endif -%}
    {%- endfor -%}
  </section>

  {%- if rel != blank and rel.size > 0 -%}
  <!-- Have you checked -->
  <section style="max-width:1440px; margin:0 auto; padding:52px 30px 8px;">
    <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(24px,2.6vw,32px); margin:0 0 26px;">Have You Checked These Products Out?</h2>
    <div style="position:relative;">
      <div id="checked-track-{{ section.id }}" style="display:flex; gap:24px; overflow-x:auto; scroll-behavior:smooth; scrollbar-width:none; padding:4px;">
        {%- assign railshown = 0 -%}
        {%- for p in rel -%}
          {%- if p.id == product.id or railshown >= 8 -%}{%- continue -%}{%- endif -%}
          {%- assign railshown = railshown | plus: 1 -%}
          <div class="checked-card pcard" style="flex:0 0 300px; display:flex; flex-direction:column;">
            <a href="{{ p.url }}" class="pcard-img" style="position:relative; aspect-ratio:1; background:#f4f5f2; border-radius:12px; overflow:hidden; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
              {%- if p.featured_image -%}
                {%- capture rel_alt %}{% render 'image-alt', image: p.featured_image, product: p %}{% endcapture -%}
                  {{ p.featured_image | image_url: width: 600 | image_tag: alt: rel_alt, style: 'max-width:82%; max-height:82%; object-fit:contain; display:block;', loading: 'lazy' }}
              {%- else -%}
                <div style="width:70%; height:70%; border-radius:9px; background:repeating-linear-gradient(135deg,#dfe6d5,#dfe6d5 12px,#d7dfcb 12px,#d7dfcb 24px); display:flex; align-items:center; justify-content:center;"><span style="font-family:ui-monospace,monospace; font-size:11px; color:#5a7a2e; font-weight:700;">image</span></div>
              {%- endif -%}
            </a>
            <h3 style="font-weight:600; font-size:16px; line-height:1.35; margin:0 0 12px; min-height:44px;"><a href="{{ p.url }}" class="hov-green" style="color:#2A2B2A;">{{ p.title }}</a></h3>
            <div style="margin-bottom:14px; min-height:18px;">{% render 'product-rating', product: p, size: 14, count_label: 'long' %}</div>
            <div style="color:var(--c-primary-text); font-weight:800; font-size:22px; margin-bottom:16px;">{{ p.price | money }}</div>
            {%- capture restricted -%}{%- render 'product-restricted', product: p -%}{%- endcapture -%}
              {%- if p.available and p.has_only_default_variant and restricted != 'true' -%}
              <button type="button" data-add-id="{{ p.first_available_variant.id }}" class="hov-bg-green" style="margin-top:auto; text-align:center; background:var(--c-accent); color:var(--c-on-accent); font-weight:700; font-size:15px; padding:14px 16px; border-radius:9px; border:none; font-family:inherit; cursor:pointer;">Add To Bag</button>
            {%- else -%}
              <a href="{{ p.url }}" class="hov-bg-green" style="margin-top:auto; text-align:center; background:var(--c-accent); color:var(--c-on-accent); font-weight:700; font-size:15px; padding:14px 16px; border-radius:9px;">View</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <button aria-label="Scroll back" data-rail-btn data-rail-back data-rail-target="checked-track-{{ section.id }}" data-rail-by="-648" class="hov-bg-green-dk" style="position:absolute; left:-14px; top:38%; transform:translateY(-50%); width:46px; height:46px; border-radius:999px; border:none; background:var(--c-primary); color:var(--c-on-primary); cursor:pointer; display:none; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(0,0,0,.15);"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"></polyline></svg></button>
      <button aria-label="Scroll forward" data-rail-btn data-rail-target="checked-track-{{ section.id }}" data-rail-by="648" class="hov-bg-green-dk" style="position:absolute; right:-14px; top:38%; transform:translateY(-50%); width:46px; height:46px; border-radius:999px; border:none; background:var(--c-primary); color:var(--c-on-primary); cursor:pointer; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(0,0,0,.15);"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg></button>
    </div>
  </section>
  {%- endif -%}

  <!-- Mobile sticky add-to-bag bar -->
  <div class="mobile-buybar" style="display:none; position:fixed; left:0; right:0; bottom:0; z-index:150; background:#ffffff; border-top:1px solid #e6e7e4; box-shadow:0 -6px 20px rgba(0,0,0,.08); padding:12px 16px; gap:12px; align-items:stretch;">
    <div style="flex:0 0 auto; display:flex; align-items:center; border:1.5px solid #dfe1dc; border-radius:11px; overflow:hidden;">
      <button type="button" data-qty-step="-1" aria-label="Decrease quantity" style="width:46px; border:none; background:#fff; color:#2A2B2A; font-size:22px; cursor:pointer; display:flex; align-items:center; justify-content:center;">−</button>
      <span data-buybar-qty style="min-width:34px; text-align:center; font-weight:700; font-size:16px; color:var(--c-primary-text);">1</span>
      <button type="button" data-qty-step="1" aria-label="Increase quantity" style="width:46px; border:none; background:#fff; color:#2A2B2A; font-size:22px; cursor:pointer; display:flex; align-items:center; justify-content:center;">+</button>
    </div>
    <button type="button" data-add-id="{{ current_variant.id }}" data-add-qty="1" data-buybar-add class="hov-bg-accent-dk" style="flex:1; display:flex; align-items:center; justify-content:center; gap:10px; background:var(--c-accent); color:var(--c-on-accent); font-weight:800; letter-spacing:.05em; font-size:15px; border-radius:11px; border:none; font-family:inherit; cursor:pointer; {% unless current_variant.available %}opacity:.55; pointer-events:none;{% endunless %}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><path d="M3 6h18"></path><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      {%- if current_variant.available %}ADD TO BAG{% else %}OUT OF STOCK{% endif -%}
    </button>
  </div>

</div>

{% style %}
  .pcard:hover .pcard-img img { transform: scale(1.04); transition: transform .3s ease; }
  .pdp-thumb-nav:hover { border-color: var(--c-accent) !important; background: #f2f8e9 !important; }
  .pdp-tab {
    background: transparent; border: none; cursor: pointer; padding: 12px 14px 14px;
    font-family: 'Arial Rounded MT Bold', Arial, sans-serif; font-weight: 700; color: var(--c-dark);
    font-size: clamp(16px, 1.7vw, 20px); border-bottom: 3px solid transparent; margin-bottom: -1px;
  }
  .pdp-tab:hover { color:var(--c-primary-text); }
  .pdp-tab[data-active="true"] { color:var(--c-primary-text); border-bottom-color:var(--c-primary-text); }
  @media (max-width: 940px) {
    .pdp-cols { flex-direction: column !important; align-items: stretch !important; gap: 24px !important; }
    .pdp-left { display: contents !important; }
    .pdp-right { flex: 1 1 auto !important; width: 100% !important; order: 2 !important; }
    .gallery-flex { order: 1 !important; width: 100% !important; }
    .pdp-accordions { order: 3 !important; width: 100% !important; }
  }
  @media (max-width: 900px) {
    .mobile-buybar { display: flex !important; }
    body { padding-bottom: 82px; } /* keep footer content clear of the fixed buybar */
    .pdp-addbag { display: none !important; }
    .thumb-nav { display: none !important; }
    .thumb-railbox { width: 100% !important; }
    .gallery-main { min-height: 320px !important; padding: 22px !important; }
    .pdp-wrap-pad { padding-bottom: 92px !important; }
    .gallery-flex { flex-direction: column-reverse !important; }
    .thumb-rail { flex-direction: row !important; width: 100% !important; overflow-x: auto !important; max-height: none !important; }
    .thumb-rail .thumb { flex: 0 0 74px !important; }
    .checked-card { flex: 0 0 78% !important; }
  }
{% endstyle %}

<script>
  (() => {
    const root = document.getElementById('pdp-{{ section.id }}');
    if (!root) return;

    // Gallery: thumb click swaps main image
    const mains = [...document.querySelectorAll('[data-pdp-img]')];
    const thumbs = [...root.querySelectorAll('[data-pdp-thumb]')];
    const showImg = i => {
      mains.forEach(img => { img.style.display = img.dataset.pdpImg == i ? 'block' : 'none'; });
      thumbs.forEach(t => { t.style.borderColor = t.dataset.pdpThumb == i ? '#82C914' : '#e2e4df'; });
    };
    if (mains.length > 1) showImg(0);
    thumbs.forEach(t => t.addEventListener('click', () => showImg(t.dataset.pdpThumb)));
    root.querySelectorAll('[data-thumb-scroll]').forEach(btn => {
      btn.addEventListener('click', () => {
        const rail = root.querySelector('[data-thumb-rail]');
        if (rail) rail.scrollBy({ top: 96 * btn.dataset.thumbScroll, left: 86 * btn.dataset.thumbScroll, behavior: 'smooth' });
      });
    });

    // Quantity stepper (main form + mobile buybar stay in sync)
    const qtyInput = root.querySelector('[data-pdp-qty]');
    const buybarQty = document.querySelector('[data-buybar-qty]');
    const buybarAdd = document.querySelector('[data-buybar-add]');
    document.querySelectorAll('[data-qty-step]').forEach(btn => {
      btn.addEventListener('click', () => {
        const q = Math.max(1, (parseInt(qtyInput.value, 10) || 1) + parseInt(btn.dataset.qtyStep, 10));
        qtyInput.value = q;
        if (buybarQty) buybarQty.textContent = q;
        if (buybarAdd) buybarAdd.dataset.addQty = q;
      });
    });

    // Variant selects -> hidden id + price/sku/stock
    const sels = [...root.querySelectorAll('[data-opt-index]')];
    if (!sels.length) return;
    const variants = JSON.parse(document.getElementById('pdp-variants-{{ section.id }}').textContent);
    const sym = {{ cart.currency.symbol | json }};
    const fmt = c => sym + (c / 100).toFixed(2);
    sels.forEach(sel => sel.addEventListener('change', () => {
      const opts = sels.map(s => s.value);
      const v = variants.find(v => opts.every((o, i) => v.options[i] === o));
      const submit = root.querySelector('[data-pdp-submit]');
      if (!v) { if (submit) { submit.disabled = true; submit.textContent = 'UNAVAILABLE'; } return; }
      root.querySelector('input[name="id"]').value = v.id;
      const priceEl = root.querySelector('[data-pdp-price]');
      if (priceEl) priceEl.textContent = fmt(v.price);
      const cmpEl = root.querySelector('[data-pdp-compare]');
      if (cmpEl) {
        const onSale = v.compare_at_price && v.compare_at_price > v.price;
        cmpEl.style.display = onSale ? '' : 'none';
        if (onSale) cmpEl.textContent = fmt(v.compare_at_price);
      }
      const skuEl = root.querySelector('[data-pdp-sku]');
      if (skuEl && v.sku) skuEl.textContent = 'SKU ' + v.sku;
      if (submit) { submit.disabled = !v.available; submit.style.opacity = v.available ? '' : '.55'; submit.textContent = v.available ? 'ADD TO BAG' : 'OUT OF STOCK'; }
      if (buybarAdd) buybarAdd.dataset.addId = v.id;
      const stockEl = root.querySelector('[data-pdp-stock]');
      if (stockEl) {
        stockEl.style.color = v.available ? '#58821D' : '#B3261E';
        stockEl.lastChild.textContent = v.available ? 'In stock — ready to ship' : 'Out of stock';
      }
    }));
  })();
</script>
{%- unless product.has_only_default_variant -%}
  <script type="application/json" id="pdp-variants-{{ section.id }}">{{ product.variants | json }}</script>
{%- endunless -%}

