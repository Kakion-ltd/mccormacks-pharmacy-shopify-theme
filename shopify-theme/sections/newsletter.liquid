{%- comment -%}
  Standalone newsletter signup. Not used by any template out of the box — the
  footer already carries the always-on signup; this one exists so a merchant
  can drop a signup band into a page or the homepage. Same customer form and
  visual idiom as the footer's (dark rounded band, white input pill).
{%- endcomment -%}
<section style="max-width:1440px; margin:0 auto; padding:20px 30px 44px;">
  <div style="position:relative; overflow:hidden; background:var(--c-dark); border-radius:18px; padding:clamp(26px,3.4vw,40px); display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:18px 48px;">
    <div style="position:absolute; top:-40%; right:8%; width:220px; height:220px; border-radius:999px; background:rgba(255,255,255,.05);"></div>
    <div style="flex:1 1 340px; position:relative;">
      {%- if section.settings.heading != blank -%}
      <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#ffffff; font-size:clamp(19px,1.9vw,24px); margin:0 0 4px; line-height:1.15;">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
      <p style="margin:0; color:rgba(255,255,255,.78); font-size:13.5px; line-height:1.4;">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
    <div style="flex:1 1 340px; max-width:400px; border-radius:9px; background:#ffffff; padding:3px; position:relative;">
    {% form 'customer', style: 'display:flex; gap:0;' %}
      {% if form.posted_successfully? %}
        <p style="margin:0; padding:10px 14px; color:#58821D; font-weight:700; font-size:13.5px;">Thanks — you're subscribed!</p>
      {% else %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" required aria-label="Email address" autocomplete="email" placeholder="Enter your email address" style="flex:1; min-width:0; border:none; outline:none; padding:10px 14px; font-family:inherit; font-size:13.5px; color:#2A2B2A; background:transparent;">
        <button type="submit" class="hov-bg-accent-dk" style="flex:0 0 auto; border:none; border-radius:7px; background:var(--c-accent); color:var(--c-on-accent); font-family:inherit; font-weight:700; font-size:13.5px; letter-spacing:.02em; padding:0 20px; cursor:pointer;">Subscribe</button>
      {% endif %}
    {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subtext", "label": "Subtext" }
  ],
  "presets": [{ "name": "Newsletter signup" }]
}
{% endschema %}
