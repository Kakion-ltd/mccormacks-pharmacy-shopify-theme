{%- comment -%} Simple on-brand collections list (no dedicated design; card style
    borrowed from Search Results "Popular categories"). {%- endcomment -%}

<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
  <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#717769; margin:0 0 16px;">
    <a href="{{ routes.root_url }}" class="hov-green" style="color:#717769;">Home</a><span>/</span><span style="color:#3a3d39; font-weight:700;">{{ section.settings.heading }}</span>
  </nav>
  <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(26px,3vw,36px); line-height:1.1; margin:0 0 26px;">{{ section.settings.heading }}</h1>

  {% paginate collections by 24 %}
  <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:18px;">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="colcard" style="display:block; border-radius:14px; overflow:hidden; border:1px solid #e6e7e4; background:#ffffff;">
        <span style="display:block; width:100%; aspect-ratio:4/3; overflow:hidden; background:#f4f5f2;">
          {%- if collection.featured_image -%}
            {%- capture col_alt %}{% render 'image-alt', image: collection.featured_image, collection: collection %}{% endcapture -%}
            {{ collection.featured_image | image_url: width: 600 | image_tag: alt: col_alt, loading: 'lazy', style: 'width:100%; height:100%; object-fit:cover; display:block;' }}
          {%- else -%}
            <span style="display:flex; width:100%; height:100%; background:repeating-linear-gradient(135deg,#dfe6d5,#dfe6d5 12px,#d7dfcb 12px,#d7dfcb 24px); align-items:center; justify-content:center;"><span style="font-family:ui-monospace,monospace; font-size:11px; color:#5a7a2e; font-weight:700;">image</span></span>
          {%- endif -%}
        </span>
        <span style="display:block; padding:15px 16px; font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:16px; color:var(--c-dark);">{{ collection.title }}</span>
      </a>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}
    <div style="display:flex; align-items:center; justify-content:center; gap:8px; padding:34px 0 0;">
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}" class="colcard-pg" style="display:inline-flex; align-items:center; justify-content:center; width:42px; height:42px; border-radius:9px; border:1px solid #dfe1dc; color:#3a3d39; font-weight:700; font-size:14.5px;">{{ part.title }}</a>
        {%- elsif part.title contains 'hellip' or part.title == '…' -%}
          <span style="display:inline-flex; align-items:center; justify-content:center; width:42px; height:42px; border-radius:9px; color:#717769; font-weight:700; font-size:14.5px;">{{ part.title }}</span>
        {%- else -%}
          <span style="display:inline-flex; align-items:center; justify-content:center; width:42px; height:42px; border-radius:9px; background:var(--c-primary); color:var(--c-on-primary); font-weight:800; font-size:14.5px;">{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="colcard-pg" style="display:inline-flex; align-items:center; justify-content:center; height:42px; padding:0 18px; border-radius:9px; border:1px solid #dfe1dc; color:#3a3d39; font-weight:700; font-size:14.5px;">Next</a>
      {%- endif -%}
    </div>
  {%- endif -%}
  {% endpaginate %}
</section>

{% style %}
  .colcard:hover { box-shadow: 0 12px 26px rgba(0,0,0,.08); }
  .colcard-pg:hover { border-color: var(--c-accent) !important; color: var(--c-dark) !important; }
{% endstyle %}

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "presets": [
    {
      "name": "Collections list"
    }
  ]
}
{% endschema %}
