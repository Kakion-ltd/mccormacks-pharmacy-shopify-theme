{%- comment -%}
  Generic image-with-text card. Not used by any template out of the box.
  Mirrors the collection banner idiom: rounded 18px card on #f4f5f2, copy one
  side, cover image the other (banner-image snippet, so the empty state shows
  the standard upload placeholder). Own class names — the .banner-* rules
  live inside main-collection's style block and are not shared.
{%- endcomment -%}
<section style="max-width:1440px; margin:0 auto; padding:34px 30px 8px;">
  <div class="iwt-flex" style="display:flex; flex-wrap:wrap;{% if section.settings.layout == 'image_first' %} flex-direction:row-reverse;{% endif %} border-radius:18px; overflow:hidden; background:#f4f5f2; min-height:clamp(180px,19vw,252px);">
    <div class="iwt-body" style="flex:1 1 380px; padding:clamp(22px,2.6vw,34px) clamp(22px,3vw,40px); display:flex; flex-direction:column; justify-content:center; gap:10px;">
      {%- if section.settings.heading != blank -%}
      <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(24px,2.6vw,34px); line-height:1.1; margin:0;">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
      <div class="iwt-copy" style="font-size:clamp(14.5px,1.15vw,16px); line-height:1.6; color:#3a3d39; max-width:560px;">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.cta != blank and section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="slide-cta hov-bg-green-dk" style="width:fit-content; background:var(--c-primary); color:var(--c-on-primary); font-weight:700; font-size:14px; padding:11px 26px; border-radius:9px; display:inline-flex; align-items:center; gap:9px; margin-top:8px;">{{ section.settings.cta }}<svg class="cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s ease;"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="8 7 17 7 17 16"></polyline></svg></a>
      {%- endif -%}
    </div>
    <div class="iwt-img" style="position:relative; flex:1 1 360px; background-color:#e9ede3; min-height:clamp(150px,17vw,252px); overflow:hidden;">
      {%- render 'banner-image', image: section.settings.image, alt: section.settings.heading, label: 'Section image', note: 'Landscape — keep the subject centred, edges get cropped.' -%}
    </div>
  </div>
</section>

{% style %}
.iwt-copy p { margin: 0 0 12px; }
.iwt-copy p:last-child { margin-bottom: 0; }
@media (max-width: 900px) {
  .iwt-flex { flex-direction: column !important; min-height: 0 !important; }
  .iwt-body { flex: 0 0 auto !important; }
  .iwt-img {
    flex: 0 0 auto !important;
    min-height: 0 !important;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 260px;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape, 1300×600px or larger. The subject stays centred; edges crop." },
    { "type": "select", "id": "layout", "label": "Image position", "options": [
      { "value": "image_second", "label": "Image on the right" },
      { "value": "image_first", "label": "Image on the left" }
    ], "default": "image_second" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "cta", "label": "Button label", "info": "Shown only when a link is set too." },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
