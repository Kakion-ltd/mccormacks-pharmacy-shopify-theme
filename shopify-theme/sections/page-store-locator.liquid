{% render 'trust-row' %}

{% style %}
  /* the rows carry an inline display:flex, which beats the UA [hidden] rule */
  .store-row[hidden] { display: none !important; }
  @media (max-width: 1100px) {
    .loc-wrap { align-items: stretch !important; flex-direction: column !important; gap: 28px !important; }
    .loc-side { flex: 1 1 auto !important; width: 100% !important; position: static !important; top: auto !important; }
    .store-row { gap: 12px !important; }
    .store-row > div:last-child { flex: 1 1 100% !important; flex-direction: row !important; }
    .store-row > div:last-child > a { flex: 1 1 0 !important; }
  }
  .loc-search:focus { border-color: #82C914; }
  .loc-btn-outline:hover { border-color: #92C83F !important; }
  .loc-store-link { font-family: 'Arial Rounded MT Bold', Arial, sans-serif; font-weight: 800; font-size: 18.5px; color: #3f6b4f; background: none; border: none; padding: 0; cursor: pointer; text-align: left; }
  .loc-store-link:hover { color: #82C914; }
  .loc-other-link { display: block; width: 100%; padding: 10px 0; border: none; border-bottom: 1px solid #eceee9; background: none; font-family: inherit; font-size: 14.5px; font-weight: 700; color: #3a3d39; cursor: pointer; text-align: left; }
  .loc-other-link:hover { color: #82C914; }
{% endstyle %}

<div data-view="locator">
  <section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
    <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 16px;">
      <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><span style="color:#3a3d39; font-weight:700;">Store Locator</span>
    </nav>
    <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(28px,3.2vw,42px); line-height:1.08; margin:0 0 12px;">{{ section.settings.heading }}</h1>
    <p style="margin:0 0 26px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ section.settings.intro }}</p>
    <div style="display:flex; flex-wrap:wrap; gap:10px; max-width:560px; margin:0 0 28px;">
      <input type="search" data-loc-search class="loc-search" placeholder="Town or Eircode" aria-controls="loc-results-{{ section.id }}" style="flex:1 1 240px; height:52px; border:1px solid #dfe1dc; border-radius:10px; padding:0 16px; font-family:inherit; font-size:15.5px; color:#2A2B2A; outline:none; min-width:0;">
      <button type="button" data-loc-submit class="hov-bg-green-dk" style="flex:0 0 auto; height:52px; padding:0 24px; border:none; border-radius:10px; background:#82C914; color:#ffffff; font-family:inherit; font-weight:800; font-size:15px; cursor:pointer;">Search</button>
      {%- comment -%} Only offered once stores carry coordinates — otherwise there is nothing to sort by. {%- endcomment -%}
      {%- assign has_coords = false -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.latitude != blank and block.settings.longitude != blank -%}{%- assign has_coords = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_coords -%}
        <button type="button" data-loc-nearme class="loc-btn-outline" style="flex:0 0 auto; display:inline-flex; align-items:center; gap:8px; height:52px; padding:0 18px; border-radius:10px; border:1.5px solid #cdd3c5; background:transparent; font-family:inherit; color:#3f6b4f; font-weight:700; font-size:14.5px; cursor:pointer;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path></svg>
          Use my location
        </button>
      {%- endif -%}
    </div>
    <div class="loc-wrap" style="display:flex; gap:40px; align-items:flex-start;">
      <div style="flex:1 1 auto; min-width:0;">
        <div id="loc-results-{{ section.id }}" data-loc-results style="border-top:1px solid #e6e7e4;">
          {%- for block in section.blocks -%}
            {%- capture haystack -%}{{ block.settings.name }} {{ block.settings.address }} {{ block.settings.badge }} {{ block.settings.eircode }}{%- endcapture -%}
            <div class="store-row" data-loc-text="{{ haystack | strip_newlines | downcase | escape }}"{% if block.settings.latitude != blank and block.settings.longitude != blank %} data-lat="{{ block.settings.latitude }}" data-lng="{{ block.settings.longitude }}"{% endif %} {{ block.shopify_attributes }} style="display:flex; flex-wrap:wrap; gap:18px 24px; align-items:flex-start; padding:22px 0; border-bottom:1px solid #e6e7e4;">
              <div style="flex:1 1 300px; min-width:0;">
                <div style="display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-bottom:7px;">
                  <button type="button" class="loc-store-link" data-view-btn="store-{{ forloop.index }}">{{ block.settings.name }}</button>
                  {%- if block.settings.badge != blank -%}
                    <span style="display:inline-flex; align-items:center; height:24px; padding:0 9px; border-radius:6px; background:#eef2e8; color:#3f6a17; font-size:11.5px; font-weight:800;">{{ block.settings.badge }}</span>
                  {%- endif -%}
                </div>
                <div style="font-size:14.5px; line-height:1.65; color:#3a3d39; margin-bottom:8px;">{{ block.settings.address }}</div>
                <a href="tel:{{ block.settings.phone | remove: ' ' }}" class="hov-green-dk" style="font-size:14.5px; font-weight:700; color:#82C914;">{{ block.settings.phone }}</a>
              </div>
              <div style="flex:0 1 240px; font-size:14px; line-height:1.7; color:#3a3d39;">
                {%- assign hour_lines = block.settings.hours | newline_to_br | split: '<br />' -%}
                {%- for line in hour_lines -%}
                  {%- assign parts = line | split: '|' -%}
                  <div style="display:flex; justify-content:space-between; gap:12px;"><span style="color:#6b7065;">{{ parts[0] | strip }}</span><span style="font-weight:700;">{{ parts[1] | strip }}</span></div>
                {%- endfor -%}
              </div>
              <div style="flex:0 0 auto; display:flex; flex-direction:column; gap:9px;">
                <button type="button" class="hov-bg-green-dk" data-view-btn="store-{{ forloop.index }}" style="display:inline-flex; align-items:center; justify-content:center; height:44px; padding:0 20px; border:none; cursor:pointer; font-family:inherit; border-radius:9px; background:#82C914; color:#ffffff; font-weight:800; font-size:14px;">Store details</button>
                <a href="https://www.google.com/maps/search/?api=1&amp;query={{ block.settings.address | url_encode }}" target="_blank" rel="noopener" class="loc-btn-outline" style="display:inline-flex; align-items:center; justify-content:center; height:44px; padding:0 20px; border-radius:9px; border:1.5px solid #cdd3c5; color:#3f6b4f; font-weight:700; font-size:14px;">Directions</a>
              </div>
            </div>
          {%- endfor -%}
          <p data-loc-empty hidden style="padding:26px 0; font-size:15px; color:#6b7065;">No stores match that search. Try a town name or Eircode, or <button type="button" data-loc-clear style="border:none; background:none; padding:0; font:inherit; color:#82C914; font-weight:700; cursor:pointer; text-decoration:underline;">show all stores</button>.</p>
        </div>
      </div>
      <aside class="loc-side" style="flex:0 0 400px; width:400px; position:sticky; top:20px;">
        {% render 'map-placeholder', height: 440 %}
        <div style="margin-top:16px; padding:20px 22px; border-radius:16px; background:#eef2e8;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:16.5px; color:#3f6b4f; margin-bottom:7px;">Bank holiday hours</div>
          <div style="font-size:14px; line-height:1.7; color:#3a3d39;">Opening hours change on bank holidays and over Christmas. Please phone your store to check before travelling.</div>
        </div>
      </aside>
    </div>
  </section>
</div>

{%- for block in section.blocks -%}
  <div data-view="store-{{ forloop.index }}" style="display:none">
    <section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
      <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 16px;">
        <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><button type="button" data-view-btn="locator" class="hov-green" style="background:none; border:none; padding:0; font-family:inherit; font-size:13px; color:#8b9182; cursor:pointer;">Store Locator</button><span>/</span><span style="color:#3a3d39; font-weight:700;">{{ block.settings.name }}</span>
      </nav>
      <div class="loc-wrap" style="display:flex; gap:44px; align-items:flex-start;">
        <div style="flex:1 1 auto; min-width:0; max-width:760px;">
          {%- if block.settings.badge != blank -%}
            <span style="display:inline-flex; align-items:center; height:26px; padding:0 11px; border-radius:6px; background:#eef2e8; color:#3f6a17; font-size:12px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; margin-bottom:14px;">{{ block.settings.badge }}</span>
          {%- endif -%}
          <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(28px,3.2vw,42px); line-height:1.08; margin:0 0 12px;">{{ block.settings.name }}</h2>
          <p style="margin:0 0 26px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ block.settings.address }}</p>
          <div style="display:flex; flex-wrap:wrap; gap:12px; margin:0 0 30px;">
            <a href="tel:{{ block.settings.phone | remove: ' ' }}" class="hov-bg-green-dk" style="display:inline-flex; align-items:center; justify-content:center; gap:9px; height:52px; padding:0 26px; border-radius:10px; background:#82C914; color:#ffffff; font-weight:800; font-size:15.5px;">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z"></path></svg>
              {{ block.settings.phone }}
            </a>
            {%- if block.settings.email != blank -%}
              <a href="mailto:{{ block.settings.email }}" class="loc-btn-outline" style="display:inline-flex; align-items:center; justify-content:center; gap:9px; height:52px; padding:0 26px; border-radius:10px; border:1.5px solid #cdd3c5; color:#3f6b4f; font-weight:700; font-size:15px;">Email this store</a>
            {%- endif -%}
            <a href="https://www.google.com/maps/search/?api=1&amp;query={{ block.settings.address | url_encode }}" target="_blank" rel="noopener" class="loc-btn-outline" style="display:inline-flex; align-items:center; justify-content:center; gap:9px; height:52px; padding:0 26px; border-radius:10px; border:1.5px solid #cdd3c5; color:#3f6b4f; font-weight:700; font-size:15px;">Get directions</a>
          </div>
          {%- if block.settings.image != blank -%}
            <div style="width:100%; height:300px; border-radius:16px; overflow:hidden; background:#f4f5f2; border:1px solid #e6e7e4;">
              {{ block.settings.image | image_url: width: 1520 | image_tag: style: 'width:100%; height:100%; object-fit:cover; display:block;', alt: block.settings.name | escape }}
            </div>
          {%- else -%}
            {% render 'map-placeholder', height: 300 %}
          {%- endif -%}
          <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,28px); margin:36px 0 16px;">Opening hours</h2>
          <div style="border-top:1px solid #e6e7e4; max-width:460px;">
            {%- assign hour_lines = block.settings.hours | newline_to_br | split: '<br />' -%}
            {%- for line in hour_lines -%}
              {%- assign parts = line | split: '|' -%}
              <div style="display:flex; justify-content:space-between; gap:16px; padding:14px 0; border-bottom:1px solid #eceee9; font-size:15.5px;"><span style="color:#3a3d39;">{{ parts[0] | strip }}</span><span style="font-weight:700; color:#2A2B2A;">{{ parts[1] | strip }}</span></div>
            {%- endfor -%}
          </div>
          <div style="font-size:13.5px; color:#6b7065; margin-top:12px;">Hours may differ on bank holidays &mdash; please phone ahead.</div>
          {%- if block.settings.services != blank -%}
            <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,28px); margin:36px 0 16px;">Services at this store</h2>
            <div style="display:flex; flex-wrap:wrap; gap:10px;">
              {%- assign svc_list = block.settings.services | split: ',' -%}
              {%- for svc in svc_list -%}
                <span style="display:inline-flex; align-items:center; height:36px; padding:0 16px; border-radius:999px; background:#f2f3f1; color:#3a3d39; font-size:14px; font-weight:700;">{{ svc | strip }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
          <div style="margin:30px 0 0; padding-top:22px; border-top:1px solid #e6e7e4;">
            <button type="button" data-view-btn="locator" class="hov-green-dk" style="display:inline-flex; align-items:center; gap:9px; font-weight:800; font-size:15px; color:#82C914; background:none; border:none; padding:0; font-family:inherit; cursor:pointer;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="11 6 5 12 11 18"></polyline></svg>
              All stores
            </button>
          </div>
        </div>
        <aside class="loc-side" style="flex:0 0 330px; width:330px; position:sticky; top:20px;">
          <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
            <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:18px; color:#3f6b4f; margin:0 0 14px;">Other stores</div>
            <div style="display:flex; flex-direction:column; gap:3px;">
              {%- assign current_index = forloop.index -%}
              {%- for other in section.blocks -%}
                {%- if forloop.index == current_index -%}{%- continue -%}{%- endif -%}
                <button type="button" class="loc-other-link" data-view-btn="store-{{ forloop.index }}">{{ other.settings.name }}</button>
              {%- endfor -%}
            </div></div>
        </aside>
      </div>
    </section>
  </div>
{%- endfor -%}

<script>
(() => {
  const root = document.currentScript.parentElement;

  /* Scroll to top when switching store views (matches the design's view-change behavior). */
  root.addEventListener('click', e => {
    if (e.target.closest('[data-view-btn]')) window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  const list = root.querySelector('[data-loc-results]');
  const input = root.querySelector('[data-loc-search]');
  if (!list || !input) return;
  const rows = [...list.querySelectorAll('.store-row')];
  const empty = list.querySelector('[data-loc-empty]');

  const filter = () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    rows.forEach(r => {
      const hit = !q || r.dataset.locText.includes(q);
      r.hidden = !hit;
      if (hit) shown++;
    });
    if (empty) empty.hidden = shown > 0;
  };

  input.addEventListener('input', filter);
  input.addEventListener('search', filter);          // native clear (×) on type=search
  input.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); filter(); } });
  root.querySelector('[data-loc-submit]')?.addEventListener('click', filter);
  root.querySelector('[data-loc-clear]')?.addEventListener('click', () => { input.value = ''; filter(); });

  /* Nearest-first ordering. Only rendered when every store has coordinates. */
  const near = root.querySelector('[data-loc-nearme]');
  near?.addEventListener('click', () => {
    if (!navigator.geolocation) return;
    const label = near.lastChild;
    const said = label.textContent;
    label.textContent = ' Locating…';
    near.disabled = true;
    navigator.geolocation.getCurrentPosition(pos => {
      const { latitude: la, longitude: lo } = pos.coords;
      // equirectangular approximation — plenty for ranking stores within one country
      const dist = r => {
        const dLat = (parseFloat(r.dataset.lat) - la) * Math.PI / 180;
        const dLng = (parseFloat(r.dataset.lng) - lo) * Math.PI / 180 * Math.cos(la * Math.PI / 180);
        return dLat * dLat + dLng * dLng;
      };
      rows.filter(r => r.dataset.lat).sort((a, b) => dist(a) - dist(b)).forEach(r => list.insertBefore(r, empty));
      input.value = '';
      filter();
      label.textContent = said;
      near.disabled = false;
    }, () => {
      label.textContent = said;
      near.disabled = false;
      alert('We could not get your location. Search by town or Eircode instead.');
    }, { timeout: 8000 });
  });
})();
</script>

{% schema %}
{
  "name": "Store Locator",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your nearest store" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Seven pharmacies across Tipperary, Limerick, Kildare, Offaly, Louth and Mayo. Search by town or Eircode to find opening hours, services and directions." }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        { "type": "text", "id": "name", "label": "Store name", "default": "Clonmel" },
        { "type": "text", "id": "badge", "label": "Badge (optional)" },
        { "type": "text", "id": "address", "label": "Address", "default": "23 Bolton Street, Clonmel, Co. Tipperary" },
        { "type": "text", "id": "phone", "label": "Phone", "default": "052 6199329" },
        { "type": "text", "id": "email", "label": "Email" },
        { "type": "textarea", "id": "hours", "label": "Opening hours (one per line, Label|Value)", "default": "Mon–Fri|9.00am – 6.00pm\nSaturday|9.00am – 6.00pm\nSunday & bank holidays|Closed" },
        { "type": "text", "id": "services", "label": "Services (comma separated)", "default": "Blood pressure screening, Ask our pharmacist, Prescription collection" },
        { "type": "image_picker", "id": "image", "label": "Store image (replaces map placeholder)" },
        { "type": "text", "id": "eircode", "label": "Eircode", "info": "Also used to match searches." },
        { "type": "text", "id": "latitude", "label": "Latitude", "info": "Optional. Fill in latitude and longitude on every store to enable the 'Use my location' button." },
        { "type": "text", "id": "longitude", "label": "Longitude" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store Locator",
      "blocks": [
        { "type": "store" }
      ]
    }
  ]
}
{% endschema %}
