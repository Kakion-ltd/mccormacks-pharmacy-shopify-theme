{% style %}
  .wfc-field {
    width: 100%; font: inherit; font-size: 15.5px; border: 1.5px solid #dfe1dc;
    border-radius: 8px; padding: 11px 13px; background: #ffffff;
  }
  .wfc-field.wfc-invalid { border-color: #B3261E !important; background: #FBEAE9 !important; }
  .wfc-confirm-row {
    display: flex; align-items: flex-start; gap: 10px; background: #ffffff;
    border-radius: 8px; padding: 14px 16px; border: 1.5px solid #dfe1dc;
  }
  .wfc-confirm-row.wfc-invalid { border-color: #B3261E; background: #FBEAE9; }
  [data-wfc-err] {
    display: none; align-items: center; gap: 6px; color: #B3261E;
    font-size: .87rem; font-weight: 600; margin-top: 6px;
  }
  [data-wfc-err].wfc-show { display: flex; }
  #wfc-alert { display: none; }
  #wfc-alert.wfc-show { display: block; }
  @media print {
    body * { visibility: hidden; }
    .wfc-print-area, .wfc-print-area * { visibility: visible; }
    .wfc-print-area { position: absolute; top: 0; left: 0; width: 100%; border: none !important; }
    .wfc-print-btn { display: none !important; }
  }
{% endstyle %}

<section style="max-width:1440px; margin:0 auto; padding:30px 30px 60px;">
  <div style="max-width:760px; margin:0 auto;">
  {%- render 'breadcrumb', current: 'Withdraw From Contract' -%}

  <h1 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(26px,3vw,38px); line-height:1.1; margin:0 0 14px;">Withdraw From Contract</h1>
  <p style="margin:0 0 20px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:62ch;">When you buy from us online, you can usually change your mind and cancel your order. Where that right applies, we want to make using it simple. This page explains how it works and gives you a form to tell us.</p>

  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(20px,2.2vw,25px); margin:38px 0 12px; border-top:1px solid #e6e7e4; padding-top:24px;">How to withdraw</h2>
  <p style="margin:0 0 12px; font-size:16px; line-height:1.75; color:#3a3d39;">Fill in the form below. You don&rsquo;t need an account or to log in. Have your order number to hand, along with the dates you ordered and received your goods.</p>
  <p style="margin:0; font-size:16px; line-height:1.75; color:#3a3d39;">If you&rsquo;d rather write to us, you can email us or use the model withdrawal form at the bottom of this page. Any clear statement that you want to withdraw from your order is enough.</p>

  <section id="withdrawal-form" style="background:#f6f8f2; border:1px solid #e6e7e4; border-radius:14px; padding:28px 24px; margin-top:36px;">
    <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(20px,2.2vw,25px); margin:0 0 20px;">Your withdrawal request</h2>

    {%- form 'contact', id: 'wfc-form' -%}
      <div aria-live="polite">
        <div id="wfc-alert" role="alert" style="background:#FBEAE9; border:1.5px solid #B3261E; color:#B3261E; border-radius:8px; padding:14px 16px; font-weight:700; font-size:14.5px; margin-bottom:18px;">Please check the form &mdash; some information is missing or incomplete.</div>
        {% render 'form-errors', form: form %}
        {%- if form.posted_successfully? -%}
          <div role="status" style="background:#EEF6E4; border:1.5px solid var(--c-success); color:var(--c-dark); border-radius:8px; padding:18px 20px; margin-bottom:18px;">
            <h3 style="margin:0 0 8px; color:var(--c-dark); font-size:17px;">Your withdrawal request has been received</h3>
            <p style="margin:0 0 8px; font-size:14.5px; line-height:1.6;">Thank you &mdash; your request was submitted at <strong id="wfc-success-time" style="font-family:ui-monospace,monospace;"></strong>. Your reference number is <strong id="wfc-success-ref" style="font-family:ui-monospace,monospace;"></strong>.</p>
            <p style="margin:0; font-size:14.5px;">Please keep this reference and quote it if you contact us about your withdrawal.</p>
          </div>
        {%- endif -%}
      </div>

      {%- unless form.posted_successfully? -%}
      <input type="hidden" name="contact[reference]" id="wfc-reference" value="">
      <fieldset style="border:none; padding:0; margin:0 0 26px;">
        <legend style="font-weight:800; font-size:16px; padding:0 0 14px; color:#2A2B2A; font-family:var(--font-heading);">Your details</legend>
        <div style="margin-bottom:16px;">
          <label for="wfc-full-name" style="display:block; font-weight:700; font-size:13.5px; margin-bottom:6px;">Full name</label>
          <input type="text" id="wfc-full-name" name="contact[name]" autocomplete="name" class="wfc-field" data-wfc="fullName">
          <span data-wfc-err="fullName">&#9888; Please enter your full name.</span>
        </div>
        <div style="margin-bottom:16px;">
          <label for="wfc-email" style="display:block; font-weight:700; font-size:13.5px; margin-bottom:6px;">Email address</label>
          <input type="email" id="wfc-email" name="contact[email]" autocomplete="email" class="wfc-field" data-wfc="email" value="{{ form.email }}">
          <span data-wfc-err="email">&#9888; Please enter a valid email address.</span>
        </div>
        <div>
          <label for="wfc-phone" style="display:block; font-weight:700; font-size:13.5px; margin-bottom:6px;">Phone number <span style="font-weight:400; color:#666b60;">(optional)</span></label>
          <input type="tel" id="wfc-phone" name="contact[phone]" autocomplete="tel" class="wfc-field">
        </div>
      </fieldset>

      <fieldset style="border:none; padding:0; margin:0 0 26px;">
        <legend style="font-weight:800; font-size:16px; padding:0 0 14px; color:#2A2B2A; font-family:var(--font-heading);">Order details</legend>
        <div style="margin-bottom:16px;">
          <label for="wfc-order-number" style="display:block; font-weight:700; font-size:13.5px; margin-bottom:6px;">Order number</label>
          <input type="text" id="wfc-order-number" name="contact[order_number]" class="wfc-field" data-wfc="orderNumber">
          <span data-wfc-err="orderNumber">&#9888; Please enter your order number.</span>
        </div>
        <div style="margin-bottom:16px;">
          <label for="wfc-order-date" style="display:block; font-weight:700; font-size:13.5px; margin-bottom:6px;">Order date</label>
          <input type="date" id="wfc-order-date" name="contact[order_date]" class="wfc-field" data-wfc="orderDate">
          <span data-wfc-err="orderDate">&#9888; Please enter the date you placed the order.</span>
        </div>
        <div>
          <label for="wfc-received-date" style="display:block; font-weight:700; font-size:13.5px; margin-bottom:6px;">Date order received</label>
          <input type="date" id="wfc-received-date" name="contact[received_date]" class="wfc-field" data-wfc="receivedDate">
          <span data-wfc-err="receivedDate">&#9888; Please enter the date you received the order.</span>
        </div>
      </fieldset>

      <fieldset style="border:none; padding:0; margin:0;">
        <legend style="font-weight:800; font-size:16px; padding:0 0 14px; color:#2A2B2A; font-family:var(--font-heading);">Withdrawal details</legend>
        <div style="margin-bottom:16px;">
          <label for="wfc-items" style="display:block; font-weight:700; font-size:13.5px; margin-bottom:4px;">Items being withdrawn</label>
          <p style="margin:0 0 6px; font-size:13px; color:#666b60;">List each product and quantity you wish to withdraw from.</p>
          <textarea id="wfc-items" name="contact[items]" rows="4" class="wfc-field" data-wfc="items" style="resize:vertical;"></textarea>
          <span data-wfc-err="items">&#9888; Please list the items you wish to withdraw.</span>
        </div>
        <div style="margin-bottom:16px;">
          <label for="wfc-reason" style="display:block; font-weight:700; font-size:13.5px; margin-bottom:6px;">Reason <span style="font-weight:400; color:#666b60;">(optional)</span></label>
          <textarea id="wfc-reason" name="contact[reason]" rows="3" class="wfc-field" style="resize:vertical;"></textarea>
        </div>
        <div>
          <div class="wfc-confirm-row" id="wfc-confirm-row">
            <input type="checkbox" id="wfc-confirm" name="contact[confirmation]" value="I confirm I wish to withdraw from the contract for the items listed above." data-wfc="confirm" style="width:20px; height:20px; margin:2px 0 0; accent-color:var(--c-primary-text);">
            <label for="wfc-confirm" style="font-weight:700; font-size:14.5px; margin:0;">I confirm I wish to withdraw from the contract for the items listed above.</label>
          </div>
          <span data-wfc-err="confirm">&#9888; Please confirm you wish to withdraw before submitting.</span>
        </div>
      </fieldset>

      <button type="submit" class="btn btn-fill" style="gap:8px; font:inherit; margin-top:22px">Submit withdrawal request</button>
      {%- endunless -%}
    {%- endform -%}
  </section>

  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(20px,2.2vw,25px); margin:38px 0 12px; border-top:1px solid #e6e7e4; padding-top:24px;">When you can withdraw</h2>
  <p style="margin:0; font-size:16px; line-height:1.75; color:#3a3d39;">You can withdraw within <strong>14 days</strong> of the day you, or someone you nominate, receive your order. You don&rsquo;t need to give a reason. Once you&rsquo;ve told us, you have a further <strong>14 days</strong> to send the goods back.</p>

  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(20px,2.2vw,25px); margin:38px 0 12px; border-top:1px solid #e6e7e4; padding-top:24px;">Goods you may not be able to return</h2>
  <p style="margin:0 0 10px; font-size:16px; line-height:1.7; color:#3a3d39;">The right to withdraw may not apply to some goods. These can include:</p>
  <ul style="margin:0 0 12px; padding-left:22px; font-size:16px; line-height:1.8; color:#3a3d39;">
    <li>sealed goods that are not suitable for return for health or hygiene reasons, once the seal has been broken after delivery</li>
    <li>items made to your specification or personalised for you</li>
    <li>goods that can go off or expire quickly</li>
    <li>certain healthcare and pharmacy products</li>
  </ul>
  <p style="margin:0 0 12px; font-size:16px; line-height:1.75; color:#3a3d39;">If you&rsquo;re not sure whether an item can be returned, please contact us before you open it.</p>
  <p style="margin:0; font-size:16px; line-height:1.75; color:#3a3d39;">None of this affects your statutory rights if goods are faulty, damaged or not as described.</p>

  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(20px,2.2vw,25px); margin:38px 0 12px; border-top:1px solid #e6e7e4; padding-top:24px;">Returning the goods</h2>
  <p style="margin:0 0 12px; font-size:16px; line-height:1.75; color:#3a3d39;">Please return goods unused, unopened, in their original packaging and in a condition we can resell, unless the item is faulty.</p>
  <p style="margin:0; font-size:16px; line-height:1.75; color:#3a3d39;">You pay the cost of return postage, unless the item is faulty or we sent you the wrong item. We recommend a tracked postal service, so you have proof that you sent it.</p>

  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(20px,2.2vw,25px); margin:38px 0 12px; border-top:1px solid #e6e7e4; padding-top:24px;">Refunds</h2>
  <p style="margin:0; font-size:16px; line-height:1.75; color:#3a3d39;">We refund you within 14 days of the day you tell us you&rsquo;re withdrawing, to the payment method you used for the order. We may wait to refund you until we have the goods back, or until you show us proof that you&rsquo;ve sent them, whichever happens first. In that case we refund you within 14 days of receiving the goods back.</p>

  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(20px,2.2vw,25px); margin:38px 0 12px; border-top:1px solid #e6e7e4; padding-top:24px;">Contact us</h2>
  <div style="background:#f6f8f2; border:1px solid #e6e7e4; border-radius:12px; padding:20px 22px;">
    <p style="margin:0 0 12px; font-size:15.5px;">If you have a question about withdrawing from an order, get in touch. Please quote your order number.</p>
    <p style="margin:0; font-size:15.5px; line-height:1.7;">Melfer Limited<br>23 Bolton Street, Clonmel, Co. Tipperary, E91 E0F1<br>Email: <a href="mailto:{{ settings.email }}" style="font-weight:700;">{{ settings.email }}</a><br>Phone: <a href="tel:{{ settings.phone | remove: ' ' }}" style="font-weight:700;">{{ settings.phone }}</a></p>
  </div>

  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(20px,2.2vw,25px); margin:38px 0 12px; border-top:1px solid #e6e7e4; padding-top:24px;">Model withdrawal form</h2>
  <p style="margin:0 0 16px; font-size:16px; line-height:1.7; color:#3a3d39;">You don&rsquo;t have to use this form. If you&rsquo;d like to, fill it in and email it to us, or print it and post it to the address shown.</p>
  <div class="wfc-print-area" style="border:1.5px solid #e6e7e4; border-radius:14px; padding:24px; background:#ffffff;">
    <h3 style="margin:0 0 10px; font-family:var(--font-heading); color:var(--c-dark); font-size:18px;">Notice of Withdrawal</h3>
    <p style="margin:0 0 20px; font-size:14.5px; line-height:1.6;">To: Melfer Limited, 23 Bolton Street, Clonmel, Co. Tipperary, E91 E0F1<br>PSI Internet Supply List No: 10001884<br>Email: {{ settings.email }} &nbsp;&middot;&nbsp; Phone: {{ settings.phone }}</p>
    <p style="margin:0 0 22px; border-bottom:1px solid #b9bdb3; padding-bottom:4px; font-size:14.5px;">I/We hereby give notice that I/We withdraw from my/our contract of sale for the following goods:</p>
    <p style="margin:0 0 22px; border-bottom:1px solid #b9bdb3; padding-bottom:4px;">&nbsp;</p>
    <p style="margin:0 0 22px; border-bottom:1px solid #b9bdb3; padding-bottom:4px; font-size:14.5px;">Ordered on:</p>
    <p style="margin:0 0 22px; border-bottom:1px solid #b9bdb3; padding-bottom:4px; font-size:14.5px;">Received on:</p>
    <p style="margin:0 0 22px; border-bottom:1px solid #b9bdb3; padding-bottom:4px; font-size:14.5px;">Name of consumer(s):</p>
    <p style="margin:0 0 22px; border-bottom:1px solid #b9bdb3; padding-bottom:4px; font-size:14.5px;">Address of consumer(s):</p>
    <p style="margin:0 0 22px; border-bottom:1px solid #b9bdb3; padding-bottom:4px; font-size:14.5px;">Signature of consumer(s) (only if this form is notified on paper):</p>
    <p style="margin:0; border-bottom:1px solid #b9bdb3; padding-bottom:4px; font-size:14.5px;">Date:</p>
    <button type="button" class="wfc-print-btn btn-sm btn-outline" onclick="window.print()" style="margin-top:18px; font:inherit">Print this form</button>
  </div>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('wfc-form');

    // Success panel (after Shopify redirect): fill ref + timestamp saved pre-submit.
    var refEl = document.getElementById('wfc-success-ref');
    if (refEl) {
      var timeEl = document.getElementById('wfc-success-time');
      refEl.textContent = sessionStorage.getItem('wfcRef') || 'WD-______';
      timeEl.textContent = sessionStorage.getItem('wfcTime') || new Date().toLocaleString('en-IE');
      return;
    }
    if (!form) return;

    var order = ['fullName', 'email', 'orderNumber', 'orderDate', 'receivedDate', 'items', 'confirm'];
    var field = function (k) { return form.querySelector('[data-wfc="' + k + '"]'); };
    var errEl = function (k) { return form.querySelector('[data-wfc-err="' + k + '"]'); };

    var setErr = function (k, bad) {
      var f = field(k);
      var box = k === 'confirm' ? document.getElementById('wfc-confirm-row') : f;
      box.classList.toggle('wfc-invalid', bad);
      errEl(k).classList.toggle('wfc-show', bad);
    };

    order.forEach(function (k) {
      field(k).addEventListener(k === 'confirm' ? 'change' : 'input', function () { setErr(k, false); });
    });

    form.addEventListener('submit', function (e) {
      var bad = [];
      order.forEach(function (k) {
        var f = field(k);
        var invalid = k === 'confirm' ? !f.checked
          : k === 'email' ? !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.value.trim())
          : !f.value.trim();
        setErr(k, invalid);
        if (invalid) bad.push(k);
      });
      var alertBox = document.getElementById('wfc-alert');
      if (bad.length) {
        e.preventDefault();
        alertBox.classList.add('wfc-show');
        field(bad[0]).focus();
        return;
      }
      alertBox.classList.remove('wfc-show');
      // Generate the reference client-side, include it in the POST, and stash it
      // for the success panel shown after Shopify redirects back.
      var ref = 'WD-' + Math.random().toString(36).slice(2, 8).toUpperCase();
      document.getElementById('wfc-reference').value = ref;
      sessionStorage.setItem('wfcRef', ref);
      sessionStorage.setItem('wfcTime', new Date().toLocaleString('en-IE'));
    });
  })();
</script>

{% schema %}
{
  "name": "Withdraw From Contract",
  "settings": [],
  "presets": [{ "name": "Withdraw From Contract" }]
}
{% endschema %}
