  </div>
</section>

<script>
  (function () {
    var state = { amount: '€50', method: 'By email', date: null, monthOff: 0 };

    var sync = function () {
      document.querySelectorAll('[data-gv-amount]').forEach(function (el) { el.textContent = state.amount; });
      document.querySelectorAll('[data-gv-method-label]').forEach(function (el) { el.textContent = state.method; });
      var label = document.getElementById('gv-date-label');
      if (state.date) {
        label.textContent = state.date.toLocaleDateString('en-IE', { weekday: 'short', day: 'numeric', month: 'long' });
        label.style.color = '#2A2B2A'; label.style.fontWeight = '700';
      } else {
        label.textContent = 'Send immediately';
        label.style.color = '#8b9182'; label.style.fontWeight = '600';
      }
      document.querySelectorAll('.gv-quick').forEach(function (chip) {
        var d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() + parseInt(chip.dataset.gvOffset, 10));
        chip.classList.toggle('gv-on', !!state.date && d.getTime() === state.date.getTime());
      });
      // these controls are buttons — keep the selected state exposed to assistive tech
      document.querySelectorAll('.gv-amt, .gv-method, .gv-quick').forEach(function (b) {
        b.setAttribute('aria-pressed', b.classList.contains('gv-on') ? 'true' : 'false');
      });
    };

    // Amount chips + custom amount
    document.querySelectorAll('[data-gv-pick]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        document.querySelectorAll('[data-gv-pick]').forEach(function (b) { b.classList.remove('gv-on'); });
        a.classList.add('gv-on');
        document.getElementById('gv-custom').value = '';
        state.amount = a.dataset.gvPick;
        sync();
      });
    });
    document.getElementById('gv-custom').addEventListener('input', function () {
      var v = parseInt(this.value, 10);
      if (isNaN(v)) return;
      v = Math.min(500, Math.max(10, v));
      document.querySelectorAll('[data-gv-pick]').forEach(function (b) { b.classList.remove('gv-on'); });
      state.amount = '€' + v;
      sync();
    });

    // Delivery method
    document.querySelectorAll('[data-gv-method]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        document.querySelectorAll('[data-gv-method]').forEach(function (b) { b.classList.remove('gv-on'); });
        a.classList.add('gv-on');
        state.method = a.dataset.gvMethod;
        sync();
      });
    });

    // Date picker
    var cal = document.getElementById('gv-cal');
    var toggleCal = function (e) {
      e.preventDefault();
      var open = cal.style.display !== 'none';
      cal.style.display = open ? 'none' : 'block';
      var field = document.getElementById('gv-date-field');
      field.style.borderColor = open ? '#dfe1dc' : '#82C914';
      field.setAttribute('aria-expanded', open ? 'false' : 'true');
      if (!open) renderCal();
    };
    document.getElementById('gv-date-field').addEventListener('click', toggleCal);
    document.getElementById('gv-done').addEventListener('click', toggleCal);
    document.getElementById('gv-clear').addEventListener('click', function (e) {
      e.preventDefault(); state.date = null; cal.style.display = 'none'; sync();
    });
    document.getElementById('gv-prev').addEventListener('click', function () {
      state.monthOff = Math.max(0, state.monthOff - 1); renderCal();
    });
    document.getElementById('gv-next').addEventListener('click', function () {
      state.monthOff = Math.min(12, state.monthOff + 1); renderCal();
    });
    document.querySelectorAll('.gv-quick').forEach(function (chip) {
      chip.addEventListener('click', function (e) {
        e.preventDefault();
        var d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() + parseInt(chip.dataset.gvOffset, 10));
        state.date = d; cal.style.display = 'none'; sync();
      });
    });

    function renderCal() {
      var today = new Date(); today.setHours(0, 0, 0, 0);
      var base = new Date(today.getFullYear(), today.getMonth() + state.monthOff, 1);
      document.getElementById('gv-month').textContent = base.toLocaleDateString('en-IE', { month: 'long', year: 'numeric' });
      var days = document.getElementById('gv-days');
      days.innerHTML = '';
      var lead = (base.getDay() + 6) % 7;
      for (var i = 0; i < lead; i++) {
        var blank = document.createElement('span');
        blank.className = 'gv-day gv-blank';
        days.appendChild(blank);
      }
      var total = new Date(base.getFullYear(), base.getMonth() + 1, 0).getDate();
      for (var d = 1; d <= total; d++) {
        var dt = new Date(base.getFullYear(), base.getMonth(), d);
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'gv-day' + (dt < today ? ' gv-past' : '') +
          (state.date && dt.getTime() === state.date.getTime() ? ' gv-sel' : '');
        btn.textContent = d;
        if (dt >= today) {
          btn.addEventListener('click', (function (picked) {
            return function () { state.date = picked; cal.style.display = 'none'; sync(); };
          })(dt));
        }
        days.appendChild(btn);
      }
    }

    sync();
  })();
</script>

