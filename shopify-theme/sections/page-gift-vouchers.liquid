{% style %}
  /* These are <button> elements — reset the UA styling anchors never had. */
  .gv-amt, .gv-method { font-family:inherit; cursor:pointer; -webkit-appearance:none; appearance:none; }
  .gv-method { width:100%; text-align:left; }
  /* The method-scoped fields each set their own display, which beats the UA sheet's
     [hidden]{display:none} — so "Send it to me" left the whole recipient block on
     screen. Same trap as .cd-empty[hidden] and five others in base.css; it has to be
     !important. The fields were already disabled, so nothing was ever posted that
     shouldn't be; they were just visible. setup/verify/gift-voucher.py checks it. */
  [data-gv-who][hidden], [data-gv-only][hidden], [data-gv-when][hidden] { display:none !important; }
  .gv-amt:focus-visible, .gv-method:focus-visible { outline:2px solid var(--c-dark); outline-offset:2px; }
  .gv-amt { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; height:92px; border-radius:14px; border:2px solid #e0e3dd; background:#ffffff; color:#3a3d39; }
  .gv-amt:hover { border-color: var(--c-accent) !important; }
  .gv-amt.gv-on { border-color:var(--c-primary-text); background:#eef2e8; color:var(--c-dark); }
  .gv-method { display:flex; align-items:flex-start; gap:14px; padding:18px 20px; border-radius:14px; border:2px solid #e0e3dd; background:#ffffff; }
  .gv-method.gv-on { border-color:var(--c-primary-text); background:#f7faf3; }
  .gv-method .gv-dot { flex:0 0 auto; width:20px; height:20px; margin-top:2px; border-radius:999px; border:2px solid #c2c6bd; background:#ffffff; }
  .gv-method.gv-on .gv-dot { border-color:var(--c-primary-text); background:var(--c-primary); }
  /* Native radios, so the group is a real radio group: arrow keys move between them,
     the label text is the hit area, and nothing here reimplements a control. */
  .gv-when { display:flex; align-items:center; gap:11px; font-size:15.5px; color:#2A2B2A; cursor:pointer; }
  .gv-when input { flex:0 0 auto; width:19px; height:19px; margin:0; accent-color:var(--c-primary); cursor:pointer; }
  .gv-input:focus { border-color:var(--c-primary-text) !important; }
  @media (max-width: 1000px) {
    .gv-wrap { flex-direction:column !important; gap:32px !important; }
    .gv-side { flex:1 1 auto !important; width:100% !important; position:static !important; }
  }
  @media (max-width: 620px) {
    .gv-amounts { grid-template-columns:repeat(3,minmax(0,1fr)) !important; gap:10px !important; }
    .gv-amounts > a { height:78px !important; }
    .gv-method { padding:15px 16px !important; }
    .gv-method-cost { display:none !important; }
    .gv-summary { padding:22px 20px !important; }
  }
{% endstyle %}

{%- comment -%}
  The amounts on this page are the gift card product's variants, not the section's
  blocks. Six blocks plus six variants is the defect this repo keeps relearning
  (MAINTENANCE.md, "one thing in two places, saying two things"), and here it fails
  as a button that takes money for a variant that does not exist. So: the buttons
  are drawn from `gv_product.variants`, and a block only decorates a variant it
  matches by amount — its tag and its preselected flag. A block matching nothing is
  skipped, and named in design mode so whoever added it finds out.

  A block is therefore only worth adding to decorate one. Four of the six said
  nothing — empty tag, not preselected — and deleting them changed no pixel, because
  a variant with no block already renders with a blank tag. Two remain, for €25
  ("Popular") and €50 ("Most gifted", preselected). Adding a block for a denomination
  you do not want to label achieves nothing.

  `gift-voucher` is the handle of the real Shopify gift card product. If it is
  missing or unpublished the buy panel is replaced by a notice: no product means no
  voucher can be issued, and a form that cannot work must not look like one.
{%- endcomment -%}
{%- liquid
  assign gv_product = all_products['gift-voucher']
  assign gv_count = gv_product.variants | size
  assign gv_sel = gv_product.variants | first
  for block in section.blocks
    if block.type == 'amount' and block.settings.preselected
      assign want = block.settings.amount | times: 100
      for v in gv_product.variants
        if v.price == want
          assign gv_sel = v
        endif
      endfor
    endif
  endfor
  assign gv_default = gv_sel.price | divided_by: 100
-%}
<!-- Gift voucher hero -->
<section style="max-width:1440px; margin:0 auto; padding:24px 30px 6px;">
  <div class="banner-flex" style="display:flex; flex-wrap:wrap; border-radius:18px; overflow:hidden; background:var(--c-dark); min-height:clamp(300px,30vw,400px);">
    <div style="flex:1 1 480px; padding:clamp(28px,4vw,56px); display:flex; flex-direction:column; justify-content:center; color:#ffffff;">
      <span style="display:inline-flex; align-self:flex-start; align-items:center; height:26px; padding:0 11px; border-radius:6px; background:var(--c-accent); color:var(--c-on-accent); font-size:12px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; margin-bottom:16px;">Valid 5 years</span>
      <h1 style="font-family:var(--font-heading); font-weight:800; font-size:clamp(34px,4.4vw,58px); line-height:1.02; letter-spacing:-.01em; margin:0 0 20px;">{{ section.settings.heading }}</h1>
      <p style="margin:0 0 10px; font-size:clamp(15px,1.3vw,17px); line-height:1.6; color:#d6e2cd; max-width:560px;">One voucher, the whole shop. Spend it on pharmacy, vitamins, skincare, beauty, fragrance, baby or toiletries &mdash; online at mccormackspharmacy.ie.</p>
      <p style="margin:0; font-size:clamp(15px,1.3vw,17px); line-height:1.6; color:#d6e2cd; max-width:560px;">Sent by email in minutes, or scheduled for the day you choose.</p>
    </div>
    <div class="banner-img" style="flex:1 1 380px; background:var(--c-dark); min-height:clamp(240px,26vw,400px); display:flex; align-items:center; justify-content:center; padding:clamp(24px,3vw,44px);">
      <div style="width:100%; max-width:340px; aspect-ratio:8/5; border-radius:14px; background:linear-gradient(140deg,var(--c-accent) 0%,var(--c-primary-hover) 100%); box-shadow:0 20px 44px rgba(0,0,0,.28); padding:clamp(18px,2.4vw,26px); display:flex; flex-direction:column; justify-content:space-between; color:#ffffff;">
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:12px;">
          {%- comment -%} The real logo, turned white by the filter: brightness(0) blackens every
              opaque pixel and invert(1) makes it white, so the transparent PNG keeps its shape
              and no second white file exists to drift from the original. Same URL as the
              header logo, so it is already cached. 150px wide, 450px requested for 3x screens;
              shrinks with the card below 375px (118px at 320). A logo uploaded in theme
              settings must stay a transparent PNG, or this renders as a white block.
              White on this card is a client decision (23 Sep 2026) that costs contrast:
              see setup/MAINTENANCE.md, "The gift voucher card is white on lime". {%- endcomment -%}
          {% # theme-check-disable RemoteAsset -%}
          <img src="{% render 'logo-src', width: 450 %}" alt="{{ shop.name | escape }}" width="150" height="38" style="flex:0 1 150px; min-width:0; width:150px; height:auto; display:block; filter:brightness(0) invert(1);">
          {%- # theme-check-enable RemoteAsset %}
          <span style="font-size:10.5px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; padding-top:3px;">Gift Voucher</span>
        </div>
        <div data-gv-amount style="font-family:var(--font-heading); font-weight:800; font-size:clamp(34px,4.6vw,46px); line-height:1;">&euro;{{ gv_default }}</div>
        <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:12px; font-size:11px; font-weight:700; letter-spacing:.04em; text-transform:uppercase;">
          <span>Valid 5 years</span>
          <span>Online only</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Buy a voucher -->
<section style="max-width:1440px; margin:0 auto; padding:38px 30px 8px;">
{%- if gv_count == 0 -%}
  <div style="max-width:620px; padding:22px 24px; border:1px solid #e6e7e4; border-radius:16px; background:#ffffff;">
    <div style="font-family:var(--font-heading); font-weight:800; font-size:18px; color:var(--c-dark); margin-bottom:8px;">Gift vouchers are not on sale online at the moment</div>
    <p style="margin:0 0 12px; font-size:15px; line-height:1.7; color:#3a3d39;">We&rsquo;re sorry &mdash; you can&rsquo;t buy a voucher on the website just now. Vouchers are available at the counter in any of our seven stores.</p>
    <a href="/pages/store-locator" class="hov-green-dk" style="font-weight:800; font-size:14.5px; color:var(--c-primary-text);">Find your nearest store &rarr;</a>
  </div>
  {%- if request.design_mode -%}
  <p style="margin:18px 0 0; padding:18px; border:1.5px dashed #cfd1cc; border-radius:12px; font-size:15px; color:#666b60;">
    <strong>No gift card product.</strong> This page buys the Shopify gift card product with the handle <strong>gift-voucher</strong>. Create it (Products &rsaquo; Gift cards) and publish it to the Online Store, with one denomination per amount below. Customers see the notice above, not this note.
  </p>
  {%- endif -%}
{%- else -%}
  <form action="{{ routes.cart_add_url }}" method="post" id="gv-form" data-ajax-add>
  <input type="hidden" name="id" id="gv-variant" value="{{ gv_sel.id }}">
  <input type="hidden" name="quantity" value="1">
  <div class="gv-wrap" style="display:flex; gap:44px; align-items:flex-start;">
    <div style="flex:1 1 auto; min-width:0;">

      <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(22px,2.4vw,30px); margin:0 0 6px;">1. Choose an amount</h2>
      <p style="margin:0 0 18px; font-size:15.5px; line-height:1.65; color:#5d6159;">Pick the amount you&rsquo;d like to give.</p>
      <div class="gv-amounts" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:14px; margin:0 0 18px;">
        {%- for v in gv_product.variants -%}
          {%- liquid
            assign amt = v.price | divided_by: 100
            assign vtag = ''
            for block in section.blocks
              if block.type == 'amount' and block.settings.amount == amt
                assign vtag = block.settings.tag
              endif
            endfor
          -%}
          <button type="button" class="gv-amt{% if v.id == gv_sel.id %} gv-on{% endif %}" aria-pressed="{% if v.id == gv_sel.id %}true{% else %}false{% endif %}" data-gv-id="{{ v.id }}" data-gv-pick="&euro;{{ amt }}"><span style="font-family:var(--font-heading); font-weight:800; font-size:26px; line-height:1;">&euro;{{ amt }}</span><span style="font-size:12.5px; font-weight:700; opacity:.7;">{{ vtag }}</span></button>
        {%- endfor -%}
      </div>
      {%- if request.design_mode -%}
        {%- assign orphans = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'amount' -%}
            {%- assign want = block.settings.amount | times: 100 -%}
            {%- assign hit = false -%}
            {%- for v in gv_product.variants -%}{%- if v.price == want -%}{%- assign hit = true -%}{%- endif -%}{%- endfor -%}
            {%- unless hit -%}{%- assign orphans = orphans | append: '€' | append: block.settings.amount | append: ' ' -%}{%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if orphans != '' -%}
        <p style="margin:0 0 18px; padding:18px; border:1.5px dashed #cfd1cc; border-radius:12px; font-size:15px; color:#666b60;">
          <strong>No button drawn for {{ orphans | strip }}.</strong> These amounts have an <strong>Amount</strong> block here but no matching denomination on the <strong>gift-voucher</strong> product, so there is nothing to sell. Add the denomination in Shopify, or remove the block. Customers don&rsquo;t see this note.
        </p>
        {%- endif -%}
      {%- endif -%}

      <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(22px,2.4vw,30px); margin:38px 0 6px;">2. How should we send it?</h2>
      <p style="margin:0 0 18px; font-size:15.5px; line-height:1.65; color:#5d6159;">Vouchers arrive by email within minutes, or on a date you choose.</p>
      <div style="display:flex; flex-direction:column; gap:12px; max-width:620px;">
        <button type="button" class="gv-method gv-on" aria-pressed="true" data-gv-method="By email">
          <span class="gv-dot"></span>
          <span style="flex:1; min-width:0;">
            <span style="display:block; font-weight:800; font-size:16px; color:#2A2B2A; margin-bottom:3px;">By email</span>
            <span style="display:block; font-size:14.5px; line-height:1.6; color:#5d6159;">Sent to the recipient within minutes, or scheduled for a date you choose.</span>
          </span>
          <span class="gv-method-cost" style="flex:0 0 auto; font-weight:800; font-size:14.5px; color:var(--c-dark);">Free</span>
        </button>
        <button type="button" class="gv-method" aria-pressed="false" data-gv-method="Send it to me">
          <span class="gv-dot"></span>
          <span style="flex:1; min-width:0;">
            <span style="display:block; font-weight:800; font-size:16px; color:#2A2B2A; margin-bottom:3px;">Send it to me</span>
            <span style="display:block; font-size:14.5px; line-height:1.6; color:#5d6159;">We send the voucher to you, so you can pass it on yourself.</span>
          </span>
          <span class="gv-method-cost" style="flex:0 0 auto; font-weight:800; font-size:14.5px; color:var(--c-dark);">Free</span>
        </button>
        {%- comment -%}
          The method's own properties live here, beside the buttons that choose it, not
          inside a field that a later redesign might move or delete. Shopify's two flags
          are what make it email the recipient at all; they were nested in the date
          control, where replacing the date picker would have taken them with it.
          `applyMethod`'s `input[data-gv-only]` loop enables exactly the ones whose
          method is chosen, so scoping is still one attribute and no new JS.

          Both methods post `Delivery`, so every order states how it was sent rather
          than leaving staff to infer it from whether `Recipient email` is there. Two
          enabled inputs would collide on the name, which is exactly why only one is
          ever enabled.

          There were three methods until 1 Oct 2026. "Printed and posted" is gone on a
          client decision — vouchers are online only — and with it `Postal address`,
          its `Delivery` value and its branch in `applyMethod`. Nothing in the theme
          posts a voucher to anyone now, so `setup/VOUCHER-POST-FLOW.md` describes a
          Flow that is not needed.
        {%- endcomment -%}
        <input type="hidden" name="properties[Delivery]" value="By email" data-gv-only="By email" disabled>
        <input type="hidden" name="properties[Delivery]" value="Sent to me" data-gv-only="Send it to me" disabled>
        <input type="hidden" name="properties[__shopify_send_gift_card_to_recipient]" value="if_present" data-gv-only="By email" disabled>
        <input type="hidden" name="properties[__shopify_offset]" id="gv-offset" data-gv-only="By email" disabled>
      </div>

      <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(22px,2.4vw,30px); margin:38px 0 6px;">3. Who is it for?</h2>
      {%- comment -%}
        Every field below is a line item property, which is what puts it on the order.
        The names are Shopify's own, exactly: with `Recipient email` present and
        `__shopify_send_gift_card_to_recipient` set to `if_present`, Shopify emails the
        voucher to the recipient itself, on `Send on` if that is given. Rename one and
        Shopify stops recognising it, and the voucher quietly goes to the buyer instead.

        Fields not relevant to the chosen method are `disabled`, so the browser leaves
        them out of the post entirely — no JS runs at submit time, and "Send it to me"
        posts a bare gift card, which is precisely what makes Shopify issue it to the
        buyer. `Recipient name` and `Message` are shared by both methods; two enabled
        inputs may never carry the same name.

        There is no `From` field. It was one, and it reached the bag and the order but
        never the recipient: the gift card notification renders in `gift_card` scope,
        with no `order` and no `line_item`, so a line item property cannot appear in it
        and there is no sender property on the object to hold one. A field that says
        "From" beside a voucher nobody signs is a promise the platform cannot keep, so
        `Message` carries it instead and its hint says so.
      {%- endcomment -%}
      <p data-gv-who-note style="margin:0; font-size:15.5px; line-height:1.65; color:#5d6159;">We&rsquo;ll send the voucher straight to them.</p>
      <div data-gv-who style="display:flex; flex-wrap:wrap; gap:14px; max-width:620px; margin-top:12px;">
        <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
          <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Recipient name</span>
          <input type="text" autocomplete="off" class="gv-input" name="properties[Recipient name]" style="height:52px; border:1px solid #dfe1dc; border-radius:10px; padding:0 14px; font-family:inherit; font-size:15.5px; color:#2A2B2A; outline:none;">
        </label>
        <label data-gv-only="By email" style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
          <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Recipient email</span>
          <input type="email" autocomplete="off" class="gv-input" name="properties[Recipient email]" required style="height:52px; border:1px solid #dfe1dc; border-radius:10px; padding:0 14px; font-family:inherit; font-size:15.5px; color:#2A2B2A; outline:none;">
        </label>
        {%- comment -%}
          Two radios and a native `<input type="date">`, which is what replaced 88 lines
          of hand-rolled calendar. The old picker had a popup that covered the Message
          field on desktop and both Message and From on mobile, closed with neither
          Escape nor a click outside, and put its Done button below the fold at 375px —
          all problems the platform's own control does not have.

          `Send now` is the default and leaves the date input `disabled`, so the browser
          posts no `Send on` at all and Shopify sends on fulfilment. That keeps the rule
          the rest of this form runs on: what is posted is decided by `disabled`, before
          submit, not by JS at submit time. With JS off the input stays disabled, so
          no-JS means send now — the safe default rather than a broken one.

          `min` and `max` are set from JS on load, not from Liquid: `{{ 'now' }}` renders
          server-side into a CDN-cached page, so a Liquid `min` is the shop's timezone and
          goes stale at midnight. `iso()` uses local date parts for the same reason it
          always did. The 90-day ceiling is Shopify's: it refuses to schedule a gift card
          further out. `max` is a courtesy, not the guard — the cart is the guard, and its
          error reaches the shopper through `showCartMessage`.

          A fieldset and legend, so the group announces as "Delivery date" instead of the
          old button whose entire accessible name was "Send immediately".
        {%- endcomment -%}
        <fieldset class="gv-date" data-gv-only="By email" style="flex:1 1 100%; min-width:0; border:0; margin:0; padding:0; display:flex; flex-direction:column; gap:9px;">
          <legend style="padding:0; font-size:13.5px; font-weight:700; color:#2A2B2A;">Delivery date</legend>
          <label class="gv-when"><input type="radio" name="gv-when" id="gv-when-now" value="now" checked>Send now</label>
          <label class="gv-when"><input type="radio" name="gv-when" id="gv-when-pick" value="pick">Pick a date</label>
          {%- comment -%} `data-gv-when`, never `data-gv-only`: that attribute means "this
              scope belongs to one delivery method" and `applyMethod` acts on it. The
              `[hidden]` rule at the top of this file has to name this attribute too,
              because the inline `display:flex` below would otherwise beat the UA sheet —
              the same trap as `[data-gv-only][hidden]`. {%- endcomment -%}
          <label data-gv-when="pick" hidden style="display:flex; flex-direction:column; gap:7px; max-width:260px;">
            <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Send it on</span>
            <input type="date" class="gv-input" name="properties[Send on]" id="gv-send-on" required disabled style="height:52px; border:1px solid #dfe1dc; border-radius:10px; padding:0 14px; font-family:inherit; font-size:15.5px; color:#2A2B2A; outline:none;">
          </label>
        </fieldset>
        <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px; min-width:0;">
          <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Message <span style="font-weight:600; color:#666b60;">(optional, up to 200 characters &mdash; sign it if you&rsquo;d like them to know who it&rsquo;s from.)</span></span>
          <textarea rows="3" class="gv-input" name="properties[Message]" maxlength="200" style="border:1px solid #dfe1dc; border-radius:10px; padding:12px 14px; font-family:inherit; font-size:15.5px; line-height:1.6; color:#2A2B2A; outline:none; resize:vertical;"></textarea>
        </label>
      </div>
    </div>

    <aside class="gv-side" style="flex:0 0 340px; width:340px; position:sticky; top:20px;">
      <div class="gv-summary" style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
        <div style="font-size:12px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#666b60; margin-bottom:10px;">Your voucher</div>
        <div style="display:flex; align-items:baseline; gap:10px; margin-bottom:4px;">
          <span data-gv-amount style="font-family:var(--font-heading); font-weight:800; font-size:40px; line-height:1; color:var(--c-dark);">&euro;{{ gv_default }}</span>
        </div>
        <div data-gv-method-label style="font-size:14px; color:#666b60; margin-bottom:20px;">By email</div>
        <div style="border-top:1px solid #eceee9; padding-top:16px; display:flex; flex-direction:column; gap:10px; font-size:14.5px; color:#3a3d39;">
          <div style="display:flex; justify-content:space-between; gap:12px;"><span style="color:#666b60;">Voucher value</span><span data-gv-amount style="font-weight:700;">&euro;{{ gv_default }}</span></div>
          <div style="display:flex; justify-content:space-between; gap:12px;"><span style="color:#666b60;">Delivery</span><span style="font-weight:700;">Free</span></div>
        </div>
        <div style="margin-top:20px;"><button type="submit" class="btn btn-fill" style="gap:9px; width:100%">Add voucher to bag</button></div>
        <div style="font-size:12.5px; line-height:1.6; color:#666b60; margin-top:12px;">Vouchers are valid for five years and can be spent over as many orders as you like.</div>
      </div>
      <div style="margin-top:16px; padding:20px 22px; border-radius:16px; background:#eef2e8;">
        <div style="font-family:var(--font-heading); font-weight:800; font-size:16.5px; color:var(--c-dark); margin-bottom:10px;">Prefer to buy in store?</div>
        <div style="font-size:14px; line-height:1.7; color:#3a3d39; margin-bottom:12px;">Our shops sell their own gift vouchers at the counter, in any amount you like. Those are separate from the voucher on this page, which is for spending online.</div>
        <a href="/pages/store-locator" class="hov-green-dk" style="font-weight:800; font-size:14.5px; color:var(--c-primary-text);">Find your nearest store &rarr;</a>
      </div>
    </aside>
  </div>
  </form>
{%- endif -%}
</section>

<!-- How it works -->
<section style="max-width:1440px; margin:0 auto; padding:48px 30px 8px;">
  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(22px,2.4vw,30px); margin:0 0 24px;">How it works</h2>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:22px;">
    <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
      <div style="font-family:var(--font-heading); font-weight:800; font-size:18px; color:var(--c-dark); margin-bottom:8px;">Choose and pay</div>
      <div style="font-size:15px; line-height:1.7; color:#3a3d39;">Pick an amount, say who it&rsquo;s for and when it should arrive, then check out as normal. Paying for a voucher costs nothing extra.</div>
    </div>
    <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
      <div style="font-family:var(--font-heading); font-weight:800; font-size:18px; color:var(--c-dark); margin-bottom:8px;">It arrives</div>
      <div style="font-size:15px; line-height:1.7; color:#3a3d39;">The voucher lands in their inbox within minutes, or on the date you chose, with your message and the code to spend.</div>
    </div>
    <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
      <div style="font-family:var(--font-heading); font-weight:800; font-size:18px; color:var(--c-dark); margin-bottom:8px;">They spend it</div>
      <div style="font-size:15px; line-height:1.7; color:#3a3d39;">At the checkout on mccormackspharmacy.ie. Any unspent balance stays on the voucher for next time.</div>
    </div>
  </div>
</section>

<!-- SEO copy + FAQ -->
<section style="max-width:1440px; margin:0 auto; padding:48px 30px 8px;">
  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(26px,3vw,40px); line-height:1.1; margin:0 0 20px;">About McCormack&rsquo;s gift vouchers</h2>
  <p style="margin:0 0 40px; font-size:16px; line-height:1.7; color:#3a3d39; max-width:var(--measure);">A McCormack&rsquo;s gift voucher works across everything we sell online &mdash; pharmacy and healthcare, vitamins and supplements, skincare, beauty, fragrance, baby and toiletries. It is a practical present for someone who is particular about their skincare, restocking after a new baby, or simply hard to buy for. Vouchers arrive by email within minutes and can be scheduled for a specific date. Vouchers are valid for five years from the date of purchase, can be spent over as many orders as you like, and any remaining balance stays on the voucher.</p>

  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(24px,2.6vw,34px); margin:0 0 26px;">Frequently Asked Questions</h2>
  <div style="display:flex; flex-direction:column;">
    <div style="border-bottom:1px solid #eceee9; padding:22px 0;">
      <h3 style="font-family:var(--font-heading); font-weight:700; color:#2A2B2A; font-size:clamp(18px,1.8vw,22px); margin:0 0 10px;">How long is a gift voucher valid for?</h3>
      <p style="margin:0; font-size:15.5px; line-height:1.65; color:#5a6153; max-width:var(--measure);">Five years from the date of purchase. The expiry date is shown on the voucher email.</p>
    </div>
    <div style="border-bottom:1px solid #eceee9; padding:22px 0;">
      <h3 style="font-family:var(--font-heading); font-weight:700; color:#2A2B2A; font-size:clamp(18px,1.8vw,22px); margin:0 0 10px;">Where can a gift voucher be spent?</h3>
      <p style="margin:0; font-size:15.5px; line-height:1.65; color:#5a6153; max-width:var(--measure);">Online, at the checkout on mccormackspharmacy.ie, on anything we sell there. It can&rsquo;t be spent at the counter in our shops &mdash; the shops sell their own vouchers for that.</p>
    </div>
    <div style="border-bottom:1px solid #eceee9; padding:22px 0;">
      <h3 style="font-family:var(--font-heading); font-weight:700; color:#2A2B2A; font-size:clamp(18px,1.8vw,22px); margin:0 0 10px;">What happens if they spend less than the full amount?</h3>
      <p style="margin:0; font-size:15.5px; line-height:1.65; color:#5a6153; max-width:var(--measure);">Any remaining balance stays on the voucher and can be used on as many future orders as they like, until it runs out or expires.</p>
    </div>
    <div style="border-bottom:1px solid #eceee9; padding:22px 0;">
      <h3 style="font-family:var(--font-heading); font-weight:700; color:#2A2B2A; font-size:clamp(18px,1.8vw,22px); margin:0 0 10px;">Can I add to a voucher or use more than one on an order?</h3>
      <p style="margin:0; font-size:15.5px; line-height:1.65; color:#5a6153; max-width:var(--measure);">Vouchers cannot be topped up, but you can use several on a single order. If the order comes to more than the voucher balance, pay the difference by card as normal.</p>
    </div>
    <div style="border-bottom:1px solid #eceee9; padding:22px 0;">
      <h3 style="font-family:var(--font-heading); font-weight:700; color:#2A2B2A; font-size:clamp(18px,1.8vw,22px); margin:0 0 10px;">What if the voucher is lost?</h3>
      <p style="margin:0; font-size:15.5px; line-height:1.65; color:#5a6153; max-width:var(--measure);">A voucher can be resent to the address it was sent to originally &mdash; contact us with your order number and we&rsquo;ll send it again.</p>
    </div>
    <div style="border-bottom:1px solid #eceee9; padding:22px 0;">
      <h3 style="font-family:var(--font-heading); font-weight:700; color:#2A2B2A; font-size:clamp(18px,1.8vw,22px); margin:0 0 10px;">Are gift vouchers refundable?</h3>
      <p style="margin:0; font-size:15.5px; line-height:1.65; color:#5a6153; max-width:var(--measure);">Vouchers cannot be returned or exchanged for cash, in line with Irish consumer law on gift vouchers. Products bought with a voucher can be returned under our normal returns policy.</p>
    </div>
  </div>
</section>

<!-- You may also like. Drawn only when the chosen collection has products published to
     the online store; otherwise nothing, so customers never meet an empty heading. -->
{%- assign also_col = section.settings.also_collection -%}
{%- if also_col.products.size > 0 -%}
<section style="max-width:1440px; margin:0 auto; padding:44px 30px 8px;">
  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(22px,2.4vw,30px); margin:0 0 24px;">You may also like</h2>
  <div style="position:relative;">
    <div id="also-track" style="display:flex; gap:22px; overflow-x:auto; scroll-behavior:smooth; scrollbar-width:none; padding:4px;">
        {%- for product in also_col.products limit: 8 -%}
          {%- capture restricted -%}{%- render 'product-restricted', product: product -%}{%- endcapture -%}
          {%- assign restricted = restricted | strip -%}
          {%- comment -%} Blank unless the price shown is genuinely reduced — see snippets/product-compare-at.liquid. {%- endcomment -%}
          {%- capture was -%}{%- render 'product-compare-at', product: product -%}{%- endcapture -%}
          {%- assign was = was | strip -%}
          <div class="pcard" style="flex:0 0 240px; border:1px solid #eceee9; border-radius:16px; padding:18px; display:flex; flex-direction:column;">
            <div style="position:relative; aspect-ratio:1; border-radius:10px; background:#ffffff; border:1px solid #eceee9; display:flex; align-items:center; justify-content:center; margin-bottom:14px; overflow:hidden;">
              {%- if was != blank -%}<span class="sale-badge">SALE</span>{%- endif -%}
              {%- if product.featured_image -%}
                {%- capture card_alt %}{% render 'image-alt', image: product.featured_image, product: product %}{% endcapture -%}
                {{ product.featured_image | image_url: width: 480 | image_tag: alt: card_alt, style: 'width:100%; height:100%; object-fit:contain; display:block;' }}
              {%- else -%}
                <div style="width:100%; height:100%; background:repeating-linear-gradient(135deg,#dfe6d5,#dfe6d5 12px,#d7dfcb 12px,#d7dfcb 24px); display:flex; align-items:center; justify-content:center;"><span style="font-family:ui-monospace,monospace; font-size:11px; color:var(--c-primary-text); font-weight:700;">image</span></div>
              {%- endif -%}
              {% render 'quick-view-button', product: product, restricted: restricted %}
            </div>
            <div style="font-size:13px; font-weight:700; color:var(--c-primary-text); margin-bottom:6px;">{{ product.vendor }}</div>
            <h3 style="font-weight:600; font-size:15px; line-height:1.35; margin:0 0 10px; min-height:41px;">{{ product.title }}</h3>
            <div style="display:flex; align-items:baseline; gap:9px; margin-bottom:14px;"><span style="color:var(--c-primary-text); font-weight:800; font-size:19px;">{{ product.price | money }}</span>{%- if was != blank -%}<span class="price-was">{{ was }}</span>{%- endif -%}</div>
            <a href="{% render 'product-card-url', product: product %}" class="btn-sm btn-fill" style="margin-top:auto">View Product</a>
          </div>
        {%- endfor -%}
    </div>
    <button aria-label="Scroll back" data-rail-btn data-rail-back data-rail-target="also-track" data-rail-by="-540" style="position:absolute; left:-14px; top:calc(50% - 20px); transform:translateY(-50%); width:44px; height:44px; border-radius:999px; border:1.5px solid #cfd1cc; background:#fff; color:var(--c-primary-text); cursor:pointer; display:none; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(0,0,0,.1);"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"></polyline></svg></button>
    <button aria-label="Scroll forward" data-rail-btn data-rail-target="also-track" data-rail-by="540" style="position:absolute; right:-14px; top:calc(50% - 20px); transform:translateY(-50%); width:44px; height:44px; border-radius:999px; border:1.5px solid #cfd1cc; background:#fff; color:var(--c-primary-text); cursor:pointer; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(0,0,0,.1);"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg></button>
  </div>
</section>
{%- elsif request.design_mode -%}
<section style="max-width:1440px; margin:0 auto; padding:44px 30px 8px;">
  <p style="margin:0; padding:18px; border:1.5px dashed #cfd1cc; border-radius:12px; text-align:center; font-size:15px; color:#666b60;">
    <strong>You may also like</strong> is hidden: pick a collection with products published to the online store in <strong>Gift vouchers page &rsaquo; "You may also like" collection</strong>. Customers don't see this note.
  </p>
</section>
{%- endif -%}

<script>
  (function () {
    var form = document.getElementById('gv-form');
    if (!form) return;   // no gift card product: the notice is showing, there is nothing to drive

    var sel = form.querySelector('.gv-amt.gv-on') || form.querySelector('.gv-amt');
    var state = { amount: sel ? sel.dataset.gvPick : '', method: 'By email' };

    // Shopify will not schedule a gift card more than 90 days out, so the input must
    // not offer day 91. Offering it and letting the cart reject it is the same defect
    // as a button for a denomination that does not exist.
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var maxDate = new Date(today); maxDate.setDate(maxDate.getDate() + 90);

    // Local parts, never toISOString(): that converts to UTC, so an evening in Ireland
    // during summer time becomes the next day and the voucher arrives a day early.
    var iso = function (d) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    };

    var offset = document.getElementById('gv-offset');
    if (offset) offset.value = new Date().getTimezoneOffset();

    // The bounds are set here rather than in Liquid: `{{ 'now' }}` renders server-side
    // into a CDN-cached page, so it would carry the shop's timezone and go stale at
    // midnight. Same reason `iso()` exists — local parts, never toISOString().
    var dateInput = document.getElementById('gv-send-on');
    var datePick = document.getElementById('gv-when-pick');
    var dateBox = form.querySelector('.gv-date');
    var dateWrap = form.querySelector('[data-gv-when="pick"]');
    if (dateInput) {
      dateInput.min = iso(today);
      dateInput.max = iso(maxDate);
    }

    // Which of the two radios is chosen decides whether a date is posted at all, by the
    // same `disabled` rule the delivery method uses. It must run after applyMethod, which
    // enables everything its method owns — including this input — and it must not undo
    // applyMethod for a method that has no date at all, or "Send it to me" would post a
    // `Send on`. `dateBox.hidden` is what applyMethod has just decided, so read that.
    var applyWhen = function () {
      if (!dateInput) return;
      var pick = !dateBox.hidden && datePick.checked;
      dateWrap.hidden = !pick;
      dateInput.disabled = !pick;
    };
    form.querySelectorAll('[name="gv-when"]').forEach(function (r) {
      r.addEventListener('change', applyWhen);
    });

    // Which fields the chosen method actually submits. Disabled inputs are left out of
    // the post by the browser, so "Send it to me" sends a bare gift card line and
    // Shopify issues it to the buyer. No submit-time JS decides this.
    var applyMethod = function () {
      var who = form.querySelector('[data-gv-who]');
      var note = form.querySelector('[data-gv-who-note]');
      var mine = state.method === 'Send it to me';
      who.hidden = mine;
      note.textContent = mine
        ? 'Nothing needed here — we’ll send the voucher to the email address you check out with.'
        : 'We’ll send the voucher straight to them.';
      who.querySelectorAll('[data-gv-only], input, textarea').forEach(function (el) {
        var scope = el.closest('[data-gv-only]');
        var want = !mine && (!scope || scope.dataset.gvOnly === state.method);
        if (scope) scope.hidden = !want;
        if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') el.disabled = !want;
      });
      // The method's own properties sit beside the method buttons, outside the block above.
      form.querySelectorAll('input[data-gv-only]').forEach(function (el) {
        el.disabled = el.dataset.gvOnly !== state.method;
      });
      // Last word on the date input, which the loop above has just enabled wholesale.
      applyWhen();
    };

    var sync = function () {
      document.querySelectorAll('[data-gv-amount]').forEach(function (el) { el.textContent = state.amount; });
      document.querySelectorAll('[data-gv-method-label]').forEach(function (el) { el.textContent = state.method; });
      // these controls are buttons — keep the selected state exposed to assistive tech
      document.querySelectorAll('.gv-amt, .gv-method').forEach(function (b) {
        b.setAttribute('aria-pressed', b.classList.contains('gv-on') ? 'true' : 'false');
      });
      applyMethod();
    };

    // Amount chips. Each one carries its own variant, so the hidden id and the price
    // on screen cannot disagree.
    form.querySelectorAll('[data-gv-pick]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        form.querySelectorAll('[data-gv-pick]').forEach(function (b) { b.classList.remove('gv-on'); });
        a.classList.add('gv-on');
        document.getElementById('gv-variant').value = a.dataset.gvId;
        state.amount = a.dataset.gvPick;
        sync();
      });
    });

    // Delivery method
    document.querySelectorAll('[data-gv-method]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        document.querySelectorAll('[data-gv-method]').forEach(function (b) { b.classList.remove('gv-on'); });
        a.classList.add('gv-on');
        state.method = a.dataset.gvMethod;
        sync();
      });
    });

    sync();
  })();
</script>

{% schema %}
{
  "name": "Gift Vouchers page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gift Vouchers"
    },
    {
      "type": "collection",
      "id": "also_collection",
      "label": "\"You may also like\" collection",
      "info": "Optional. The row is hidden unless this collection has products published to the online store."
    }
  ],
  "presets": [
    {
      "name": "Gift Vouchers page",
      "blocks": [
        {
          "type": "amount",
          "settings": {
            "amount": 25,
            "tag": "Popular",
            "preselected": false
          }
        },
        {
          "type": "amount",
          "settings": {
            "amount": 50,
            "tag": "Most gifted",
            "preselected": true
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "amount",
      "name": "Voucher amount",
      "settings": [
        {
          "type": "number",
          "id": "amount",
          "label": "Amount (EUR)",
          "default": 25,
          "info": "Must match a denomination on the gift-voucher product in Shopify. The amounts on the page come from that product; a block whose amount matches nothing draws no button."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "info": "Optional label under the amount, e.g. Popular."
        },
        {
          "type": "checkbox",
          "id": "preselected",
          "label": "Preselected",
          "default": false,
          "info": "Mark exactly one amount; it starts selected and shows on the voucher preview. If it matches no denomination, the first denomination is selected instead."
        }
      ]
    }
  ]
}
{% endschema %}
