{%- comment -%}
  Generic rich text block. Not used by any template out of the box — exists so
  a merchant can add copy to a page from the editor without a developer.
  Follows the shared section shell: 1440px rail, 30px gutters, rounded-MT
  heading, 64ch measure.
{%- endcomment -%}
<section style="max-width:1440px; margin:0 auto; padding:34px 30px 8px;">
  <div style="max-width:820px;{% if section.settings.centered %} margin:0 auto; text-align:center;{% endif %}">
    {%- if section.settings.heading != blank -%}
    <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(22px,2.2vw,28px); margin:0 0 14px;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
    <div class="rte-body" style="font-size:16px; line-height:1.75; color:#3a3d39; max-width:64ch;{% if section.settings.centered %} margin:0 auto;{% endif %}">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.cta != blank and section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" class="slide-cta btn btn-fill" style="gap:9px; margin-top:20px">{{ section.settings.cta }}<svg class="cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s ease;"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="8 7 17 7 17 16"></polyline></svg></a>
    {%- endif -%}
  </div>
</section>

{% style %}
.rte-body p { margin: 0 0 15px; }
.rte-body p:last-child { margin-bottom: 0; }
{% endstyle %}

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "cta", "label": "Button label", "info": "Shown only when a link is set too." },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "checkbox", "id": "centered", "label": "Centre the text", "default": false }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
