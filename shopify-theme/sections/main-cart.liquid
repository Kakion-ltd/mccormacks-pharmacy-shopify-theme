{%- comment -%}
  Main cart section — ported from the "Cart - Checkout" design, BAG STEP ONLY.
  The design's checkout and order-confirmation steps are not ported: Shopify's
  checkout is not themeable, so "Checkout securely" posts to Shopify checkout
  (form to /cart with name="checkout") and the confirmation page is Shopify's own.
  The design's "Save for later" link has no Shopify equivalent and is omitted.
{%- endcomment -%}

{%- capture fd_cents -%}{%- render 'free-delivery-cents' -%}{%- endcapture -%}
{%- assign free_delivery_threshold = fd_cents | plus: 0 -%}

{%- comment -%}
  Free delivery is the threshold and nothing else. Until 1 Oct 2026 a bag holding a
  sale or offer item was told free delivery "isn't available", but the checkout's
  automatic free-shipping discount never excluded those items, so the bag said one
  thing and the checkout did another. The theme claim went; see setup/MAINTENANCE.md,
  "Free delivery and sale items", for what enforcing it would take.
{%- endcomment -%}

{%- comment -%} PSI 2.5: a bag holding a medicine (the restricted tag) asks the customer
    to confirm they are over 18 and will follow the leaflet before checkout. The tick is
    a required checkbox in the checkout form, saved as the cart attribute
    "Over 18 and will follow the leaflet" = "Yes", which lands on the order's
    Additional details. The attribute NAME is load-bearing: the pharmacist-hold Flow
    checks for it by exact text (setup/MAINTENANCE.md, "The pharmacist hold"). Rename
    one, rename both.
    Express buttons are dropped for such a bag: they are not submit buttons, so they
    would skip the required tick. This is the soft gate; Buy it now, cart links and
    draft orders never see this page, and the Flow flags any medicine order without
    the attribute. The drawer (snippets/cart-drawer.liquid) fetches this section and
    looks for [data-medicine-declaration] to decide whether to send the shopper here
    first, so keep that marker on the box. {%- endcomment -%}
{%- assign cart_has_medicine = false -%}
{%- for item in cart.items -%}
  {%- capture item_restricted -%}{%- render 'product-restricted', product: item.product -%}{%- endcapture -%}
  {%- if item_restricted == 'true' -%}{%- assign cart_has_medicine = true -%}{%- break -%}{%- endif -%}
{%- endfor -%}

<div style="width:100%; overflow-x:hidden; background:#ffffff;">

  <section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">

    {%- render 'breadcrumb', current: 'Shopping bag' -%}
    <div style="display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:12px 24px; margin:0 0 22px;">
      <h1 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); font-size:clamp(28px,3.2vw,40px); line-height:1.08; margin:0;">Your shopping bag</h1>
      {%- if cart.item_count > 0 -%}
        <span style="font-size:14.5px; color:#666b60;">{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}</span>
      {%- endif -%}
    </div>

    {%- if cart.item_count == 0 -%}

      <!-- Empty bag -->
      <div style="border:1px solid #e6e7e4; border-radius:16px; padding:56px 30px; text-align:center; background:#ffffff;">
        <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="var(--c-accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:16px;"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><path d="M3 6h18"></path><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <div style="font-family:var(--font-heading); font-weight:800; font-size:22px; color:var(--c-dark); margin-bottom:8px;">Your bag is empty</div>
        <p style="margin:0 auto 24px; max-width:44ch; font-size:15px; line-height:1.6; color:#666b60;">Looks like you haven't added anything yet. Browse our shelves and we'll keep your bag ready.</p>
        <a href="/collections/medicines-health" class="btn btn-fill" style="gap:9px">Continue shopping</a>
      </div>

    {%- else -%}

    <div class="cart-wrap" style="display:flex; gap:44px; align-items:flex-start;">
      <div style="flex:1 1 auto; min-width:0;">
        <div style="border-top:1px solid #e6e7e4;">
          {%- for item in cart.items -%}
          {%- comment -%} The price this line is reduced from: the compare-at when the
              variant has one, else Shopify's pre-discount price. The drawer reads
              data-compare-line from here, because /cart.js has no compare-at. {%- endcomment -%}
          {%- assign was_unit = item.original_price -%}
          {%- if item.variant.compare_at_price > was_unit -%}{%- assign was_unit = item.variant.compare_at_price -%}{%- endif -%}
          <div class="cart-row" data-line-key="{{ item.key }}"{% if item.variant.compare_at_price > item.original_price %} data-compare-line="{{ item.variant.compare_at_price | times: item.quantity }}"{% endif %} style="display:flex; gap:22px; padding:24px 0; border-bottom:1px solid #e6e7e4;">
            <a href="{% render 'product-card-url', product: item.product %}" style="flex:0 0 auto; width:118px; height:118px; border:1px solid #e6e7e4; border-radius:12px; overflow:hidden; background:#ffffff;">
              {%- if item.image -%}
                {{ item.image | image_url: width: 236 | image_tag: alt: item.title, style: 'width:100%; height:100%; object-fit:contain; display:block;' }}
              {%- else -%}
                <div style="width:100%; height:100%; background:repeating-linear-gradient(135deg,#dfe6d5,#dfe6d5 12px,#d7dfcb 12px,#d7dfcb 24px);"></div>
              {%- endif -%}
            </a>
            <div style="flex:1 1 auto; min-width:0; display:flex; flex-direction:column; gap:8px;">
              {%- if item.vendor != blank -%}
                <div style="font-family:var(--font-heading); font-weight:800; font-size:12.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--c-primary-text);">{{ item.vendor }}</div>
              {%- endif -%}
              <a href="{% render 'product-card-url', product: item.product %}" class="hov-green" style="font-weight:700; font-size:16px; line-height:1.45; color:#2A2B2A; max-width:46ch;">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <div style="font-size:13px; color:#666b60;">{{ item.variant.title }}</div>
              {%- endunless -%}
              {%- comment -%}
                Line item properties, so a gift voucher's recipient and send date can be
                checked before paying — a typo in the email address is unrecoverable once
                Shopify has sent the voucher to it. A leading underscore means "on the
                order, not on screen": that hides the questionnaire's stamps and the
                __shopify_* plumbing without naming either of them here.

                A questionnaire line (it carries the hidden _questionnaire stamp) folds its
                answers into one "Health questions: N answered" toggle: up to 18 health
                answers are not something to leave open on a screen, and they pushed the
                stepper and Remove out of sight. The property names are unchanged — the
                pharmacist-hold Flow reads them off the order.
              {%- endcomment -%}
              {%- capture prop_rows -%}
                {%- assign prop_count = 0 -%}
                {%- for prop in item.properties -%}
                  {%- unless prop.first == blank or prop.last == blank -%}
                    {%- assign lead = prop.first | slice: 0 -%}
                    {%- if lead != '_' -%}
                      {%- assign prop_count = prop_count | plus: 1 -%}
                      <div style="font-size:13px; line-height:1.5; color:#666b60; overflow-wrap:anywhere;">{{ prop.first }}: {{ prop.last }}</div>
                    {%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if item.properties['_questionnaire'] != blank and prop_count > 0 -%}
                <details class="cart-health">
                  <summary>Health questions: {{ prop_count }} answered</summary>
                  <div class="cart-health-list">{{ prop_rows }}</div>
                </details>
              {%- else -%}
                {{ prop_rows }}
              {%- endif -%}
              {%- for d in item.line_level_discount_allocations -%}
                <div style="display:inline-flex; align-items:center; gap:7px; width:fit-content; height:26px; padding:0 10px; border-radius:6px; background:#eef2e8; color:var(--c-primary-text); font-size:12px; font-weight:800;">{{ d.discount_application.title }}</div>
              {%- endfor -%}
              <div style="display:flex; align-items:baseline; gap:10px; font-size:15px;">
                <span style="font-weight:800; color:#2A2B2A;">{{ item.final_price | money }}</span>
                {%- if was_unit > item.final_price -%}
                  <span style="color:#666b60; text-decoration:line-through; font-size:13.5px;">{{ was_unit | money }}</span>
                {%- endif -%}
                <span style="color:#666b60; font-size:13.5px;">each</span>
              </div>
              <div class="cart-row-foot" style="display:flex; flex-direction:column; align-items:flex-start; gap:0; margin-top:4px;">
                <div style="display:flex; align-items:center; border:1px solid #dfe1dc; border-radius:9px; height:46px; overflow:hidden; width:fit-content;">
                  <button type="button" class="cart-step" data-line="{{ forloop.index }}" data-line-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity" style="width:44px; height:100%; border:none; background:#fbfcfa; color:#2A2B2A; font-size:19px; font-weight:700; cursor:pointer; font-family:inherit;">&minus;</button>
                  <span style="min-width:44px; text-align:center; font-weight:800; font-size:15.5px;">{{ item.quantity }}</span>
                  <button type="button" class="cart-step" data-line="{{ forloop.index }}" data-line-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity" style="width:44px; height:100%; border:none; background:#fbfcfa; color:#2A2B2A; font-size:19px; font-weight:700; cursor:pointer; font-family:inherit;">+</button>
                </div>
                {%- comment -%} Same handler as the steppers (quantity 0), so the page reloads
                    with the totals, the delivery bar and the medicine tick box recomputed. The
                    href is the no-JS route. The label names the line for a screen reader. {%- endcomment -%}
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-remove" data-line="{{ forloop.index }}" data-line-qty="0" aria-label="Remove {{ item.product.title | escape }}{% unless item.product.has_only_default_variant %}, {{ item.variant.title | escape }}{% endunless %}" style="display:inline-flex; align-items:center; gap:6px; min-height:44px; font-size:13.5px; font-weight:700; color:#666b60;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path><path d="M10 11v6M14 11v6"></path></svg>Remove</a>
              </div>
            </div>
            <div style="flex:0 0 auto; text-align:right; font-family:var(--font-heading); font-weight:800; font-size:19px; color:#2A2B2A;">{{ item.final_line_price | money }}</div>
          </div>
          {%- endfor -%}
        </div>
        {%- comment -%} Cross-sell rail, anchored to the first line item. Filled by
            theme.js from sections/cart-recommendations.liquid, which filters out
            restricted products and anything already in the bag. {%- endcomment -%}
        {%- if cart.item_count > 0 -%}
          <div data-crec-mount data-crec-product="{{ cart.items.first.product_id }}" hidden></div>
        {%- endif -%}

        <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:14px; padding:22px 0 0;">
          <a href="/collections/medicines-health" class="hov-green-dk" style="display:inline-flex; align-items:center; gap:9px; min-height:44px; font-weight:800; font-size:15px; color:var(--c-primary-text);">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="11 6 5 12 11 18"></polyline></svg>
            Continue shopping
          </a>
        </div>
      </div>

      <aside class="cart-side" style="flex:0 0 372px; width:372px; position:sticky; top:20px;">
        <div style="border:1px solid #e6e7e4; border-radius:16px; padding:24px; background:#ffffff;">
          <div style="font-family:var(--font-heading); font-weight:800; font-size:20px; color:var(--c-dark); margin:0 0 16px;">Order summary</div>

          {%- comment -%} Free delivery progress — threshold from Brand settings, same source as the bag drawer {%- endcomment -%}
          {%- assign progress = cart.total_price | times: 100 | divided_by: free_delivery_threshold | at_most: 100 -%}
          <div style="margin:0 0 18px; padding:16px 18px; border-radius:12px; background:#eef2e8;">
            <div style="display:flex; align-items:center; gap:10px; font-size:14px; font-weight:700; color:var(--c-dark); margin-bottom:10px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--c-primary)" style="flex:0 0 auto;"><path d="M3 5.75A1.75 1.75 0 0 1 4.75 4h8.5A1.75 1.75 0 0 1 15 5.75V6h2.6c.5 0 .96.24 1.25.64l2.4 3.3c.16.22.25.49.25.76V15a1.5 1.5 0 0 1-1.5 1.5h-.6a2.75 2.75 0 0 1-5.4 0H10.4a2.75 2.75 0 0 1-5.4 0h-.25A1.75 1.75 0 0 1 3 14.75V5.75Z"></path></svg>
              {%- if cart.total_price >= free_delivery_threshold -%}
                You have free delivery
              {%- else -%}
                {{ free_delivery_threshold | minus: cart.total_price | money }} away from free delivery
              {%- endif -%}
            </div>
            <div style="height:7px; border-radius:999px; background:#d7e2c8; overflow:hidden;">
              <div style="width:{{ progress }}%; height:100%; background:var(--c-accent);"></div>
            </div>
          </div>

          <div style="display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding:9px 0;">
            <span style="font-size:15px; color:#666b60;">Subtotal</span>
            <span style="font-family:var(--font-heading); font-weight:800; font-size:15.5px; color:#2A2B2A;">{{ cart.original_total_price | money }}</span>
          </div>

          {%- if cart.total_discount > 0 -%}
          <div style="display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding:9px 0;">
            <span style="font-size:15px; color:#666b60;">Savings</span>
            <span style="font-family:var(--font-heading); font-weight:800; font-size:15.5px; color:#2A2B2A;">&minus;{{ cart.total_discount | money }}</span>
          </div>
          {%- endif -%}

          <div style="display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding:9px 0;">
            <span style="font-size:15px; color:#666b60;">Delivery</span>
            <span style="font-family:var(--font-heading); font-weight:800; font-size:15.5px; color:#2A2B2A;">{% if cart.total_price >= free_delivery_threshold %}Free{% else %}Calculated at checkout{% endif %}</span>
          </div>

          <div style="display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding:14px 0 0; border-top:1px solid #e6e7e4; margin-top:6px;">
            <span style="font-size:16.5px; font-weight:800; color:#2A2B2A;">Total</span>
            <span style="font-family:var(--font-heading); font-weight:800; font-size:25px; color:var(--c-dark);">{{ cart.total_price | money }}</span>
          </div>
          <div style="font-size:12.5px; color:#666b60; margin:6px 0 18px;">Includes VAT where applicable</div>

          <form action="{{ routes.cart_url }}" method="post">
            {%- if cart_has_medicine -%}
              {%- comment -%} Customer-facing medical copy: pharmacist/client sign-off
                  before this goes live, like the questionnaire's consent note. {%- endcomment -%}
              <div data-medicine-declaration style="margin:0 0 14px; padding:14px 16px; border:1.5px solid #dfe1dc; border-radius:12px; background:#fbfcfa;">
                <label style="display:flex; gap:11px; align-items:flex-start; font-size:14.5px; line-height:1.55; color:#2A2B2A; cursor:pointer;">
                  <input type="checkbox" name="attributes[Over 18 and will follow the leaflet]" value="Yes" required data-medicine-tick aria-describedby="cart-medicine-err" style="flex:0 0 auto; width:20px; height:20px; margin:2px 0 0; accent-color:var(--c-primary);">
                  <span>I confirm I’m over 18 and will use this medicine as the leaflet says.</span>
                </label>
                <p class="cart-medicine-err" id="cart-medicine-err" data-medicine-err hidden>Please tick this box to continue.</p>
                <p style="margin:10px 0 0 31px; font-size:13px; line-height:1.55; color:#666b60;">A pharmacist reviews every medicine order before we send it. If it isn’t suitable, we’ll cancel it and refund you in full.</p>
              </div>
            {%- endif -%}
            <button type="submit" name="checkout" class="btn btn-fill" style="gap:9px; width:100%">Checkout securely</button>
            {%- comment -%} Shop Pay / Apple Pay / Google Pay / PayPal. Rendered by Shopify
                from the payment providers enabled in the admin — nothing shows here until
                accelerated checkouts are switched on, and nothing shows in the mock preview.
                Not for a bag holding a medicine: see the note at the top. {%- endcomment -%}
            {%- if additional_checkout_buttons and cart_has_medicine == false -%}
              <div class="cart-express" style="margin-top:12px; display:grid; gap:10px;">
                {{ content_for_additional_checkout_buttons }}
              </div>
            {%- endif -%}
          </form>
          <div style="margin-top:10px;"><a href="/pages/click-and-collect" class="btn btn-outline" style="gap:9px; width:100%">Click &amp; Collect &mdash; free</a></div>

          <div style="margin-top:18px; padding-top:16px; border-top:1px solid #eceee9;">
            <label for="cart-discount-code" style="display:block; font-size:13.5px; font-weight:700; color:#2A2B2A; margin-bottom:8px;">Discount code</label>
            <div style="display:flex; gap:8px;">
              <input type="text" id="cart-discount-code" placeholder="Enter code" class="cart-discount-input" style="flex:1 1 auto; height:44px; border:1px solid #dfe1dc; border-radius:9px; padding:0 14px; font-family:inherit; font-size:15px; color:#2A2B2A; outline:none; min-width:0;">
              <button type="button" data-discount-apply class="btn btn-fill" style="flex:0 0 auto">Apply</button>
            </div>
          </div>
        </div>
        <div style="margin-top:16px; display:flex; flex-direction:column; gap:11px; padding:0 4px;">
          <div style="display:flex; gap:10px; align-items:flex-start; font-size:13.5px; line-height:1.6; color:#666b60;"><span style="color:var(--c-accent); font-weight:800;">&check;</span><span>Free delivery on orders over {% render 'free-delivery-amount' %}</span></div>
          {% render 'buy-assurance', compact: true %}
        </div>
      </aside>
    </div>

    {%- endif -%}
  </section>
</div>

{% style %}
  .cart-step:hover { background: #eef2e8 !important; }
  .cart-remove:hover { color: #a33 !important; border-color: #a33 !important; }
  .cart-discount-input:focus { border-color:var(--c-primary-text) !important; }
  /* Health answers, folded: the summary is the 44px tap target. */
  .cart-health summary { display: flex; align-items: center; min-height: 44px; font-size: 13.5px; font-weight: 700; color: var(--c-primary-text); cursor: pointer; }
  .cart-health-list { display: flex; flex-direction: column; gap: 6px; padding: 2px 0 6px; }
  /* Medicine tick box: the same inline error as the questionnaire (.pq-error,
     .pq-has-error), not the browser's bubble. */
  .cart-medicine-err { margin: 10px 0 0 31px; color: var(--c-error); font-size: 13px; font-weight: 600; }
  [data-medicine-declaration].is-invalid { border-color: var(--c-error) !important; }
  [data-medicine-declaration].is-invalid label span { color: var(--c-error); }
  @media (max-width: 1080px) {
    .cart-wrap { align-items: stretch !important; flex-direction: column !important; gap: 30px !important; }
    .cart-side { flex: 1 1 auto !important; width: 100% !important; position: static !important; top: auto !important; }
  }
  @media (max-width: 620px) {
    .cart-row { flex-wrap: wrap !important; gap: 16px !important; }
    .cart-row > a:first-child { width: 88px !important; height: 88px !important; }
    .cart-row > div:last-child { width: 100% !important; text-align: left !important; }
  }
{% endstyle %}

<script>
  (() => {
    // Line quantity steppers -> cart change route, then reload to re-render
    // totals. Route comes from Liquid so this survives a locale or market path
    // prefix (/en-ie/cart/change.js), same as the add-to-cart handler.
    const changeUrl = ((window.mccRoutes || {}).cart_change_url || '/cart/change') + '.js';
    document.addEventListener('click', async e => {
      const btn = e.target.closest('[data-line-qty]');
      if (!btn) return;
      e.preventDefault(); // Remove is a link, for the no-JS route
      btn.disabled = true;
      try {
        await fetch(changeUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ line: parseInt(btn.dataset.line, 10), quantity: parseInt(btn.dataset.lineQty, 10) }),
        });
      } catch (err) { /* fall through to reload; server state wins */ }
      // The reload drops focus on <body>. Remember which control was pressed, by line
      // key, so a keyboard user lands back on it (or on the next line's, if it went).
      try {
        const row = btn.closest('[data-line-key]');
        sessionStorage.setItem('mcc-cart-focus', JSON.stringify({ key: row && row.dataset.lineKey, label: btn.getAttribute('aria-label') }));
      } catch (err) { /* storage blocked: focus simply is not restored */ }
      location.reload();
    });
    try {
      const saved = JSON.parse(sessionStorage.getItem('mcc-cart-focus') || 'null');
      sessionStorage.removeItem('mcc-cart-focus');
      if (saved) {
        const row = saved.key && document.querySelector('[data-line-key="' + CSS.escape(saved.key) + '"]');
        const target = (row && row.querySelector('[aria-label="' + CSS.escape(saved.label || '') + '"]'))
          || document.querySelector('.cart-step') || document.querySelector('main h1');
        if (target) { if (!target.matches('a, button')) target.tabIndex = -1; target.focus(); }
      }
    } catch (err) { /* nothing saved */ }

    // Medicine tick box: replace the browser's validation bubble with the inline error
    // the questionnaire uses. 'invalid' fires only on a submit the browser is already
    // blocking, so preventDefault here hides the bubble and nothing else; without JS
    // the required attribute still blocks with the bubble.
    const tick = document.querySelector('[data-medicine-tick]');
    if (tick) {
      const box = tick.closest('[data-medicine-declaration]');
      const err = box.querySelector('[data-medicine-err]');
      tick.addEventListener('invalid', (e) => {
        e.preventDefault();
        box.classList.add('is-invalid');
        err.hidden = false;
        tick.setAttribute('aria-invalid', 'true');
        tick.focus();
      });
      tick.addEventListener('change', () => {
        if (!tick.checked) return;
        box.classList.remove('is-invalid');
        err.hidden = true;
        tick.removeAttribute('aria-invalid');
      });
    }

    // Discount code -> Shopify discount URL, back to the bag
    const apply = document.querySelector('[data-discount-apply]');
    if (apply) apply.addEventListener('click', () => {
      const code = document.getElementById('cart-discount-code').value.trim();
      if (code) location.href = '/discount/' + encodeURIComponent(code) + '?redirect=/cart';
    });
  })();
</script>

{% schema %}
{
  "name": "Cart",
  "presets": [{ "name": "Cart" }]
}
{% endschema %}
