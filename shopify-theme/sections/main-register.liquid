{% render 'trust-row' %}
<section style="max-width:1440px; margin:0 auto; padding:40px 30px 20px;">
  <div class="auth-wrap" style="display:flex; gap:44px; align-items:stretch; max-width:1000px; margin:0 auto;">
    <div style="flex:1 1 460px; min-width:0;">
      <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
        <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(25px,2.8vw,33px); line-height:1.12; margin:0 0 10px;">Create an account</h1>
        <p style="margin:0 0 24px; font-size:15.5px; line-height:1.65; color:#4a4d47;">You must be 18 or over to register. It takes a minute.</p>
        {% form 'create_customer' %}
          {% render 'form-errors', form: form %}
          <div style="display:flex; flex-wrap:wrap; gap:16px;">
            <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">First name</span>
              <input type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}" class="acct-input" style="height:50px; border:1px solid #dfe1dc; border-radius:9px; padding:0 14px; font-family:inherit; font-size:15.5px; color:#2A2B2A; outline:none;">
            </label>
            <label style="flex:1 1 240px; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Last name</span>
              <input type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}" class="acct-input" style="height:50px; border:1px solid #dfe1dc; border-radius:9px; padding:0 14px; font-family:inherit; font-size:15.5px; color:#2A2B2A; outline:none;">
            </label>
            <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Email address</span>
              <input type="email" name="customer[email]" required autocomplete="email" placeholder="you@example.com" value="{{ form.email }}" class="acct-input" style="height:50px; border:1px solid #dfe1dc; border-radius:9px; padding:0 14px; font-family:inherit; font-size:15.5px; color:#2A2B2A; outline:none;">
            </label>
            <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Password</span>
              <input type="password" name="customer[password]" required autocomplete="new-password" class="acct-input" style="height:50px; border:1px solid #dfe1dc; border-radius:9px; padding:0 14px; font-family:inherit; font-size:15.5px; color:#2A2B2A; outline:none;">
              <span style="font-size:12.5px; color:#6b7065;">At least 8 characters, with a number</span>
            </label>
          </div>
          <div style="display:flex; flex-direction:column; gap:12px; margin:18px 0 22px;">
            <label style="display:flex; align-items:flex-start; gap:11px; font-size:14px; line-height:1.6; color:#3a3d39;">
              <input type="checkbox" required style="margin-top:3px; accent-color:var(--c-primary-text); width:17px; height:17px;">
              <span>I confirm I am 18 or over and I accept the <a href="/pages/terms-and-conditions" style="font-weight:700;">Terms &amp; Conditions</a> and <a href="/pages/privacy-policy" style="font-weight:700;">Privacy Policy</a>.</span>
            </label>
            <label style="display:flex; align-items:flex-start; gap:11px; font-size:14px; line-height:1.6; color:#3a3d39;">
              <input type="checkbox" name="customer[accepts_marketing]" value="true" style="margin-top:3px; accent-color:var(--c-primary-text); width:17px; height:17px;">
              <span>Email me health advice and offers. Unsubscribe any time.</span>
            </label>
          </div>
          <button type="submit" class="hov-bg-green-dk" style="display:inline-flex; align-items:center; justify-content:center; gap:9px; height:52px; padding:0 26px; border-radius:10px; border:none; cursor:pointer; background:var(--c-primary); color:var(--c-on-primary); font-weight:800; font-size:15.5px; width:100%;">Create account</button>
        {% endform %}
        <div style="text-align:center; font-size:14.5px; color:#6b7065; margin-top:18px;">Already have an account? <a href="{{ routes.account_login_url }}" style="font-weight:700;">Sign in</a></div>
      </div>
    </div>
    {% render 'account-aside' %}
  </div>
</section>

{% style %}
  .acct-input:focus { border-color:var(--c-primary-text) !important; }
  @media (max-width: 1000px) {
    .auth-wrap { align-items: stretch !important; flex-direction: column !important; gap: 26px !important; }
    .auth-side { flex: 1 1 auto !important; width: 100% !important; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Customer register",
  "presets": [{ "name": "Customer register" }]
}
{% endschema %}
