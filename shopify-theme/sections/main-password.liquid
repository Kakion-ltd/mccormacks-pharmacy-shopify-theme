{% style %}
  .pw-input:focus { border-color: #92C83F !important; box-shadow: 0 0 0 4px rgba(146,200,63,.15); }
{% endstyle %}

<div style="min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:40px 24px; background:#f6f8f2;">
  <div style="width:100%; max-width:460px; background:#ffffff; border:1px solid #e6e7e4; border-radius:18px; padding:40px 36px; text-align:center; box-shadow:0 18px 40px rgba(0,0,0,.06);">
    <img src="{{ 'mccormacks-logo.png' | asset_url }}" alt="{{ shop.name }}" style="width:200px; max-width:100%; height:auto; display:block; margin:0 auto 22px;" width="1887" height="473">
    <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(24px,3vw,30px); line-height:1.15; margin:0 0 10px;">{{ section.settings.heading }}</h1>
    <p style="margin:0 0 26px; font-size:15.5px; line-height:1.65; color:#4a4d47;">{{ section.settings.subtext }}</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <div role="alert" style="background:#FBEAE9; border:1.5px solid #B3261E; color:#B3261E; border-radius:8px; padding:12px 14px; font-weight:700; font-size:14px; margin-bottom:14px;">{{ form.errors.messages['form'] }}</div>
      {%- endif -%}
      <div style="display:flex; flex-wrap:wrap; gap:10px;">
        <input type="password" name="password" placeholder="Store password" required class="pw-input" style="flex:1 1 220px; min-width:0; height:52px; border:1.5px solid #dfe1dc; border-radius:10px; padding:0 16px; font-family:inherit; font-size:15.5px; color:#2A2B2A; outline:none; transition:border-color .18s, box-shadow .18s;">
        <button type="submit" class="hov-bg-green-dk" style="flex:0 0 auto; height:52px; padding:0 26px; border:none; border-radius:10px; background:#82C914; color:#ffffff; font-family:inherit; font-weight:800; font-size:15px; cursor:pointer;">Enter</button>
      </div>
    {%- endform -%}

    <div style="margin-top:26px; padding-top:20px; border-top:1px solid #eceee9; font-size:13.5px; color:#8b9182; line-height:1.7;">
      Call us: <a href="tel:0526199329" class="hov-green-dk" style="font-weight:700;">052 6199329</a><br>
      <a href="mailto:info@mccormackspharmacy.ie" class="hov-green-dk">info@mccormackspharmacy.ie</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're getting ready" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Our new online pharmacy is coming soon. Enter the store password to take a look around." }
  ],
  "presets": [{ "name": "Password page" }]
}
{% endschema %}
