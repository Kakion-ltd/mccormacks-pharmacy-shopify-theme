{% render 'trust-row' %}

{% style %}
  @media (max-width: 1040px) {
    .co-wrap { align-items: stretch !important; flex-direction: column !important; gap: 28px !important; }
    .co-side { flex: 1 1 auto !important; width: 100% !important; position: static !important; top: auto !important; }
  }
{% endstyle %}

<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
  <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 16px;">
    <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><span style="color:#3a3d39; font-weight:700;">About Us</span>
  </nav>
  <div class="co-wrap" style="display:flex; gap:44px; align-items:flex-start;">
    <div style="flex:1 1 auto; min-width:0; max-width:760px;">
      <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(28px,3.2vw,42px); line-height:1.08; margin:0 0 12px;">{{ section.settings.heading }}</h1>
      <p style="margin:0 0 26px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ section.settings.intro }}</p>
      {%- comment -%} 13:6 (was 16:7) — consolidated with the category banner so both
          share one export. The fallback asset is re-exported to match. {%- endcomment -%}
      <div style="width:100%; aspect-ratio:13/6; border-radius:16px; overflow:hidden; background:#f4f5f2; margin:0 0 8px;">
        {%- assign about_style = 'width:100%; height:100%; object-fit:cover; display:block;' -%}
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1520 | image_tag:
               widths: '500,760,1100,1520', sizes: '(max-width: 900px) 92vw, 53vw',
               alt: "McCormack's Pharmacy storefront", loading: 'lazy', style: about_style }}
        {%- else -%}
          <img src="{{ 'our-stores.jpg' | asset_url }}" alt="McCormack's Pharmacy storefront"
               loading="lazy" width="1254" height="579" style="{{ about_style }}">
        {%- endif -%}
      </div>
      <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,28px); margin:36px 0 16px;">What we stand for</h2>
      <p style="margin:0 0 15px; font-size:16px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">A pharmacy is not a supermarket shelf. Most of what we sell has an effect on someone&rsquo;s health, which is why there is always a pharmacist available to talk it through &mdash; whether you are spending &euro;5 or &euro;50, in store or on the phone.</p>
      <p style="margin:0 0 15px; font-size:16px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">We stock what we would recommend. If a product does not do what it claims, we do not carry it. And if the answer to your question is &ldquo;you should see your GP&rdquo;, we will say so rather than sell you something.</p>
      <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,28px); margin:36px 0 16px;">The team</h2>
      <p style="margin:0 0 15px; font-size:16px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">Our pharmacists are registered with the Pharmaceutical Society of Ireland and are supported by trained pharmacy technicians, healthcare assistants and beauty advisors. Several of our team have been with us for over a decade, and many live in the towns they serve.</p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px; margin:22px 0 0;">
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:20px 22px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:30px; color:#3f6b4f; line-height:1;">7</div>
          <div style="font-size:14.5px; font-weight:700; color:#2A2B2A; margin:8px 0 3px;">pharmacies</div>
          <div style="font-size:13px; line-height:1.55; color:#6b7065;">Tipperary to Mayo</div>
        </div>
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:20px 22px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:30px; color:#3f6b4f; line-height:1;">40+</div>
          <div style="font-size:14.5px; font-weight:700; color:#2A2B2A; margin:8px 0 3px;">team members</div>
          <div style="font-size:13px; line-height:1.55; color:#6b7065;">Pharmacists, technicians and advisors</div>
        </div>
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:20px 22px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:30px; color:#3f6b4f; line-height:1;">1982</div>
          <div style="font-size:14.5px; font-weight:700; color:#2A2B2A; margin:8px 0 3px;">first store</div>
          <div style="font-size:13px; line-height:1.55; color:#6b7065;">Bolton Street, Clonmel</div>
        </div>
      </div>
      <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,28px); margin:36px 0 16px;">Regulated, and proud of it</h2>
      <p style="margin:0 0 15px; font-size:16px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">Every one of our pharmacies is a registered retail pharmacy business, and we are on the PSI Register of Internet Supply Pharmacies. That means the medicines we sell online are supplied from a real pharmacy, by real pharmacists, under Irish law. You can <a href="/pages/internet-supply-pharmacy" class="hov-green-dk" style="font-weight:700;">read more about our registration</a>.</p>
    </div>
    <aside class="co-side" style="flex:0 0 330px; width:330px; position:sticky; top:20px;">
      <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
        <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:18px; color:#3f6b4f; margin:0 0 14px;">Get in touch</div>
        <div style="display:flex; flex-direction:column; gap:12px; font-size:14.5px; line-height:1.7; color:#3a3d39;">
          <div><span style="display:block; font-size:12px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#8b9182; margin-bottom:3px;">Phone</span><a href="tel:0526199329" class="hov-green-dk" style="font-weight:700;">052 6199329</a></div>
          <div><span style="display:block; font-size:12px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#8b9182; margin-bottom:3px;">Email</span><a href="mailto:info@mccormackspharmacy.ie" class="hov-green-dk" style="font-weight:700; word-break:break-word;">info@mccormackspharmacy.ie</a></div>
          <div><span style="display:block; font-size:12px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#8b9182; margin-bottom:3px;">Head office</span>Clonmel, Co. Tipperary</div>
        </div>
        <div style="margin-top:18px;"><a href="/pages/contact-us" class="hov-bg-green-dk" style="display:inline-flex; align-items:center; justify-content:center; gap:9px; height:52px; padding:0 26px; border-radius:10px; background:#82C914; color:#ffffff; font-weight:800; font-size:15.5px; width:100%;">Contact us</a></div></div>
      <div style="margin-top:16px; padding:22px 24px; border-radius:16px; background:#3f6b4f; color:#ffffff;">
        <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:18px; margin:0 0 8px;">Work with us</div>
        <div style="font-size:14px; line-height:1.65; color:#d6e2cd; margin:0 0 16px;">We are usually looking for pharmacists, technicians and retail staff across our stores.</div>
        <a href="/pages/careers" class="hov-bg-accent-dk" style="display:flex; align-items:center; justify-content:center; height:46px; border-radius:9px; background:#92C83F; color:#ffffff; font-weight:800; font-size:15px;">See open roles</a>
      </div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "About Us",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A family pharmacy, since 1982" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "McCormack’s has grown from a single counter in Clonmel to seven pharmacies — in Tipperary, Limerick, Kildare, Offaly, Louth and Mayo — and a busy online pharmacy serving the whole country." },
    { "type": "image_picker", "id": "image", "label": "Storefront image" }
  ],
  "presets": [{ "name": "About Us" }]
}
{% endschema %}
