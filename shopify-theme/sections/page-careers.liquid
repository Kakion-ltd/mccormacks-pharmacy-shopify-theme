{% render 'trust-row' %}

{% style %}
  @media (max-width: 1040px) {
    .co-wrap { align-items: stretch !important; flex-direction: column !important; gap: 28px !important; }
    .co-side { flex: 1 1 auto !important; width: 100% !important; position: static !important; top: auto !important; }
  }
  .careers-input { height: 50px; border: 1px solid #dfe1dc; border-radius: 9px; padding: 0 14px; font-family: inherit; font-size: 15.5px; color: #2A2B2A; outline: none; }
  .careers-input:focus { border-color: #82C914; }
  .hov-border-accent-only:hover { border-color: #92C83F !important; }
{% endstyle %}

<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
  <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 16px;">
    <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><span style="color:#3a3d39; font-weight:700;">Careers</span>
  </nav>
  <div class="co-wrap" style="display:flex; gap:44px; align-items:flex-start;">
    <div style="flex:1 1 auto; min-width:0; max-width:760px;">
      <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(28px,3.2vw,42px); line-height:1.08; margin:0 0 12px;">{{ section.settings.heading }}</h1>
      <p style="margin:0 0 26px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ section.settings.intro }}</p>
      <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,28px); margin:36px 0 16px;">Open roles</h2>
      <div style="border-top:1px solid #e6e7e4;">
        {%- for block in section.blocks -%}
          <div class="job-row" {{ block.shopify_attributes }} style="display:flex; flex-wrap:wrap; align-items:center; gap:14px 24px; padding:20px 0; border-bottom:1px solid #e6e7e4;">
            <div style="flex:1 1 260px; min-width:0;">
              <div style="display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-bottom:5px;">
                <span style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:17.5px; color:#3f6b4f;">{{ block.settings.title }}</span>
                {%- if block.settings.is_new -%}
                  <span style="display:inline-flex; align-items:center; height:23px; padding:0 9px; border-radius:6px; background:#92C83F; color:#ffffff; font-size:11px; font-weight:800;">New</span>
                {%- endif -%}
              </div>
              <div style="font-size:14.5px; color:#6b7065;">{{ block.settings.location }}</div>
            </div>
            <div style="flex:0 0 auto; font-size:14px; font-weight:700; color:#3a3d39;">{{ block.settings.job_type }}</div>
            <a href="{{ block.settings.link | default: '#careers-apply' }}" class="hov-border-accent-only" style="flex:0 0 auto; display:inline-flex; align-items:center; height:44px; padding:0 20px; border-radius:9px; border:1.5px solid #cdd3c5; color:#3f6b4f; font-weight:700; font-size:14px;">View role</a>
          </div>
        {%- endfor -%}
      </div>
      <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,28px); margin:36px 0 16px;">What we offer</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:16px; margin:0 0 8px;">
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:20px 22px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:16.5px; color:#3f6b4f; margin-bottom:6px;">Staff discount</div>
          <div style="font-size:14px; line-height:1.65; color:#5d6159;">Across the full range, in store and online.</div>
        </div>
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:20px 22px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:16.5px; color:#3f6b4f; margin-bottom:6px;">Paid CPD</div>
          <div style="font-size:14px; line-height:1.65; color:#5d6159;">Study support and paid time for professional development.</div>
        </div>
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:20px 22px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:16.5px; color:#3f6b4f; margin-bottom:6px;">Stable rotas</div>
          <div style="font-size:14px; line-height:1.65; color:#5d6159;">Published in advance, with no late-night trading.</div>
        </div>
        <div style="border:1px solid #e6e7e4; border-radius:14px; padding:20px 22px; background:#fbfcfa;">
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:16.5px; color:#3f6b4f; margin-bottom:6px;">Progression</div>
          <div style="font-size:14px; line-height:1.65; color:#5d6159;">Most of our supervising pharmacists were promoted internally.</div>
        </div>
      </div>
      <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,28px); margin:36px 0 16px;">Nothing suitable right now?</h2>
      <p style="margin:0 0 15px; font-size:16px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">Send us your CV anyway. We keep applications on file for six months and often fill roles before they are advertised.</p>
    </div>
    <aside id="careers-apply" class="co-side" style="flex:0 0 330px; width:330px; position:sticky; top:20px; scroll-margin-top:120px;">
      <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
        <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:18px; color:#3f6b4f; margin:0 0 6px;">Apply</div>
        <div style="font-size:14px; line-height:1.65; color:#6b7065; margin:0 0 18px;">Send your CV and we will be in touch if there is a fit.</div>
        {%- form 'contact' -%}
          <input type="hidden" name="contact[form_type]" value="careers-application">
          {%- if form.posted_successfully? -%}
            <div style="background:#EEF6E4; border:1px solid #d8e9c2; border-radius:12px; padding:14px 16px; margin:0 0 14px; color:#5E8A1F; font-size:14px; line-height:1.6; font-weight:700;">Thanks — your application has been received.</div>
          {%- endif -%}
          {%- if form.errors -%}
            <div style="background:#FBEAE9; border:1px solid #ecc8c5; border-radius:12px; padding:14px 16px; margin:0 0 14px; color:#B3261E; font-size:14px; line-height:1.6;">
              {%- for field in form.errors -%}
                <div>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</div>
              {%- endfor -%}
            </div>
          {%- endif -%}
          <div style="display:flex; flex-direction:column; gap:14px;">
            <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Your name</span>
              <input class="careers-input" type="text" name="contact[name]" placeholder="">
            </label>
            <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Email address</span>
              <input class="careers-input" type="email" name="contact[email]" required placeholder="">
            </label>
            <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Phone number</span>
              <input class="careers-input" type="tel" name="contact[phone]" placeholder="">
            </label>
            <label style="display:flex; flex-direction:column; gap:7px;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Role of interest</span>
              <select class="careers-input" name="contact[role_of_interest]" style="padding:0 12px; background:#ffffff;">
                {%- for block in section.blocks -%}
                  <option>{{ block.settings.title }}</option>
                {%- endfor -%}
                <option>Speculative application</option>
              </select>
            </label>
            {%- comment -%} File upload requires an app — Shopify contact forms cannot accept attachments. Upload UI rendered disabled per the design. {%- endcomment -%}
            <div style="border:1.5px dashed #cdd3c5; border-radius:12px; padding:18px; text-align:center; background:#fbfcfa;">
              <div style="font-size:13.5px; font-weight:700; color:#2A2B2A; margin-bottom:4px;">Attach your CV</div>
              <div style="font-size:12.5px; color:#6b7065; margin-bottom:12px;">PDF or Word, up to 5MB</div>
              <button type="button" disabled style="display:inline-flex; align-items:center; height:40px; padding:0 18px; border:none; border-radius:8px; background:#82C914; color:#ffffff; font-weight:800; font-size:13.5px; opacity:.55; cursor:not-allowed;">Choose a file</button>
              <div style="font-size:11.5px; color:#8b9182; margin-top:8px;">Uploads coming soon — email your CV to info@mccormackspharmacy.ie for now.</div>
            </div>
          </div>
          <div style="margin-top:18px;"><button type="submit" class="hov-bg-green-dk" style="display:inline-flex; align-items:center; justify-content:center; gap:9px; height:52px; padding:0 26px; border:none; cursor:pointer; border-radius:10px; background:#82C914; color:#ffffff; font-weight:800; font-size:15.5px; width:100%;">Send application</button></div>
        {%- endform -%}
      </div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Careers",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Work at McCormack’s" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "We are a family business, and it shows in how we hire. If you like the idea of knowing your customers and being trusted to use your judgement, we would like to hear from you." }
  ],
  "blocks": [
    {
      "type": "role",
      "name": "Open role",
      "settings": [
        { "type": "text", "id": "title", "label": "Role title", "default": "Pharmacist" },
        { "type": "text", "id": "location", "label": "Location", "default": "Clonmel — Bolton Street" },
        { "type": "text", "id": "job_type", "label": "Employment type", "default": "Full time" },
        { "type": "checkbox", "id": "is_new", "label": "Show 'New' badge", "default": false },
        { "type": "url", "id": "link", "label": "Role details link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Careers",
      "blocks": [
        { "type": "role", "settings": { "title": "Pharmacist", "location": "Clonmel — Bolton Street", "job_type": "Full time", "is_new": true } },
        { "type": "role", "settings": { "title": "Pharmacy Technician", "location": "Newbridge, Co. Kildare", "job_type": "Full time" } },
        { "type": "role", "settings": { "title": "Retail Assistant", "location": "Tullamore, Co. Offaly", "job_type": "Part time" } },
        { "type": "role", "settings": { "title": "Beauty Advisor", "location": "Haggardstown, Dundalk", "job_type": "Full time", "is_new": true } },
        { "type": "role", "settings": { "title": "Dispensary Support", "location": "Ballylanders, Co. Limerick", "job_type": "Part time" } }
      ]
    }
  ]
}
{% endschema %}
