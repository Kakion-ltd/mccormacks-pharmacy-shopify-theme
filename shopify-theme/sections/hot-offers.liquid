{%- comment -%}
  Hot offers: one spotlight deal plus compact rows.

  The FIRST block renders as the spotlight — the month's headline deal, led by
  the Deal field in display type, taking the left two thirds with its image
  bleeding to the card edge. Every block after it renders as a compact card
  stacked in the right third; that column sets the height, so the spotlight is
  never taller than the offers beside it. One block is just the spotlight at
  full width; the section never assumes three offers.

  Urgency is opt-in: the Ends field renders only when someone typed a date,
  so the section cannot claim "limited time" forever by default. Seasonal
  rotation is manual — see setup/MAINTENANCE.md.
{%- endcomment -%}
<section style="max-width:1440px; margin:0 auto; padding:34px 30px 8px;">
  <h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(22px,2.2vw,28px); margin:0 0 22px;">{{ section.settings.heading }}</h2>
  {%- comment -%} Spotlight left, the other offers stacked in the right column. The row
      column sets the height, so the spotlight is exactly as tall as the offers beside it
      and never taller than its copy needs. One block: the spotlight takes the full width. {%- endcomment -%}
  {%- assign row_count = section.blocks.size | minus: 1 | at_least: 1 -%}
  <div class="hot-stack" style="display:grid; grid-template-columns:{% if section.blocks.size > 1 %}minmax(0,2fr) minmax(0,1fr){% else %}minmax(0,1fr){% endif %}; grid-auto-rows:1fr; gap:16px;">
    {%- for block in section.blocks -%}
      {%- liquid
        assign bg = block.settings.background
        assign tile_url = block.settings.link | default: routes.collections_url

        # The tile colour is picked per block in the editor, so the text on it cannot be a
        # fixed white — the default lime gives 2.04:1, well under WCAG AA. Derive it from
        # perceived brightness so any colour a merchant picks stays legible.
        assign tile_fg = '#ffffff'
        assign tile_b = bg | color_brightness
        if tile_b > 145
          assign tile_fg = '#2A2B2A'
        endif
      -%}
      {%- if forloop.first -%}
      <div class="hot-spot" style="grid-row:1 / span {{ row_count }}; position:relative; overflow:hidden; background:{{ bg }}; border-radius:18px; color:{{ tile_fg }}; display:flex; align-items:center; padding:36px 40px; min-height:240px;" {{ block.shopify_attributes }}>
        {%- comment -%} flex-basis 0 0 50%, not 1 1 360px: in the mobile column layout a 360px basis
            became a 360px minimum height and left 150px of empty tile under the button. {%- endcomment -%}
        <div class="hot-spot-copy" style="position:relative; z-index:2; flex:0 0 40%; max-width:40%; min-width:0;">
          {%- if block.settings.deal != blank -%}
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:clamp(26px,3vw,40px); line-height:1.04; margin:0 0 8px;">{{ block.settings.deal }}</div>
          {%- endif -%}
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:clamp(19px,1.8vw,22px); line-height:1.15; margin:0 0 8px;">{{ block.settings.title }}</div>
          {%- if block.settings.subtext != blank -%}
          <p style="margin:0 0 18px; font-size:14.5px; opacity:.93; line-height:1.5; max-width:44ch;">{{ block.settings.subtext }}</p>
          {%- endif -%}
          <a href="{{ tile_url }}" class="hov-bg-tint2" style="display:inline-flex; align-items:center; justify-content:center; gap:8px; background:#fff; color:var(--c-dark); font-weight:800; letter-spacing:.03em; font-size:14.5px; padding:13px 22px; border-radius:8px;">{{ block.settings.cta }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          {%- if block.settings.ends != blank -%}
          <div style="margin-top:12px; font-size:13px; font-weight:700; opacity:.85;">{{ block.settings.ends }}</div>
          {%- endif -%}
        </div>
        {%- comment -%} The image bleeds to the card's top, right and bottom edges, so its own
            background is never seen as a rectangle. Any ground works. {%- endcomment -%}
        <div class="hot-spot-img" style="position:absolute; top:0; right:0; bottom:0; width:58%; z-index:1;">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1500 | image_tag:
               widths: '500,800,1200,1500',
               sizes: '(max-width: 900px) 100vw, 38vw',
               alt: block.settings.title,
               loading: 'lazy',
               style: 'position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;' }}
          {%- elsif block.settings.image_asset != blank -%}
            <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="1500" height="800" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;">
          {%- else -%}
            {%- render 'image-placeholder', w: 1500, h: 800, label: 'Offer image · 1500 × 800', note: 'Subject centred — phones crop to a 2:1 band.' -%}
          {%- endif -%}
        </div>
      </div>
      {%- else -%}
      <div class="hot-row" style="display:flex; align-items:center; gap:16px; background:{{ bg }}; border-radius:14px; padding:16px 18px; color:{{ tile_fg }};" {{ block.shopify_attributes }}>
        <div class="hot-row-img" style="flex:0 0 96px; aspect-ratio:1; border-radius:10px; overflow:hidden; position:relative;">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 240 | image_tag:
               alt: block.settings.title,
               loading: 'lazy',
               style: 'position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;' }}
          {%- elsif block.settings.image_asset != blank -%}
            <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="240" height="240" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;">
          {%- else -%}
            <div title="Upload 600 &times; 600 px" style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:repeating-linear-gradient(135deg, rgba(255,255,255,.16), rgba(255,255,255,.16) 8px, rgba(255,255,255,.07) 8px, rgba(255,255,255,.07) 16px);" role="img" aria-label="Offer image placeholder — upload 600 by 600 pixels"><span style="font-size:10px; font-weight:800; letter-spacing:.06em; opacity:.85;">600 &times; 600</span></div>
          {%- endif -%}
        </div>
        <div style="flex:1 1 auto; min-width:0;">
          {%- if block.settings.deal != blank -%}
          <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:22px; line-height:1.1;">{{ block.settings.deal }}</div>
          {%- endif -%}
          <div style="font-size:15px; font-weight:700; line-height:1.3; opacity:.92; margin-top:3px;">{{ block.settings.title }}</div>
          {%- if block.settings.ends != blank -%}
          <div style="font-size:12.5px; font-weight:700; opacity:.85; margin-top:3px;">{{ block.settings.ends }}</div>
          {%- endif -%}
          <a href="{{ tile_url }}" class="hov-underline-off" style="display:inline-flex; align-items:center; gap:6px; margin-top:8px; color:inherit; font-weight:800; font-size:14px; text-decoration:underline; text-underline-offset:3px;">{{ block.settings.cta }}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% style %}
.hov-underline-off:hover { text-decoration: none; }
@media (max-width: 900px) {
  /* One column. Spotlight stacks: 2:1 image band on top, copy below. Rows keep
     their shape with a smaller thumb. */
  .hot-stack { grid-template-columns: minmax(0,1fr) !important; grid-auto-rows: auto !important; gap: 12px !important; }
  .hot-spot { grid-row: auto !important; flex-direction: column !important; align-items: stretch !important; padding: 0 !important; min-height: 0 !important; }
  .hot-spot-img { order: -1; position: relative !important; width: 100% !important; aspect-ratio: 2 / 1; }
  .hot-spot-copy { flex: 0 0 auto !important; max-width: none !important; padding: 18px 20px 22px; }
  .hot-row { padding: 12px 14px !important; gap: 12px !important; }
  .hot-row-img { flex-basis: 72px !important; }
}
{% endstyle %}

{% schema %}
{
  "name": "Hot offers",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hot Offers" },
    { "type": "paragraph", "content": "The first offer is the spotlight — the month's headline deal, shown large on the left and led by its Deal text. Every offer after it renders as a compact card stacked on the right. One offer is fine: the spotlight takes the full width." }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        { "type": "text", "id": "deal", "label": "Deal", "info": "The headline fact, e.g. Save 20% or 3 for €10. Leads the design; leave blank for a plain promotion." },
        { "type": "text", "id": "title", "label": "Title", "default": "Vitamins & Supplements" },
        { "type": "textarea", "id": "subtext", "label": "Subtext", "info": "Shown on the spotlight only." },
        { "type": "text", "id": "ends", "label": "Ends", "info": "Optional, e.g. Until 30 September. Urgency renders only when this is filled in — there is no automatic date handling, so clear it when the offer ends." },
        { "type": "text", "id": "cta", "label": "Button label", "default": "Shop Now" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Spotlight: 1500×800 (15:8), subject centred inside the middle 2:1 band — the panel bleeds to the card edge, so any background works. Rows show a square thumbnail: 600×600, same spec as the popular-category tiles." },
        { "type": "text", "id": "image_asset", "label": "Fallback theme asset (onboarding only)", "info": "Filename of a theme asset used until an image is picked." },
        { "type": "color", "id": "background", "label": "Tile colour", "default": "#82c914" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Hot offers",
      "blocks": [
        { "type": "offer", "settings": { "deal": "Save 20%", "title": "Vitamins & Supplements", "subtext": "Support your daily health & wellbeing — 20% off multivitamins & supplements this month.", "link": "/collections/vitamins", "background": "#82c914" } },
        { "type": "offer", "settings": { "deal": "Save 15%", "title": "Deodorants & Antiperspirants", "subtext": "Stay fresh for less with long-lasting protection, including Mitchum.", "link": "/collections/deodorant", "background": "#3f6b4f" } },
        { "type": "offer", "settings": { "deal": "Save 20%", "title": "Menopause Support", "subtext": "Everyday menopause support, including CanesMeno — all month long.", "link": "/collections/menopause", "background": "#92C83F" } }
      ]
    }
  ]
}
{% endschema %}
