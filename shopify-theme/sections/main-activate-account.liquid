{% render 'trust-row' %}
<section style="max-width:1440px; margin:0 auto; padding:40px 30px 20px;">
  <div class="auth-wrap" style="display:flex; gap:44px; align-items:stretch; max-width:1000px; margin:0 auto;">
    <div style="flex:1 1 460px; min-width:0;">
      <div style="border:1px solid #e6e7e4; border-radius:16px; padding:26px 28px; background:#ffffff;">
        <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:var(--c-dark); font-size:clamp(25px,2.8vw,33px); line-height:1.12; margin:0 0 10px;">Activate your account</h1>
        <p style="margin:0 0 24px; font-size:15.5px; line-height:1.65; color:#4a4d47;">Create a password to activate your account.</p>
        {% form 'activate_customer_password' %}
          {% render 'form-errors', form: form %}
          <div style="display:flex; flex-wrap:wrap; gap:16px;">
            <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Password</span>
              <input type="password" name="customer[password]" required autocomplete="new-password" class="acct-input" style="height:50px; border:1px solid #dfe1dc; border-radius:9px; padding:0 14px; font-family:inherit; font-size:15.5px; color:#2A2B2A; outline:none;">
              <span style="font-size:12.5px; color:#666b60;">At least 8 characters, with a number</span>
            </label>
            <label style="flex:1 1 100%; display:flex; flex-direction:column; gap:7px; min-width:0;">
              <span style="font-size:13.5px; font-weight:700; color:#2A2B2A;">Confirm password</span>
              <input type="password" name="customer[password_confirmation]" required autocomplete="new-password" class="acct-input" style="height:50px; border:1px solid #dfe1dc; border-radius:9px; padding:0 14px; font-family:inherit; font-size:15.5px; color:#2A2B2A; outline:none;">
            </label>
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:12px; margin:22px 0 0;">
            <button type="submit" class="btn btn-fill" style="flex:1 1 auto; gap:9px">Activate account</button>
            <button type="submit" name="decline" class="btn btn-outline" style="flex:1 1 auto; gap:9px">Decline invitation</button>
          </div>
        {% endform %}
      </div>
    </div>
    {% render 'account-aside' %}
  </div>
</section>

{% style %}
  .acct-input:focus { border-color:var(--c-primary-text) !important; }
  .hov-border-only:hover { border-color: var(--c-accent) !important; }
  @media (max-width: 1000px) {
    .auth-wrap { align-items: stretch !important; flex-direction: column !important; gap: 26px !important; }
    .auth-side { flex: 1 1 auto !important; width: 100% !important; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Activate account",
  "presets": [{ "name": "Activate account" }]
}
{% endschema %}
