{% render 'trust-row' %}

<section style="max-width:1440px; margin:0 auto; padding:30px 30px 20px;">
  <div class="legal-wrap" style="display:flex; gap:56px; align-items:flex-start;">

    {% render 'legal-sidebar', active: 'returns', updated_date: section.settings.updated_date, show_help: section.settings.show_help_card, phone: section.settings.help_phone %}

    <div style="flex:1; min-width:0; max-width:820px;">
      <div>
      <nav style="display:flex; flex-wrap:wrap; align-items:center; gap:9px; font-size:13px; color:#8b9182; margin:0 0 14px;">
        <a href="{{ routes.root_url }}" class="hov-green" style="color:#8b9182;">Home</a><span>/</span><span>Shipping &amp; Delivery</span><span>/</span><span style="color:#3a3d39; font-weight:700;">Returns &amp; Refunds</span>
      </nav>
      <h1 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(30px,3.4vw,42px); line-height:1.08; margin:0 0 14px;">{{ section.settings.heading }}</h1>
      <p style="margin:0 0 28px; font-size:17px; line-height:1.65; color:#4a4d47; max-width:64ch; text-wrap:pretty;">{{ section.settings.intro }}</p>
      <div style="height:1px; background:#e6e7e4;"></div><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Returning an unwanted item</h2><ul style="margin:0 0 16px; padding-left:4px; font-size:15.5px; line-height:1.7; color:#3a3d39; list-style:none; display:flex; flex-direction:column; gap:9px;"><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>All unwanted returns must be returned in an unused, as-new condition with your order sheet.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>Once McCormack&rsquo;s Pharmacy receives the returned goods, you will then be automatically refunded if your goods pass inspection.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>If you cancel the order and return the unused item to us after 14 days of delivery of your order, we cannot refund your purchase.</span></li></ul><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">What we cannot refund</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">We regret that we cannot offer a refund on open packs or partially used products. We reserve the right to refuse to refund if goods are not returned in a saleable condition or are damaged.</p><ul style="margin:0 0 16px; padding-left:4px; font-size:15.5px; line-height:1.7; color:#3a3d39; list-style:none; display:flex; flex-direction:column; gap:9px;"><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>Unless faulty, <strong>medicines purchased online &mdash; whether opened or unopened &mdash; cannot be refunded</strong>.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span><strong>Cosmetics products which have been opened</strong> cannot be refunded or exchanged.</span></li><li style="display:flex; gap:11px; align-items:flex-start;"><span style="flex:0 0 auto; margin-top:8px; width:7px; height:7px; border-radius:999px; background:#92C83F;"></span><span>Items that are used and opened will not be replaced and no refund will be issued.</span></li></ul><h3 style="font-weight:800; font-size:16.5px; color:#2A2B2A; margin:24px 0 8px;">Make-up bought online</h3><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">If you wish to return make-up items that you have purchased online, we will accept them back in our McCormack&rsquo;s stores. The items have to be returned in an unopened, unused, resaleable condition when you return them.</p><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Faulty, damaged or incorrect items</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">In the unlikely event that your goods are faulty or have been damaged in transit, McCormack&rsquo;s Pharmacy will replace your items. If you have received the incorrect order, or the product is faulty or damaged when received, the cost of returning the item(s) will be covered by us at McCormack&rsquo;s &mdash; please contact us at your earliest convenience.</p>
      <div style="display:flex; gap:14px; align-items:flex-start; background:#fdf6e9; border:1px solid #f0e2c4; border-radius:14px; padding:18px 20px; margin:0 0 24px;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="#c98a1b" style="flex:0 0 auto; margin-top:2px;"><path d="M12 2 1.5 21h21L12 2Zm0 5.5 6.6 12H5.4L12 7.5Zm-1 3v4.5h2V10.5h-2Zm0 5.8v2h2v-2h-2Z"></path></svg>
        <div>
          <div style="font-weight:800; font-size:16px; color:#8a6210; margin-bottom:4px;">Report issues within 48 hours</div>
          <div style="font-size:14.5px; line-height:1.65; color:#5c4a24;">Please contact us within 48 hours of delivery to report any issues with your order.</div>
        </div>
      </div><h2 style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; color:#3f6b4f; font-size:clamp(21px,2.2vw,27px); line-height:1.2; margin:36px 0 12px;">Refunds</h2><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">Where a refund has been authorised, please allow up to 10 working days for funds to appear in your account. We will not be held responsible for any delays with funds being credited to your account.</p><p style="margin:0 0 14px; font-size:15.5px; line-height:1.75; color:#3a3d39; text-wrap:pretty;">We value your custom and we will endeavour to resolve all queries as quickly as possible. Please do not hesitate to contact us at <a href="tel:0526199329">052 619 9329</a> for any queries you may have.</p>
      </div>

      {% render 'legal-question-card' %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Returns page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Returns & Refunds" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "McCormack’s Pharmacy are happy to accept unwanted goods that are unopened and unused within 14 days from date of delivery." },
    { "type": "text", "id": "updated_date", "label": "Last reviewed date", "default": "12 June 2026" },
    { "type": "checkbox", "id": "show_help_card", "label": "Show pharmacist help card", "default": true },
    { "type": "text", "id": "help_phone", "label": "Help phone number", "default": "052 6199329" }
  ],
  "presets": [{ "name": "Returns page" }]
}
{% endschema %}
