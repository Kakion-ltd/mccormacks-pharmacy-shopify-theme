{%- comment -%} Real, published products only. With none, the section is not drawn at all.
    It used to fall back to eight design cards with invented prices (Cetrine at
    €7.99 against the catalogue's €10.55) and an "Add To Bag" that was really a link.
    That fallback was a live-store defect waiting for the collection to empty.
    coll.products holds only what the Online Store channel can sell, so an
    unpublished product cannot keep the section alive. {%- endcomment -%}
{%- assign coll = collections[section.settings.collection] -%}
{%- if coll.products.size > 0 -%}
<section style="max-width:1440px; margin:0 auto; padding:30px 30px 8px;">
  <h2 style="font-family:var(--font-heading); font-weight:800; color:var(--c-dark); text-align:center; font-size:clamp(24px,2.4vw,32px); margin:0 0 28px;">{{ section.settings.heading }}</h2>
  <div style="position:relative;">
    <div id="sale-{{ section.id }}" style="display:flex; gap:22px; overflow-x:auto; scroll-behavior:smooth; scrollbar-width:none; padding:4px;">
        {%- for product in coll.products limit: section.settings.limit -%}
          {%- capture restricted -%}{%- render 'product-restricted', product: product -%}{%- endcapture -%}
          {%- assign restricted = restricted | strip -%}
          {%- comment -%} Blank unless the price shown is genuinely reduced — see snippets/product-compare-at.liquid. {%- endcomment -%}
          {%- capture was -%}{%- render 'product-compare-at', product: product -%}{%- endcapture -%}
          {%- assign was = was | strip -%}
          <div class="pcard" style="flex:0 0 230px; border:1px solid #eceee9; border-radius:16px; padding:20px; display:flex; flex-direction:column; text-align:center;">
            {%- comment -%} position:relative so the quick-view eye can sit at the
                bottom right of the image ground. {%- endcomment -%}
            <div style="position:relative; margin-bottom:16px;">
            {%- if was != blank -%}<span class="sale-badge">SALE</span>{%- endif -%}
            <a href="{{ product.url }}" style="height:200px; border-radius:9px; background:#ffffff; display:flex; align-items:center; justify-content:center; overflow:hidden;">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 460 | image_tag: style: 'max-width:100%; max-height:100%; object-fit:contain; display:block;', alt: product.title }}
              {%- else -%}
                <div style="width:100%; height:100%; border-radius:9px; background:repeating-linear-gradient(135deg,#f4f5f2,#f4f5f2 10px,#eef0eb 10px,#eef0eb 20px); display:flex; align-items:center; justify-content:center;"><span style="font-family:ui-monospace,monospace; font-size:11px; color:var(--c-primary-text); font-weight:700;">image</span></div>
              {%- endif -%}
            </a>
            {% render 'quick-view-button', product: product, restricted: restricted %}
            </div>
            <h3 style="font-weight:700; font-size:14px; margin:0 0 8px; min-height:42px;"><a href="{{ product.url }}" style="color:inherit;">{{ product.title }}</a></h3>
            <div style="display:flex; justify-content:center; margin-bottom:8px;">{% render 'product-rating', product: product, size: 14 %}</div>
            <div style="display:flex; justify-content:center; align-items:baseline; gap:9px; margin-bottom:16px;"><span style="color:var(--c-primary-text); font-weight:800; font-size:19px;">{{ product.price | money }}</span>{%- if was != blank -%}<span class="price-was">{{ was }}</span>{%- endif -%}</div>
            {%- if product.available and product.has_only_default_variant and restricted != 'true' -%}
              <button data-add-id="{{ product.selected_or_first_available_variant.id }}" class="btn-sm btn-fill" style="margin-top:auto">Add To Bag</button>
            {%- else -%}
              <a href="{{ product.url }}" class="btn-sm btn-fill" style="margin-top:auto">View</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
    </div>
    <button aria-label="Scroll back" data-rail-btn data-rail-back data-rail-target="sale-{{ section.id }}" data-rail-by="-504" class="hov-scroll" style="position:absolute; left:-14px; top:calc(50% - 20px); transform:translateY(-50%); width:44px; height:44px; border-radius:999px; border:1.5px solid #cfd1cc; background:#fff; color:var(--c-primary-text); cursor:pointer; display:none; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(0,0,0,.1);"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"></polyline></svg></button>
    <button aria-label="Scroll forward" data-rail-btn data-rail-target="sale-{{ section.id }}" data-rail-by="504" class="hov-scroll" style="position:absolute; right:-14px; top:calc(50% - 20px); transform:translateY(-50%); width:44px; height:44px; border-radius:999px; border:1.5px solid #cfd1cc; background:#fff; color:var(--c-primary-text); cursor:pointer; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(0,0,0,.1);"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg></button>
  </div>
</section>
{%- elsif request.design_mode -%}
<section style="max-width:1440px; margin:0 auto; padding:30px 30px 8px;">
  <p style="margin:0; padding:18px; border:1.5px dashed #cfd1cc; border-radius:12px; text-align:center; font-size:15px; color:#666b60;">
    <strong>{{ section.settings.heading }}</strong> is hidden: its collection has no products published to the online store. Customers don't see this note.
  </p>
</section>
{%- endif -%}

{% style %}
.hov-scroll:hover { border-color: var(--c-accent) !important; background: #f2f8e9 !important; }
{% endstyle %}

{% schema %}
{
  "name": "On sale products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "On Sale This Month" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 4, "max": 16, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "On sale products" }]
}
{% endschema %}
