{% comment %}
  Account sidebar tab nav. Usage: {% render 'account-sidebar', active: 'dash' %}
  active: 'dash' | 'orders' | 'rx' | 'addr'
{% endcomment %}
{%- assign fi = customer.first_name | slice: 0 | upcase -%}
{%- assign li = customer.last_name | slice: 0 | upcase -%}
{%- capture on_style -%}background:#eef2e8; color:#3f6b4f; font-weight:800; border-left:3px solid #92C83F;{%- endcapture -%}
{%- capture off_style -%}background:transparent; color:#3a3d39; font-weight:600; border-left:3px solid transparent;{%- endcapture -%}
<style>
  .acct-nav-link:hover { background:#f4f6f0 !important; color:#3f6b4f !important; }
</style>
<aside class="acct-side" style="flex:0 0 258px; width:258px;">
  <div style="border:1px solid #e6e7e4; border-radius:16px; padding:20px 14px; background:#ffffff;">
    <div style="display:flex; align-items:center; gap:12px; padding:0 12px 16px; margin:0 0 8px; border-bottom:1px solid #eceee9;">
      <span style="width:42px; height:42px; border-radius:999px; background:#eef2e8; color:#3f6a17; font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:15px; display:flex; align-items:center; justify-content:center;">{{ fi }}{{ li }}</span>
      <span style="min-width:0;">
        <span style="display:block; font-weight:800; font-size:15px; color:#2A2B2A;">{{ customer.first_name }} {{ customer.last_name }}</span>
        <span style="display:block; font-size:12.5px; color:#6b7065; overflow:hidden; text-overflow:ellipsis;">{{ customer.email }}</span>
      </span>
    </div>
    <nav style="display:flex; flex-direction:column; gap:3px;">
      <a href="{{ routes.account_url }}" class="acct-nav-link" style="display:block; padding:11px 14px; border-radius:9px; font-size:14.5px; {% if active == 'dash' %}{{ on_style }}{% else %}{{ off_style }}{% endif %}">Dashboard</a>
      <a href="{{ routes.account_url }}#orders" class="acct-nav-link" style="display:block; padding:11px 14px; border-radius:9px; font-size:14.5px; {% if active == 'orders' %}{{ on_style }}{% else %}{{ off_style }}{% endif %}">Orders</a>
      <a href="/pages/prescriptions" class="acct-nav-link" style="display:block; padding:11px 14px; border-radius:9px; font-size:14.5px; {% if active == 'rx' %}{{ on_style }}{% else %}{{ off_style }}{% endif %}">Prescriptions</a>
      <a href="{{ routes.account_addresses_url }}" class="acct-nav-link" style="display:block; padding:11px 14px; border-radius:9px; font-size:14.5px; {% if active == 'addr' %}{{ on_style }}{% else %}{{ off_style }}{% endif %}">Details &amp; addresses</a>
    </nav>
    <div style="margin:16px 14px 0; padding-top:14px; border-top:1px solid #eceee9;">
      <a href="{{ routes.account_logout_url }}" class="hov-green" style="font-size:14px; font-weight:700; color:#6b7065;">Sign out</a>
    </div>
  </div>
</aside>
