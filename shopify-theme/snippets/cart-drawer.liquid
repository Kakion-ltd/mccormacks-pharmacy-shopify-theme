{% comment %}
  Cart drawer — the exit the funnel was missing.

  Before this, a successful add-to-cart flashed "Added ✓" on the button for 1.6s and
  incremented the header badge. Nothing offered a route to checkout; the shopper had to
  go looking for the bag. This opens on add and puts Checkout one tap away.

  Shell markup mirrors the mobile nav drawer (.mnav-overlay / .mnav-drawer in base.css)
  so the slide-in, the overlay and the visibility-based tab-order handling behave
  identically. Contents are rendered client-side by theme.js from the Cart AJAX API,
  so the drawer stays correct after every add without a page load.

  Threshold comes from settings.free_shipping_threshold (Brand settings), matching
  the cart page's own progress bar.
{% endcomment %}
{%- assign free_threshold = settings.free_shipping_threshold | default: 65 | times: 100 -%}

<div class="cd-overlay" data-cd-overlay hidden></div>

<aside class="cd-drawer" data-cd-drawer role="dialog" aria-modal="true"
       aria-label="Shopping bag" data-cd-threshold="{{ free_threshold }}"
       data-cd-currency="{{ shop.money_format | strip_html | escape }}" hidden>

  <header class="cd-head">
    <h2>Your bag <span data-cd-count>({{ cart.item_count }})</span></h2>
    <button type="button" data-cd-close aria-label="Close bag" class="cd-x">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
    </button>
  </header>

  {%- comment -%} Same message and maths as the cart page summary. {%- endcomment -%}
  <div class="cd-ship" data-cd-ship hidden>
    <div class="cd-ship-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="#82C914" aria-hidden="true"><path d="M3 5.75A1.75 1.75 0 0 1 4.75 4h8.5A1.75 1.75 0 0 1 15 5.75V6h2.6c.5 0 .96.24 1.25.64l2.4 3.3c.16.22.25.49.25.76V15a1.5 1.5 0 0 1-1.5 1.5h-.6a2.75 2.75 0 0 1-5.4 0H10.4a2.75 2.75 0 0 1-5.4 0h-.25A1.75 1.75 0 0 1 3 14.75V5.75Z"></path></svg>
      <span data-cd-ship-msg></span>
    </div>
    <div class="cd-bar"><div data-cd-bar></div></div>
  </div>

  <div class="cd-items" data-cd-items></div>

  <div class="cd-empty" data-cd-empty hidden>
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#92C83F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><path d="M3 6h18"></path><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
    <p>Your bag is empty.</p>
    <a href="{{ routes.root_url }}" class="cd-secondary" data-cd-close>Start shopping</a>
  </div>

  <footer class="cd-foot" data-cd-foot hidden>
    <div class="cd-sub">
      <span>Subtotal</span>
      <span data-cd-subtotal></span>
    </div>
    <p class="cd-vat">Shipping and VAT calculated at checkout</p>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="cd-checkout hov-bg-green-dk">Checkout securely</button>
      {%- comment -%} Same express buttons as the cart page, one step earlier.
          Guarded: with no accelerated methods enabled, Shopify renders nothing and
          the wrapper would otherwise leave a gap. {%- endcomment -%}
      {%- if additional_checkout_buttons -%}
        <div class="cd-express">{{ content_for_additional_checkout_buttons }}</div>
      {%- endif -%}
    </form>
    <a href="{{ routes.cart_url }}" class="cd-secondary">View full bag</a>
  </footer>
</aside>
