{% comment %}
  Shared sidebar for legal / delivery content pages.
  Usage: {% render 'legal-sidebar', active: 'shipping', updated_date: section.settings.updated_date, show_help: section.settings.show_help_card, phone: section.settings.help_phone %}
  active: shipping | returns | click-and-collect | terms | privacy | cookie | isp
{% endcomment %}
{%- assign on_style = 'display:block; padding:11px 14px; border-radius:9px; font-size:14.5px; line-height:1.4; font-weight:800; color:#3f6b4f; background:#eef2e8; border-left:3px solid #92C83F;' -%}
{%- assign off_style = 'display:block; padding:11px 14px; border-radius:9px; font-size:14.5px; line-height:1.4; font-weight:600; color:#3a3d39; background:transparent; border-left:3px solid transparent;' -%}

{% style %}
  .legal-nav-a:hover { background: #f4f6f0 !important; color: var(--c-dark) !important; }
  .legal-help-email:hover { border-color: var(--c-accent) !important; color: var(--c-accent) !important; }
  @media (max-width: 1100px) and (min-width: 901px) {
    .legal-side { flex: 0 0 220px !important; width: 220px !important; }
    .legal-wrap { gap: 34px !important; }
  }
  @media (max-width: 900px) {
    .legal-wrap { align-items: stretch !important; flex-direction: column !important; gap: 26px !important; }
    .legal-side { flex: 1 1 auto !important; width: 100% !important; position: static !important; top: auto !important; }
  }
{% endstyle %}

<aside class="legal-side" style="flex:0 0 274px; width:274px; position:sticky; top:20px;">
  <div style="border:1px solid #e6e7e4; border-radius:16px; padding:20px 14px; background:#ffffff;">
    <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:12.5px; letter-spacing:.08em; text-transform:uppercase; color:#717769; padding:0 14px; margin:0 0 10px;">Shipping &amp; Delivery</div>
    <nav style="display:flex; flex-direction:column; gap:3px; margin:0 0 22px;">
      <a href="/pages/shipping" class="legal-nav-a" style="{% if active == 'shipping' %}{{ on_style }}{% else %}{{ off_style }}{% endif %}">Shipping &amp; Free Delivery</a>
      <a href="/pages/returns" class="legal-nav-a" style="{% if active == 'returns' %}{{ on_style }}{% else %}{{ off_style }}{% endif %}">Returns &amp; Refunds</a>
      <a href="/pages/click-and-collect" class="legal-nav-a" style="{% if active == 'click-and-collect' %}{{ on_style }}{% else %}{{ off_style }}{% endif %}">Click &amp; Collect</a>
    </nav>
    <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:12.5px; letter-spacing:.08em; text-transform:uppercase; color:#717769; padding:0 14px; margin:0 0 10px;">Policies</div>
    <nav style="display:flex; flex-direction:column; gap:3px;">
      <a href="/pages/terms-and-conditions" class="legal-nav-a" style="{% if active == 'terms' %}{{ on_style }}{% else %}{{ off_style }}{% endif %}">Terms &amp; Conditions</a>
      <a href="/pages/privacy-policy" class="legal-nav-a" style="{% if active == 'privacy' %}{{ on_style }}{% else %}{{ off_style }}{% endif %}">Privacy Policy</a>
      <a href="/pages/cookie-policy" class="legal-nav-a" style="{% if active == 'cookie' %}{{ on_style }}{% else %}{{ off_style }}{% endif %}">Cookie Policy</a>
      <a href="/pages/internet-supply-pharmacy" class="legal-nav-a" style="{% if active == 'isp' %}{{ on_style }}{% else %}{{ off_style }}{% endif %}">Registered Internet Supply Pharmacy</a>
    </nav>
    <div style="margin:20px 14px 0; padding-top:16px; border-top:1px solid #eceee9; font-size:12.5px; line-height:1.6; color:#717769;">Last reviewed {{ updated_date }}</div>
  </div>

  {%- if show_help -%}
  <div style="margin-top:16px; border-radius:16px; padding:22px 20px; background:var(--c-dark); color:var(--c-on-dark);">
    <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:18px; margin:0 0 8px;">Talk to a pharmacist</div>
    <div style="font-size:14px; line-height:1.65; color:#d6e2cd; margin:0 0 16px;">Confidential advice on medicines, symptoms or an order &mdash; no appointment needed.</div>
    <a href="tel:{{ phone | remove: ' ' }}" class="hov-bg-accent-dk" style="display:flex; align-items:center; justify-content:center; gap:9px; height:44px; border-radius:9px; background:var(--c-accent); color:var(--c-on-accent); font-weight:800; font-size:15px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2Z"></path></svg>
      {{ phone }}
    </a>
    <a href="/pages/contact-us" class="legal-help-email" style="display:flex; align-items:center; justify-content:center; gap:9px; height:44px; border-radius:9px; border:1.5px solid rgba(255,255,255,.28); color:#ffffff; font-weight:700; font-size:14.5px; margin-top:10px;">Email us</a>
  </div>
  {%- endif -%}
</aside>
