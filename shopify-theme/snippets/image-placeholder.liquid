{% comment %}
  Fills an empty image slot with a quiet striped panel naming the slot.
  Disappears on its own the moment a real image is set, so there is nothing to
  remove before launch. The upload size lives in the tooltip and the
  accessible label rather than on screen, so client screenshots read as an
  empty slot, not a broken image.

  Absolutely positioned — the parent must be position:relative.

  Args:
    w, h   recommended source pixels (2x the largest rendered size)
    label  what the slot is, e.g. 'Category banner'
    note   optional guidance, folded into the tooltip
{% endcomment %}
<div style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:9px; text-align:center; padding:16px; background:repeating-linear-gradient(135deg, #f4f5f2, #f4f5f2 10px, #eef0eb 10px, #eef0eb 20px); border-radius:inherit; color:#5d6159;" role="img" aria-label="{{ label | default: 'Image' | escape }} placeholder — upload {{ w }} by {{ h }} pixels" title="Upload {{ w }} &times; {{ h }} px{% if note != blank %} — {{ note | escape }}{% endif %}">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#aab3a2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:0 0 auto;">
    <rect x="3" y="4" width="18" height="16" rx="2.5"></rect>
    <circle cx="8.5" cy="9.5" r="1.6"></circle>
    <path d="M21 16.5 15.5 11 7 19.5"></path>
  </svg>
  {%- if label != blank -%}
    <div style="font-size:11px; font-weight:700; letter-spacing:.09em; text-transform:uppercase;">{{ label }}</div>
  {%- endif -%}
</div>