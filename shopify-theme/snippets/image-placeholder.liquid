{% comment %}
  Fills an empty image slot with a labelled panel showing the size to upload.
  Disappears on its own the moment a real image is set, so there is nothing to
  remove before launch.

  Absolutely positioned — the parent must be position:relative.

  Args:
    w, h   recommended source pixels (2x the largest rendered size)
    label  what the slot is, e.g. 'Category banner'
    note   optional extra line, e.g. 'Landscape — subject centred'
{% endcomment %}
<div style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; text-align:center; padding:16px; background:#eef1ea; background-image:repeating-linear-gradient(135deg, rgba(63,107,79,.05) 0 10px, transparent 10px 20px); border:2px dashed #bcc7b2; border-radius:inherit; color:#5a6153;" role="img" aria-label="{{ label | default: 'Image' | escape }} placeholder — upload {{ w }} by {{ h }} pixels">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#8fa382" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:0 0 auto;">
    <rect x="3" y="4" width="18" height="16" rx="2.5"></rect>
    <circle cx="8.5" cy="9.5" r="1.6"></circle>
    <path d="M21 16.5 15.5 11 7 19.5"></path>
  </svg>
  {%- if label != blank -%}
    <div style="font-size:11.5px; font-weight:700; letter-spacing:.09em; text-transform:uppercase; color:#7d8875;">{{ label }}</div>
  {%- endif -%}
  <div style="font-size:clamp(15px,1.5vw,19px); font-weight:800; color:#3f6b4f; font-variant-numeric:tabular-nums; letter-spacing:.01em; font-family:'Arial Rounded MT Bold', Arial, sans-serif;">{{ w }} &times; {{ h }}<span style="font-size:.68em; font-weight:700; margin-left:5px; color:#7d8875;">px</span></div>
  {%- if note != blank -%}
    <div class="imgph-note" style="font-size:12px; line-height:1.45; color:#7d8875; max-width:30ch;">{{ note }}</div>
  {%- endif -%}
</div>
