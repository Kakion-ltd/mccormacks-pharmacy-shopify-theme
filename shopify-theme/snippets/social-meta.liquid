{%- comment -%}
  Open Graph and Twitter card tags: what a link to this page shows when it is
  pasted into WhatsApp, Facebook, iMessage, Slack or X.

  Image, first match wins:
    page_image   Shopify's own pick: the product, collection or article image,
                 else the social sharing image set in Online Store > Preferences
    logo         settings.logo, else the bundled asset, so no page shares bare

  Rendered before content_for_header in the layout. Shopify injects its own
  og:image there on some pages; scrapers take the first one, which is this.
{%- endcomment -%}
{%- liquid
  case request.page_type
    when 'product'
      assign og_type = 'product'
    when 'article'
      assign og_type = 'article'
    else
      assign og_type = 'website'
  endcase
  assign og_description = page_description | default: shop.description
-%}
{%- comment -%} Shopify never upscales, so a 600px collection image is served at
    600 whatever is asked for; declare the size it will actually be. {%- endcomment -%}
{%- if page_image -%}
  {%- assign og_w = page_image.width | at_most: 1200 -%}
  {%- assign og_h = og_w | divided_by: page_image.aspect_ratio | round -%}
  {%- assign og_image_src = page_image | image_url: width: og_w -%}
{%- else -%}
  {%- capture og_image_src -%}{%- render 'logo-src', width: 1200 -%}{%- endcapture -%}
{%- endif -%}
{%- capture og_image -%}{%- render 'absolute-url', src: og_image_src -%}{%- endcapture -%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if og_description != blank %}
<meta property="og:description" content="{{ og_description | escape }}">
{%- endif %}
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:secure_url" content="{{ og_image }}">
{%- if page_image %}
<meta property="og:image:width" content="{{ og_w }}">
<meta property="og:image:height" content="{{ og_h }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
