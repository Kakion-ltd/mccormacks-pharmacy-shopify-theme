{%- comment -%} Striped map placeholder from the design. Accepts: height (px number),
    stores (JSON array of {name, lat, lng}; entries with a blank lat or lng are
    skipped). With stores and the Google Maps key setting both present it
    offers a "Show map" button, and theme.js swaps in a Google map on click.
    Nothing is fetched from Google before that click: loading Maps sends the
    visitor's IP to Google, and the consent banner promises nothing
    non-essential runs unasked. {%- endcomment -%}
{%- liquid
  assign map_on = false
  if stores != blank and settings.google_maps_key != blank
    assign map_on = true
  endif
-%}
<div{% if map_on %} data-map="{{ stores | escape }}"{% endif %} style="width:100%; height:{{ height | default: 300 }}px; border-radius:16px; overflow:hidden; background:#eef1ea; border:1px solid #e6e7e4; position:relative; display:flex; align-items:center; justify-content:center;">
  <svg viewBox="0 0 400 220" style="position:absolute; inset:0; width:100%; height:100%;" preserveAspectRatio="none">
    <rect width="400" height="220" fill="#eef1ea"></rect>
    <path d="M0 60 L120 52 L210 78 L400 66" stroke="#dfe4d8" stroke-width="7" fill="none"></path>
    <path d="M0 150 L140 138 L260 164 L400 148" stroke="#dfe4d8" stroke-width="7" fill="none"></path>
    <path d="M90 0 L104 220" stroke="#dfe4d8" stroke-width="7" fill="none"></path>
    <path d="M280 0 L292 220" stroke="#dfe4d8" stroke-width="7" fill="none"></path>
    <path d="M0 100 Q90 88 180 104 T400 96" stroke="#cfdcc2" stroke-width="4" fill="none"></path>
  </svg>
  <div style="position:relative; display:flex; flex-direction:column; align-items:center; gap:9px; text-align:center; padding:20px;">
    <svg width="30" height="30" viewBox="0 0 24 24" fill="var(--c-primary)"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"></path></svg>
    <div style="font-family:var(--font-heading); font-weight:800; font-size:14.5px; color:var(--c-dark);">Interactive map</div>
    {%- if map_on -%}
      <button type="button" class="btn-sm btn-fill" data-map-load data-map-key="{{ settings.google_maps_key | escape }}">Show map</button>
      <div style="font-size:12.5px; color:#5f6459; max-width:30ch;">Loads Google Maps, which may set cookies.</div>
    {%- else -%}
      <div style="font-size:12.5px; color:#5f6459; max-width:30ch;">Google Maps embed goes here at build</div>
    {%- endif -%}
  </div>
</div>
