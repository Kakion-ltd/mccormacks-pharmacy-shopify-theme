{% comment %}
  JSON-LD structured data.

  Two call sites:

    layout/theme.liquid   {% render 'structured-data' %}
        Emits Product + Offer (+ AggregateRating where real reviews exist) on a
        product page, and BreadcrumbList on a collection page.

    sections/footer.liquid  {% render 'structured-data', scope: 'organization', ... %}
        Emits Organization sitewide. It lives at the footer call site because
        the social URLs are footer section settings, which a snippet rendered
        from the layout cannot see.

  Rules this follows, because getting them wrong is worse than emitting nothing:

    - Every value comes from real store data. Nothing is invented, and
      AggregateRating is emitted ONLY where the reviews metafield actually has
      a rating — the same condition snippets/product-rating.liquid uses. A
      rating in the markup that is not on the page is a manual action from
      Google, not a rich result.
    - Strings go through the json filter, which quotes and escapes them. Do not
      wrap those outputs in quotes of your own.
    - schema.org needs absolute URLs. image_url and asset_url return
      protocol-relative //cdn ones, so every URL goes through
      snippets/absolute-url.liquid rather than a bare https: prepend.

  Not emitted, deliberately: hasMerchantReturnPolicy and shippingDetails. Both
  improve Merchant Center listings, and both need real policy values (return
  window, handling time, per-region rates) that are not in the theme yet.
{% endcomment %}

{%- liquid
  assign shop_url = shop.secure_url | default: shop.url
  assign currency = cart.currency.iso_code | default: shop.currency
-%}

{%- if scope == 'organization' -%}

  {%- assign logo_src = 'mccormacks-logo.png' | asset_url -%}
  {%- capture logo_url -%}{%- render 'absolute-url', src: logo_src -%}{%- endcapture -%}
  {%- capture social -%}
    {%- if facebook != blank -%}{{ facebook | json }}{%- endif -%}
    {%- if instagram != blank -%}{%- if facebook != blank -%},{%- endif -%}{{ instagram | json }}{%- endif -%}
    {%- if tiktok != blank -%}{%- if facebook != blank or instagram != blank -%},{%- endif -%}{{ tiktok | json }}{%- endif -%}
  {%- endcapture -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Pharmacy",
    "@id": {{ shop_url | append: '#organization' | json }},
    "name": {{ shop.name | json }},
    "url": {{ shop_url | json }},
    "logo": {{ logo_url | json }}
    {%- if about != blank -%},
    "description": {{ about | strip_html | strip | json }}
    {%- endif -%}
    {%- if settings.phone != blank -%},
    "telephone": {{ settings.phone | json }}
    {%- endif -%}
    {%- if social != blank -%},
    "sameAs": [{{ social }}]
    {%- endif -%},
    "areaServed": { "@type": "Country", "name": "Ireland" }
  }
  </script>

{%- elsif request.page_type == 'index' -%}

  {%- comment -%} WebSite + SearchAction, the sitelinks search box. Homepage only:
      Google reads it from the site's root, and repeating it on every page adds
      bytes without adding meaning.

      The search URL comes from routes.search_url rather than a hardcoded /search,
      so it survives a locale or market path prefix. If that route were ever blank
      the markup would describe a search box that does not exist, so it is guarded.

      Note this is a request to Google, not a guarantee: the search box appears only
      if Google already shows sitelinks for the brand. The markup costs nothing and
      is the only way to be eligible. {%- endcomment -%}
  {%- assign search_url = routes.search_url | default: '/search' -%}
  {%- if search_url != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": {{ shop_url | append: '#website' | json }},
    "url": {{ shop_url | json }},
    "name": {{ shop.name | default: 'Shop' | json }},
    "publisher": { "@id": {{ shop_url | append: '#organization' | json }} },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": {{ shop_url | append: search_url | append: '?q={search_term_string}' | json }}
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  {%- endif -%}

{%- elsif request.page_type == 'product' -%}

  {%- assign og_image = product.featured_media.preview_image | default: product.featured_image -%}
  {%- assign image_src = og_image | image_url: width: 1200 -%}
  {%- capture image_url -%}{%- if og_image -%}{%- render 'absolute-url', src: image_src -%}{%- endif -%}{%- endcapture -%}
  {%- assign rating = product.metafields.reviews.rating.value -%}
  {%- assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": {{ shop_url | append: product.url | append: '#product' | json }},
    "name": {{ product.title | json }},
    "url": {{ shop_url | append: product.url | json }},
    "description": {{ product.description | strip_html | truncate: 5000 | json }}
    {%- if og_image -%},
    "image": [{{ image_url | json }}]
    {%- endif -%}
    {%- if product.vendor != blank -%},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} }
    {%- endif -%}
    {%- if rating and rating.rating > 0 and rating_count > 0 -%},
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ rating.rating | json }},
      "bestRating": {{ rating.scale_max | default: 5 | json }},
      "worstRating": {{ rating.scale_min | default: 1 | json }},
      "ratingCount": {{ rating_count | json }}
    }
    {%- endif -%},
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "url": {{ shop_url | append: product.url | append: '?variant=' | append: variant.id | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ currency | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition"
          {%- if variant.sku != blank -%}, "sku": {{ variant.sku | json }}{%- endif -%}
          {%- if variant.barcode != blank -%}, "gtin": {{ variant.barcode | json }}{%- endif -%}
          {%- unless product.has_only_default_variant -%}, "name": {{ variant.title | json }}{%- endunless -%},
          "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>

{%- comment -%} FAQPage, emitted alongside Product when the product carries FAQ
      content. Its own snippet so the visible copy and the schema can never drift
      apart — both read the same metafield through the same validation. {%- endcomment -%}
  {% render 'product-faq', product: product, scope: 'schema' %}

{%- elsif request.page_type == 'collection' -%}

  {%- comment -%} Trail as data, from the same generator as the visible breadcrumb. {%- endcomment -%}
  {%- capture crumb_data -%}{%- render 'category-breadcrumb-data', collection: collection -%}{%- endcapture -%}
  {%- assign crumb_data = crumb_data | strip -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop_url | json }} }
      {%- assign position = 1 -%}
      {%- if crumb_data != blank -%}
        {%- assign crumbs = crumb_data | split: '|' -%}
        {%- for crumb in crumbs -%}
          {%- assign parts = crumb | split: '~' -%}
          {%- if parts.size == 2 -%}
            {%- assign position = position | plus: 1 -%},
      {
        "@type": "ListItem",
        "position": {{ position }},
        "name": {{ parts[0] | json }},
        "item": {{ shop_url | append: '/collections/' | append: parts[1] | json }}
      }
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- assign position = position | plus: 1 -%},
      {
        "@type": "ListItem",
        "position": {{ position }},
        "name": {{ collection.title | json }},
        "item": {{ shop_url | append: collection.url | json }}
      }
    ]
  }
  </script>

  {%- comment -%} ItemList: what this collection actually lists, in the order a
      visitor sees it. Emitted only when the page has products — an empty
      itemElement list is worse than no ItemList, and a filtered or paginated view
      that came back empty must not claim otherwise.

      Deliberately only the paginated slice, not the whole collection. This
      describes the page being viewed; claiming 400 products on a page showing 24
      is a mismatch between markup and content.

      url only, not a nested Product per item. The product page already carries the
      full Product node with price and availability; duplicating a partial copy here
      gives Google two sources for the same facts and a chance to disagree with
      itself. position + url is what ItemList is for. {%- endcomment -%}
  {%- if collection.products.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ collection.title | json }},
    "url": {{ shop_url | append: collection.url | json }},
    "numberOfItems": {{ collection.products.size }},
    "itemListOrder": "https://schema.org/ItemListOrderAscending",
    "itemListElement": [
      {%- assign item_position = 0 -%}
      {%- for item in collection.products -%}
        {%- if item.url != blank -%}
          {%- assign item_position = item_position | plus: 1 -%}
          {%- unless item_position == 1 -%},{%- endunless -%}
      {
        "@type": "ListItem",
        "position": {{ item_position }},
        "url": {{ shop_url | append: item.url | json }},
        "name": {{ item.title | json }}
      }
        {%- endif -%}
      {%- endfor -%}
    ]
  }
  </script>
  {%- endif -%}

{%- endif -%}
