{% comment %} Green "Why create an account?" panel shared by the auth views. {% endcomment %}
<aside class="auth-side" style="flex:0 0 340px; width:340px; border-radius:16px; background:var(--c-dark); color:var(--c-on-dark); padding:32px 30px; display:flex; flex-direction:column; justify-content:center; gap:18px;">
  <div style="font-family:'Arial Rounded MT Bold', Arial, sans-serif; font-weight:800; font-size:22px; line-height:1.25;">Why create an account?</div>
  <div style="display:flex; flex-direction:column; gap:14px;">
    <div style="display:flex; gap:12px; align-items:flex-start;">
      <span style="flex:0 0 auto; margin-top:7px; width:7px; height:7px; border-radius:999px; background:var(--c-accent);"></span>
      <span><span style="display:block; font-weight:800; font-size:15px; margin-bottom:3px;">Faster checkout</span><span style="display:block; font-size:14px; line-height:1.6; color:#d6e2cd;">Saved addresses and delivery preferences.</span></span>
    </div>
    <div style="display:flex; gap:12px; align-items:flex-start;">
      <span style="flex:0 0 auto; margin-top:7px; width:7px; height:7px; border-radius:999px; background:var(--c-accent);"></span>
      <span><span style="display:block; font-weight:800; font-size:15px; margin-bottom:3px;">Order history</span><span style="display:block; font-size:14px; line-height:1.6; color:#d6e2cd;">Reorder anything you have bought before in one click.</span></span>
    </div>
    <div style="display:flex; gap:12px; align-items:flex-start;">
      <span style="flex:0 0 auto; margin-top:7px; width:7px; height:7px; border-radius:999px; background:var(--c-accent);"></span>
      <span><span style="display:block; font-weight:800; font-size:15px; margin-bottom:3px;">Prescription records</span><span style="display:block; font-size:14px; line-height:1.6; color:#d6e2cd;">Submit and track repeat prescriptions securely.</span></span>
    </div>
    <div style="display:flex; gap:12px; align-items:flex-start;">
      <span style="flex:0 0 auto; margin-top:7px; width:7px; height:7px; border-radius:999px; background:var(--c-accent);"></span>
      <span><span style="display:block; font-weight:800; font-size:15px; margin-bottom:3px;">Member offers</span><span style="display:block; font-size:14px; line-height:1.6; color:#d6e2cd;">Early access to promotions and seasonal advice.</span></span>
    </div>
  </div>
</aside>
