<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    {{- page_title -}}
    {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {%- comment -%} theme.js is a static asset and can't read Liquid — hand it the cart routes so they survive a locale/market path prefix {%- endcomment -%}
  <script>window.mccRoutes = { cart_url: {{ routes.cart_url | json }}, cart_add_url: {{ routes.cart_add_url | json }}, cart_change_url: {{ routes.cart_change_url | json }}, predictive_search_url: {{ routes.predictive_search_url | json }}, product_recommendations_url: {{ routes.product_recommendations_url | json }} };</script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body>
  {% sections 'header-group' %}
  <main id="main" style="width:100%; overflow-x:hidden; background:#ffffff;">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
</body>
</html>
