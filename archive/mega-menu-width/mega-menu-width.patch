+# One column of labels. Measured across all eight panels at 1440, the widest label
+# renders at 194px (Medicines & Health), so 200 holds every one of the 199 links on
+# a single line with room to spare, and no column is wider than the text it carries.
+COL = 200
+GAP = 24                 # between columns of a split grid
+PAD = 30                 # panel side padding, both edges
+
+def wide_width(cols):
+    """A wide panel is as wide as the columns it actually needs.
+
+    Width used to be a per-department constant: 1380, 1000, 1240, 1100. Only the
+    first was consistent with its column count, so Skincare's five groups sat in
+    three 330px columns carrying 167px of text and the right of the panel read as
+    empty. Deriving it means a panel can only be as wide as its content, and two
+    panels with the same column count are the same width rather than coincidentally
+    close. Medicines & Health lands on 1380 again, which is where the number the
+    designer drew came from.
+    """
+    return cols * COL + (cols - 1) * GAP + 2 * PAD
+
+
 # Panel chrome, in nav order. `left` is the no-JS fallback position of a narrow panel; theme.js
 # re-aligns those under their trigger at runtime. Wide panels start at the
-# container edge. `floor` is the column minimum for a split grid.
+# container edge and take their width from `cols`.
